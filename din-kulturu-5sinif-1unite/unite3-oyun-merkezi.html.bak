// --- 2) BOŞLUK DOLDUR ---
let ez23Tur=0, ez23Dogru=0, ez23Sira=[];
function ez23Baslat(){
  ez23Tur=0; ez23Dogru=0;
  ez23Sira = karistir(ezberVeri3.map((x,i)=>i));
  document.getElementById('ez23Dogru').textContent='0';
  document.getElementById('ez23Sonuc').textContent='';
  ez23SoruGoster();
}
function ez23SoruGoster(){
  if(ez23Tur>=ez23Sira.length){
    document.getElementById('ez23Metin').textContent='';
    document.getElementById('ez23Secenekler').innerHTML='';
    document.getElementById('ez23Sonuc').innerHTML = `🎉 Bitti! ${ez23Dogru}/${ez23Sira.length} doğru.`;
    return;
  }
  document.getElementById('ez23Tur').textContent = ez23Tur+1;
  const i = ez23Sira[ez23Tur];
  const oge = ezberVeri3[i];
  document.getElementById('ez23Metin').textContent = oge.parca.replace(oge.gizli, '______');
  const digerleri = ezberVeri3.filter((_,j)=>j!==i).map(x=>x.gizli);
  const yanlislar = karistir(digerleri).slice(0,3);
  const secenekler = karistir([oge.gizli, ...yanlislar]);
  const kutu = document.getElementById('ez23Secenekler');
  kutu.innerHTML='';
  secenekler.forEach(sec=>{
    const btn=document.createElement('div');
    btn.className='merdiven-secenek';
    btn.textContent=sec;
    btn.onclick=()=>{
      document.querySelectorAll('#ez23Secenekler .merdiven-secenek').forEach(b=>b.onclick=null);
      if(sec===oge.gizli){ btn.classList.add('dogru'); ez23Dogru++; document.getElementById('ez23Dogru').textContent=ez23Dogru; }
      else {
        btn.classList.add('yanlis');
        [...kutu.children].find(b=>b.textContent===oge.gizli).classList.add('dogru');
      }
      setTimeout(()=>{ ez23Tur++; ez23SoruGoster(); }, 1100);
    };
    kutu.appendChild(btn);
  });
}

// --- 3) ANLAM EŞLEŞTİR ---
let ez33Secili=null, ez33Eslesen=0;
function ez33Baslat(){
  ez33Secili=null; ez33Eslesen=0;
  document.getElementById('ez33Eslesen').textContent='0';
  document.getElementById('ez33Sonuc').textContent='';
  const solSira = karistir(ezberVeri3.map((x,i)=>i));
  const sagSira = karistir(ezberVeri3.map((x,i)=>i));
  const sol = document.getElementById('ez33Sol'); sol.innerHTML='';
  const sag = document.getElementById('ez33Sag'); sag.innerHTML='';
  solSira.forEach(i=>{
    const b=document.createElement('div');
    b.className='merdiven-secenek ez-oge';
    b.textContent=ezberVeri3[i].parca;
    b.dataset.i=i; b.dataset.taraf='sol';
    b.onclick=()=>ez33Tikla(b);
    sol.appendChild(b);
  });
  sagSira.forEach(i=>{
    const b=document.createElement('div');
    b.className='merdiven-secenek ez-oge';
    b.textContent=ezberVeri3[i].anlam;
    b.dataset.i=i; b.dataset.taraf='sag';
    b.onclick=()=>ez33Tikla(b);
    sag.appendChild(b);
  });
}
function ez33Tikla(b){
  if(b.classList.contains('eslesti')) return;
  if(ez33Secili && ez33Secili.dataset.taraf===b.dataset.taraf){
    ez33Secili.classList.remove('secili');
    ez33Secili = b; b.classList.add('secili');
    return;
  }
  if(!ez33Secili){ ez33Secili=b; b.classList.add('secili'); return; }
  if(ez33Secili.dataset.i===b.dataset.i){
    ez33Secili.classList.remove('secili'); ez33Secili.classList.add('eslesti');
    b.classList.add('eslesti');
    ez33Secili=null;
    ez33Eslesen++;
    document.getElementById('ez33Eslesen').textContent=ez33Eslesen;
    if(ez33Eslesen===ezberVeri3.length){
      document.getElementById('ez33Sonuc').innerHTML = "🎉 Tebrikler! Tüm ayetleri anlamlarıyla eşleştirdin!";
    }
  } else {
    const digeri = ez33Secili;
    digeri.classList.add('yanlis'); b.classList.add('yanlis');
    setTimeout(()=>{ digeri.classList.remove('yanlis','secili'); b.classList.remove('yanlis'); },400);
    ez33Secili=null;
  }
}

// --- 4) HAFIZA KARTLARI ---
let ez43Acik=[], ez43Bulunan=0, ez43Hamle=0, ez43Kilit=false;
function ez43Baslat(){
  ez43Acik=[]; ez43Bulunan=0; ez43Hamle=0; ez43Kilit=false;
  document.getElementById('ez43Bulunan').textContent='0';
  document.getElementById('ez43Hamle').textContent='0';
  document.getElementById('ez43Sonuc').textContent='';
  const kartlar=[];
  ezberVeri3.forEach((x,i)=>{
    kartlar.push({i, tip:'parca', metin:x.parca});
    kartlar.push({i, tip:'anlam', metin:x.anlam});
  });
  const karisik = karistir(kartlar);
  const izgara = document.getElementById('ez43Izgara');
  izgara.innerHTML='';
  karisik.forEach(k=>{
    const kart=document.createElement('div');
    kart.className='hafiza-kart';
    kart.dataset.i=k.i; kart.dataset.tip=k.tip;
    kart.innerHTML = `<div class="hafiza-on">🕌</div><div class="hafiza-arka">${k.metin}</div>`;
    kart.onclick=()=>ez43KartTikla(kart);
    izgara.appendChild(kart);
  });
}
function ez43KartTikla(kart){
  if(ez43Kilit || kart.classList.contains('acik') || kart.classList.contains('bulundu')) return;
  kart.classList.add('acik');
  ez43Acik.push(kart);
  if(ez43Acik.length===2){
    ez43Hamle++; document.getElementById('ez43Hamle').textContent=ez43Hamle;
    ez43Kilit=true;
    const [a,b]=ez43Acik;
    if(a.dataset.i===b.dataset.i && a.dataset.tip!==b.dataset.tip){
      a.classList.add('bulundu'); b.classList.add('bulundu');
      ez43Bulunan++; document.getElementById('ez43Bulunan').textContent=ez43Bulunan;
      ez43Acik=[]; ez43Kilit=false;
      if(ez43Bulunan===ezberVeri3.length){
        document.getElementById('ez43Sonuc').innerHTML = `🎉 Tebrikler! ${ez43Hamle} hamlede tüm çiftleri buldun!`;
      }
    } else {
      setTimeout(()=>{
        a.classList.remove('acik'); b.classList.remove('acik');
        ez43Acik=[]; ez43Kilit=false;
      }, 900);
    }
  }
}

