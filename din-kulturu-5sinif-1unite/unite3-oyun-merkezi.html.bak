  <h2>8️⃣ Ezber: Hız Testi</h2>
  <div class="oyun-amaci">🎯 Bu oyun sonunda: Asr suresi bölüm-anlam eşleşmelerini hızlı ve akıcı hatırlayacaksın.</div>
  <div class="aciklama">Süre dolmadan verilen anlama ait doğru bölümü seç. Ne kadar çok doğru cevaplarsan o kadar yüksek puan alırsın!</div>
  <div class="ez-zamanlayici" id="ez83bSayac">60</div>
  <div class="oyun-bilgi"><span>✅ Doğru: <b id="ez83bDogru">0</b></span><span>❌ Yanlış: <b id="ez83bYanlis">0</b></span></div>
  <div class="ez-metin-goster" id="ez83bMetin"></div>
  <div class="ez-iki-sutun"><div class="ez-sutun" id="ez83bSecenekler" style="margin:0 auto;"></div></div>
  <div class="sonuc-kutusu" id="ez83bSonuc"></div>
  <button class="eylem" onclick="ez83bBaslat()">⏱️ Başla</button>
</section>
</main>

<script>
function goster(id, ev){
  document.querySelectorAll('section').forEach(s=>s.classList.remove('aktif'));
  document.getElementById(id).classList.add('aktif');
  document.querySelectorAll('.oyun-grubu button').forEach(b=>b.classList.remove('aktif'));
  if(ev && ev.target) ev.target.classList.add('aktif');
}
function kategoriGoster(id, ev){
  document.querySelectorAll('.oyun-grubu').forEach(g=>g.classList.remove('aktif'));
  document.getElementById(id).classList.add('aktif');
  document.querySelectorAll('.kategori-nav button').forEach(b=>b.classList.remove('kat-aktif'));
  if(ev && ev.target) ev.target.classList.add('kat-aktif');
}
function kategoriGosterVeKaydir(kategoriId){
  document.querySelectorAll('.oyun-grubu').forEach(g=>g.classList.remove('aktif'));
  document.getElementById(kategoriId).classList.add('aktif');
  document.querySelectorAll('.kategori-nav button').forEach(b=>{
    b.classList.toggle('kat-aktif', b.getAttribute('onclick').includes(kategoriId));
  });
  document.getElementById('oyun-gruplari').scrollIntoView({behavior:'smooth'});
}

function karistir(a){ return a.map(v=>[Math.random(),v]).sort((x,y)=>x[0]-y[0]).map(v=>v[1]); }

let puanDurumu;
try{ puanDurumu = JSON.parse(localStorage.getItem('dkabPuanDurumu8sinif')) || {}; }catch(e){ puanDurumu = {}; }
puanDurumu = Object.assign({toplamPuan:0, tamamlanan:0, rozetler:[], sonOyunTarihi:null, seri:0}, puanDurumu);

function puanKaydet(){ try{ localStorage.setItem('dkabPuanDurumu8sinif', JSON.stringify(puanDurumu)); }catch(e){} }

function gunlukSeriGuncelle(){
  const bugun = new Date().toDateString();
  if(puanDurumu.sonOyunTarihi !== bugun){
    const dun = new Date(); dun.setDate(dun.getDate()-1);
    puanDurumu.seri = (puanDurumu.sonOyunTarihi === dun.toDateString()) ? puanDurumu.seri+1 : 1;
    puanDurumu.sonOyunTarihi = bugun;
  }
}

function istatistikleriGuncelleGoster(){
  const tp = document.getElementById('istToplamPuan');
  if(!tp) return;
  document.getElementById('istToplamPuan').textContent = puanDurumu.toplamPuan;
  document.getElementById('istTamamlanan').textContent = puanDurumu.tamamlanan;
  document.getElementById('istSeri').textContent = puanDurumu.seri;
  document.getElementById('istRozet').textContent = puanDurumu.rozetler.length;
}

function oyunTamamlandi(bolumId){
  puanDurumu.toplamPuan += 10;
  puanDurumu.tamamlanan++;
  gunlukSeriGuncelle();
  const esikler = [{sayi:1,ad:"🥉 İlk Adım"},{sayi:5,ad:"🥈 Azimli Öğrenci"},{sayi:10,ad:"🥇 Kelime Ustası"},{sayi:20,ad:"🏆 Efsane"}];
  esikler.forEach(e=>{
    if(puanDurumu.tamamlanan>=e.sayi && !puanDurumu.rozetler.includes(e.ad)) puanDurumu.rozetler.push(e.ad);
  });
  puanKaydet();
  istatistikleriGuncelleGoster();
  opOyunTamamlandiKaydet(bolumId, puanDurumu.toplamPuan, puanDurumu.rozetler);
}

function sonucIzlemeBaslat(){
  document.querySelectorAll('.sonuc-kutusu').forEach(el=>{
    const gozlemci = new MutationObserver(()=>{
      const metin = el.textContent;
      if((metin.includes('🎉') || metin.includes('🏆')) && el.dataset.sonOdul !== metin){
        el.dataset.sonOdul = metin;
        oyunTamamlandi(el.closest('section') ? el.closest('section').id : null);
      }
    });
    gozlemci.observe(el, {childList:true, characterData:true, subtree:true});
  });
}

function siraOlustur(cfg){
  const banka = document.getElementById(cfg.bankaId);
  const cevap = document.getElementById(cfg.cevapId);
  banka.innerHTML=''; cevap.innerHTML='';
  let beklenen = 0;
  const karisikSira = karistir(cfg.tokens.map((t,i)=>({t,i})));
  karisikSira.forEach(obj=>{
    const tas = document.createElement('div');
    tas.className='kelime-tas';
    tas.textContent = obj.t;
    tas.dataset.sira = obj.i;
    tas.onclick = ()=>{
      if(tas.classList.contains('kullanildi')) return;
      if(parseInt(tas.dataset.sira,10) === beklenen){
        tas.classList.add('kullanildi');
        tas.onclick = null;
        const kopya = document.createElement('div');
        kopya.className='kelime-tas';
        kopya.textContent = obj.t;
        cevap.appendChild(kopya);
        beklenen++;
        if(cfg.ilerleme) cfg.ilerleme(beklenen);
        if(beklenen === cfg.tokens.length && cfg.tamamlandi) cfg.tamamlandi();
      } else {
        tas.classList.add('yanlis');
        setTimeout(()=>tas.classList.remove('yanlis'), 300);
      }
    };
    banka.appendChild(tas);
  });
}

// =====================================================================
// 3. ÜNİTE KELİME HAVUZU (27 kavram) — 5. Sınıf
// =====================================================================
const kelimeHavuzu3 = [
  {kelime:"VAHİY", anlam:"Allah'ın (cc) peygamberlerine bildirdiği ilahi mesaj"},
  {kelime:"AYET", anlam:"Kur'an-ı Kerim'in cümle veya cümle grubu hâlindeki en küçük bölümü"},
  {kelime:"SURE", anlam:"Kur'an-ı Kerim'in ayetlerden oluşan bölümlerinden her biri"},
  {kelime:"CÜZ", anlam:"Kur'an-ı Kerim'in otuza bölünmüş parçalarından her biri"},
  {kelime:"HAFIZ", anlam:"Kur'an-ı Kerim'in tamamını ezberleyen kişi"},
  {kelime:"TECVİT", anlam:"Kur'an-ı Kerim'i doğru ve güzel okuma kuralları"},
  {kelime:"MUSHAF", anlam:"Kur'an-ı Kerim'in yazılı hâldeki kitabı"},
  {kelime:"NÜZUL", anlam:"Kur'an'ın Hz. Muhammed'e (sav) indirilmesi"},
  {kelime:"KIRAAT", anlam:"Kur'an-ı Kerim'i okuma biçimi"},
  {kelime:"TEFSİR", anlam:"Kur'an ayetlerinin anlamını açıklama ilmi"},
  {kelime:"MEAL", anlam:"Kur'an'ın başka bir dile yapılan anlam çevirisi"},
  {kelime:"HATİM", anlam:"Kur'an-ı Kerim'i baştan sona okuyup bitirme"},
  {kelime:"CEBRAİL", anlam:"Vahyi peygamberlere getiren melek"},
  {kelime:"KADİR", anlam:"Kur'an'ın indirilmeye başladığı, bin aydan hayırlı gece"},
  {kelime:"FATİHA", anlam:"Kur'an-ı Kerim'in ilk suresi"},
  {kelime:"BESMELE", anlam:"'Bismillahirrahmanirrahim' sözü"},
  {kelime:"HİDAYET", anlam:"Doğru yolu bulma, Kur'an'ın insanlara sunduğu rehberlik"},
  {kelime:"ŞİFA", anlam:"Kur'an'ın kalplere derman olması"},
  {kelime:"RAHMET", anlam:"Allah'ın (cc) sonsuz merhameti, Kur'an'ın bir özelliği"},
  {kelime:"NUR", anlam:"Işık, Kur'an'ın insanlara yol gösteren bir özelliği"},
  {kelime:"FURKAN", anlam:"Hakkı batıldan ayıran, Kur'an'ın bir ismi"},
  {kelime:"KELAMULLAH", anlam:"Allah'ın (cc) sözü, Kur'an'ın bir ismi"},
  {kelime:"MEKKİ", anlam:"Hicretten önce Mekke'de indirilen ayet ve sureler"},
  {kelime:"MEDENİ", anlam:"Hicretten sonra Medine'de indirilen ayet ve sureler"},
  {kelime:"ARAPÇA", anlam:"Kur'an-ı Kerim'in indirildiği dil"},
  {kelime:"KORUNMUŞLUK", anlam:"Kur'an'ın günümüze kadar değişmeden ulaşması özelliği"},
  {kelime:"İCAZ", anlam:"Kur'an'ın eşsiz ve benzersiz oluşu"}
];
function ku3AnlamBul(kelime){
  const bulunan = kelimeHavuzu3.find(x=>x.kelime===kelime);
  return bulunan ? bulunan.anlam : '';
}

// =====================================================================
// HIZLI KELİME ÜRETME
// =====================================================================
const ku3GecerliHarfler = ["A","S","K","V","M","F"];
let ku3AktifHarf = '', ku3Bulunanlar = [], ku3Sure = 60, ku3Zamanlayici = null, ku3Puan = 0, ku3Bitti = true;

function ku3Baslat(){
  clearInterval(ku3Zamanlayici);
  ku3AktifHarf = ku3GecerliHarfler[Math.floor(Math.random()*ku3GecerliHarfler.length)];
  ku3Bulunanlar = []; ku3Puan = 0; ku3Sure = 60; ku3Bitti = false;
  document.getElementById('ku3Harf').textContent = ku3AktifHarf;
  document.getElementById('ku3Sure').textContent = ku3Sure;
  document.getElementById('ku3Puan').textContent = 0;
  document.getElementById('ku3Liste').innerHTML = '';
  document.getElementById('ku3Sonuc').textContent = '';
  document.getElementById('ku3Uyari').textContent = '';
  document.getElementById('ku3Kacirilan').innerHTML = '';
  const girdi = document.getElementById('ku3Girdi');
  girdi.value = ''; girdi.disabled = false; girdi.focus();
  ku3Zamanlayici = setInterval(()=>{
    ku3Sure--;
    document.getElementById('ku3Sure').textContent = ku3Sure;
    if(ku3Sure<=0) ku3Bitir();
  }, 1000);
}

function ku3Ekle(){
  if(ku3Bitti) return;
  const girdi = document.getElementById('ku3Girdi');
  const kelime = girdi.value.trim().toLocaleUpperCase('tr-TR');
  girdi.value = '';
  if(!kelime) return;
  const uyari = document.getElementById('ku3Uyari');
  if(!kelime.startsWith(ku3AktifHarf)){ uyari.textContent = `❌ "${ku3AktifHarf}" harfiyle başlamalı!`; return; }
  if(!kelimeHavuzu3.some(x=>x.kelime===kelime)){ uyari.textContent = `🤔 Bu kelimeyi bilmiyorum, ünitedeki bir kavram olmalı!`; return; }
  if(ku3Bulunanlar.includes(kelime)){ uyari.textContent = `⚠️ Bu kelimeyi zaten yazdın!`; return; }
  ku3Bulunanlar.push(kelime);
  ku3Puan++;
  document.getElementById('ku3Puan').textContent = ku3Puan;
  const li = document.createElement('li');
  li.textContent = kelime;
  document.getElementById('ku3Liste').appendChild(li);
  uyari.textContent = '';
}

function ku3Bitir(){
  clearInterval(ku3Zamanlayici);
  ku3Bitti = true;
  document.getElementById('ku3Girdi').disabled = true;
  document.querySelectorAll('#ku3Liste li').forEach(li=>{
    const kelime = li.textContent;
    li.textContent = `${kelime} — ${ku3AnlamBul(kelime)}`;
  });
  const kacirilanKutu = document.getElementById('ku3Kacirilan');
  kacirilanKutu.innerHTML = '';
  const kacirilanlar = kelimeHavuzu3.filter(x=>x.kelime.startsWith(ku3AktifHarf) && !ku3Bulunanlar.includes(x.kelime));
  if(kacirilanlar.length){
    const baslik = document.createElement('p');
    baslik.style.textAlign='center'; baslik.style.fontWeight='bold'; baslik.style.color='var(--kirmizi)';
    baslik.textContent = 'Kaçırdıkların:';
    kacirilanKutu.appendChild(baslik);
    const ul = document.createElement('ul'); ul.className='ku-liste';
    kacirilanlar.forEach(item=>{
      const li = document.createElement('li');
      li.style.background='#ffe8d6'; li.style.borderColor='var(--sari)';
      li.textContent = `${item.kelime} — ${item.anlam}`;
      ul.appendChild(li);
    });
    kacirilanKutu.appendChild(ul);
  }
  document.getElementById('ku3Sonuc').textContent = `⏰ Süre bitti! "${ku3AktifHarf}" harfiyle ${ku3Puan} doğru kelime yazdın!`;
}

// =====================================================================
// TUZAK HARF
// =====================================================================
const tuzak3GecerliHarfler = ["A","E","İ","K","S"];
let tuzak3Harf = '', tuzak3Bulunanlar = [], tuzak3Sure = 40, tuzak3Zamanlayici = null, tuzak3Puan = 0, tuzak3Bitti = true;

function tuzak3Baslat(){
  clearInterval(tuzak3Zamanlayici);
  tuzak3Harf = tuzak3GecerliHarfler[Math.floor(Math.random()*tuzak3GecerliHarfler.length)];
  tuzak3Bulunanlar = []; tuzak3Puan = 0; tuzak3Sure = 40; tuzak3Bitti = false;
  document.getElementById('tuzak3Harf').textContent = tuzak3Harf;
  document.getElementById('tuzak3Sure').textContent = tuzak3Sure;
  document.getElementById('tuzak3Puan').textContent = 0;
  document.getElementById('tuzak3Liste').innerHTML = '';
  document.getElementById('tuzak3Sonuc').textContent = '';
  document.getElementById('tuzak3Uyari').textContent = '';
  const girdi = document.getElementById('tuzak3Girdi');
  girdi.value = ''; girdi.disabled = false; girdi.focus();
  tuzak3Zamanlayici = setInterval(()=>{
    tuzak3Sure--;
    document.getElementById('tuzak3Sure').textContent = tuzak3Sure;
    if(tuzak3Sure<=0) tuzak3Bitir();
  }, 1000);
}

function tuzak3Ekle(){
  if(tuzak3Bitti) return;
  const girdi = document.getElementById('tuzak3Girdi');
  const kelime = girdi.value.trim().toLocaleUpperCase('tr-TR');
  girdi.value = '';
  if(!kelime) return;
  const uyari = document.getElementById('tuzak3Uyari');
  if(kelime.includes(tuzak3Harf)){ uyari.textContent = `🚫 Bu kelimede tuzak harf "${tuzak3Harf}" var, geçersiz!`; return; }
  if(!kelimeHavuzu3.some(x=>x.kelime===kelime)){ uyari.textContent = `🤔 Bu kelimeyi bilmiyorum, ünitedeki bir kavram olmalı!`; return; }
  if(tuzak3Bulunanlar.includes(kelime)){ uyari.textContent = `⚠️ Bu kelimeyi zaten yazdın!`; return; }
  tuzak3Bulunanlar.push(kelime);
  tuzak3Puan++;
  document.getElementById('tuzak3Puan').textContent = tuzak3Puan;
  const li = document.createElement('li');
  li.textContent = kelime;
  document.getElementById('tuzak3Liste').appendChild(li);
  uyari.textContent = '';
}

function tuzak3Bitir(){
  clearInterval(tuzak3Zamanlayici);
  tuzak3Bitti = true;
  document.getElementById('tuzak3Girdi').disabled = true;
  document.querySelectorAll('#tuzak3Liste li').forEach(li=>{
    const kelime = li.textContent;
    li.textContent = `${kelime} — ${ku3AnlamBul(kelime)}`;
  });
  document.getElementById('tuzak3Sonuc').textContent = `⏰ Süre bitti! "${tuzak3Harf}" harfini kullanmadan ${tuzak3Puan} kelime yazdın!`;
}

// =====================================================================
// KELİME FABRİKASI
// =====================================================================
let kf3Sira = [], kf3Index = 0, kf3Uretilen = 0, kf3Hata = 0;

function kf3Baslat(){
  kf3Sira = karistir(kelimeHavuzu3.slice());
  kf3Index = 0; kf3Uretilen = 0; kf3Hata = 0;
  document.getElementById('kf3Uretilen').textContent = 0;
  document.getElementById('kf3Toplam').textContent = kf3Sira.length;
  document.getElementById('kf3Hata').textContent = 0;
  document.getElementById('kf3Urunler').innerHTML = '';
  document.getElementById('kf3Sonuc').textContent = '';
  kf3Tur();
}

function kf3Tur(){
  if(kf3Index >= kf3Sira.length){
    document.getElementById('kf3BantAlani').innerHTML = '';
    document.getElementById('kf3Siparis').textContent = '';
    document.getElementById('kf3Girdi').disabled = true;
    document.getElementById('kf3Sonuc').textContent = `🏭 Fabrika kapandı! ${kf3Uretilen}/${kf3Sira.length} kelime ürettin, ${kf3Hata} hata yaptın.`;
    return;
  }
  const oge = kf3Sira[kf3Index];
  document.getElementById('kf3Siparis').textContent = `📋 Sipariş: ${oge.anlam}`;
  const harfler = karistir(oge.kelime.split(''));
  const bant = document.getElementById('kf3BantAlani');
  bant.innerHTML = '';
  harfler.forEach(h=>{
    const kutu = document.createElement('div');
    kutu.className = 'kf-kutu';
    kutu.textContent = h;
    bant.appendChild(kutu);
  });
  const girdi = document.getElementById('kf3Girdi');
  girdi.value = ''; girdi.disabled = false; girdi.focus();
}

function kf3Uret(){
  if(kf3Index >= kf3Sira.length) return;
  const oge = kf3Sira[kf3Index];
  const girdi = document.getElementById('kf3Girdi');
  const tahmin = girdi.value.trim().toLocaleUpperCase('tr-TR');
  if(!tahmin) return;
  if(tahmin === oge.kelime){
    kf3Uretilen++;
    document.getElementById('kf3Uretilen').textContent = kf3Uretilen;
    const cip = document.createElement('div');
    cip.className = 'dua-cip';
    cip.textContent = `✅ ${oge.kelime}`;
    document.getElementById('kf3Urunler').appendChild(cip);
    kf3Index++;
    setTimeout(()=>kf3Tur(), 400);
  } else {
    kf3Hata++;
    document.getElementById('kf3Hata').textContent = kf3Hata;
    girdi.classList.add('yanlis-girdi');
    setTimeout(()=>girdi.classList.remove('yanlis-girdi'), 400);
    girdi.value = '';
  }
}

// =====================================================================
// KELİME MÜHENDİSİ
// =====================================================================
function parcalaraBol(kelime){
  const uzunluk = kelime.length;
  let parcaSayisi = uzunluk<=4 ? 2 : uzunluk<=7 ? 3 : 4;
  parcaSayisi = Math.min(parcaSayisi, uzunluk);
  const parcalar = [];
  let index = 0;
  for(let i=0;i<parcaSayisi;i++){
    const kalan = parcaSayisi - i;
    const buBoyut = i===parcaSayisi-1 ? uzunluk-index : Math.ceil((uzunluk-index)/kalan);
    parcalar.push(kelime.slice(index, index+buBoyut));
    index += buBoyut;
  }
  return parcalar;
}

let km3Sira = [], km3Index = 0, km3DogruSayisi = 0;

function km3Baslat(){
  km3Sira = karistir(kelimeHavuzu3.slice());
  km3Index = 0; km3DogruSayisi = 0;
  document.getElementById('km3Dogru').textContent = 0;
  document.getElementById('km3Toplam').textContent = km3Sira.length;
  document.getElementById('km3Sonuc').textContent = '';
  km3Tur();
}

function km3Tur(){
  if(km3Index >= km3Sira.length){
    document.getElementById('km3Ipucu').textContent = '';
    document.getElementById('km3Banka').innerHTML = '';
    document.getElementById('km3Cevap').innerHTML = '';
    document.getElementById('km3Sonuc').textContent = `🏆 Tebrikler! Kelime mühendisliğini tamamladın! ${km3DogruSayisi}/${km3Sira.length} kelime inşa ettin.`;
    return;
  }
  document.getElementById('km3Tur').textContent = km3Index+1;
  const oge = km3Sira[km3Index];
  document.getElementById('km3Ipucu').innerHTML = `📐 Plan: <b>${oge.anlam}</b>`;
  const parcalar = parcalaraBol(oge.kelime);
  siraOlustur({tokens:parcalar, bankaId:'km3Banka', cevapId:'km3Cevap', tamamlandi:()=>{
    km3DogruSayisi++;
    document.getElementById('km3Dogru').textContent = km3DogruSayisi;
    document.getElementById('km3Sonuc').textContent = `✅ İnşa edildi: ${oge.kelime}`;
    km3Index++;
    setTimeout(()=>{ document.getElementById('km3Sonuc').textContent=''; km3Tur(); }, 1000);
  }});
}

// =====================================================================
// KAVRAM TURNUVASI
// =====================================================================
const turnuvaEslesmeler3 = [
  {tur:"Çeyrek Final 1", a:"VAHİY", b:"AYET", soru:"Allah'ın (cc) peygamberlerine bildirdiği ilahi mesaja ne denir?", dogruCevap:"VAHİY"},
  {tur:"Çeyrek Final 2", a:"SURE", b:"CÜZ", soru:"Kur'an'ın ayetlerden oluşan bölümlerine ne denir?", dogruCevap:"SURE"},
  {tur:"Çeyrek Final 3", a:"HAFIZ", b:"TECVİT", soru:"Kur'an'ın tamamını ezberleyen kişiye ne denir?", dogruCevap:"HAFIZ"},
  {tur:"Çeyrek Final 4", a:"MUSHAF", b:"MEAL", soru:"Kur'an-ı Kerim'in yazılı kitabına ne denir?", dogruCevap:"MUSHAF"},
  {tur:"Yarı Final 1", a:"VAHİY", b:"SURE", soru:"Kur'an'ın Hz. Muhammed'e (sav) indirilen ilahi mesaj olma özelliği hangisidir?", dogruCevap:"VAHİY"},
  {tur:"Yarı Final 2", a:"HAFIZ", b:"MUSHAF", soru:"Kur'an'ı ezbere bilen kişiye ne denir?", dogruCevap:"HAFIZ"},
  {tur:"Final", a:"VAHİY", b:"HAFIZ", soru:"Bu ünitenin ana konusu olan kitabın Allah'tan (cc) gelme özelliği hangisidir?", dogruCevap:"VAHİY"}
];
let kt3Index = 0, kt3DogruHakemlik = 0;

function kt3Baslat(){
  kt3Index = 0; kt3DogruHakemlik = 0;
  document.getElementById('kt3Puan').textContent = 0;
  document.getElementById('kt3Toplam').textContent = turnuvaEslesmeler3.length;
  document.getElementById('kt3Sonuc').textContent = '';
  kt3Tur();
}

function kt3Tur(){
  if(kt3Index >= turnuvaEslesmeler3.length){
    document.getElementById('kt3Asama').textContent = '';
    document.getElementById('kt3Eslesme').textContent = '';
    document.getElementById('kt3Secenekler').innerHTML = '';
    const sampiyon = turnuvaEslesmeler3[turnuvaEslesmeler3.length-1].dogruCevap;
    document.getElementById('kt3Sonuc').textContent = `🏆 Turnuva Şampiyonu: ${sampiyon}! Hakemlik doğruluğun: ${kt3DogruHakemlik}/${turnuvaEslesmeler3.length}`;
    return;
  }
  const mac = turnuvaEslesmeler3[kt3Index];
  document.getElementById('kt3Tur').textContent = kt3Index+1;
  document.getElementById('kt3Asama').textContent = mac.tur;
  document.getElementById('kt3Eslesme').innerHTML = `🥊 <b>${mac.a}</b> vs <b>${mac.b}</b><br>❓ ${mac.soru}`;
  const kutu = document.getElementById('kt3Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  [mac.a, mac.b].forEach(aday=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = aday;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      tiklandiMi = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(aday === mac.dogruCevap){
        btn.classList.add('dogru');
        kt3DogruHakemlik++;
        document.getElementById('kt3Puan').textContent = kt3DogruHakemlik;
      } else {
        btn.classList.add('yanlis');
        tumBtn.forEach(b=>{ if(b.textContent===mac.dogruCevap) b.classList.add('dogru'); });
      }
      kt3Index++;
      setTimeout(()=>kt3Tur(), 1300);
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// BONUS OYUN — Hafıza Zinciri
// =====================================================================
const bz3Tuslar = [
  {simge:"VAHİY", renk:"#2a6f97"}, {simge:"AYET", renk:"#40916c"},
  {simge:"SURE", renk:"#d62828"}, {simge:"CÜZ", renk:"#f4a261"},
  {simge:"HAFIZ", renk:"#1E3A8A"}, {simge:"MUSHAF", renk:"#06B6D4"},
  {simge:"TEFSİR", renk:"#7c3aed"}, {simge:"MEAL", renk:"#be123c"},
  {simge:"HATİM", renk:"#0f766e"}, {simge:"NUR", renk:"#ea580c"},
  {simge:"RAHMET", renk:"#2a6f97"}, {simge:"HİDAYET", renk:"#40916c"}
];
let bz3Sira = [], bz3KullaniciIndex = 0, bz3Seviye = 0, bz3Oynatiliyor = false;

function bz3IzgaraOlustur(){
  const izgara = document.getElementById('bz3Izgara');
  izgara.innerHTML = '';
  bz3Tuslar.forEach((t,i)=>{
    const tus = document.createElement('div');
    tus.className = 'bz-tus';
    tus.style.background = t.renk;
    tus.textContent = t.simge;
    tus.onclick = ()=>bz3TusaTikla(i);
    izgara.appendChild(tus);
  });
}
function bz3Baslat(){
  bz3Sira = []; bz3Seviye = 0; bz3KullaniciIndex = 0;
  document.getElementById('bz3Seviye').textContent = 0;
  document.getElementById('bz3Sonuc').textContent = '';
  bz3IzgaraOlustur();
  bz3SonrakiTur();
}
function bz3SonrakiTur(){
  bz3Seviye++;
  document.getElementById('bz3Seviye').textContent = bz3Seviye;
  bz3Sira.push(Math.floor(Math.random()*bz3Tuslar.length));
  bz3KullaniciIndex = 0;
  bz3Oynat();
}
function bz3Oynat(){
  bz3Oynatiliyor = true;
  const dugmeler = document.querySelectorAll('#bz3Izgara .bz-tus');
  dugmeler.forEach(d=>d.classList.add('bz-devre-disi'));
  let i = 0;
  const aralik = setInterval(()=>{
    if(i>0) dugmeler[bz3Sira[i-1]].classList.remove('bz-yanik');
    if(i>=bz3Sira.length){
      clearInterval(aralik);
      bz3Oynatiliyor = false;
      dugmeler.forEach(d=>d.classList.remove('bz-devre-disi'));
      return;
    }
    dugmeler[bz3Sira[i]].classList.add('bz-yanik');
    i++;
  }, 700);
}
function bz3TusaTikla(i){
  if(bz3Oynatiliyor) return;
  const dugmeler = document.querySelectorAll('#bz3Izgara .bz-tus');
  dugmeler[i].classList.add('bz-yanik');
  setTimeout(()=>dugmeler[i].classList.remove('bz-yanik'), 250);
  if(bz3Sira[bz3KullaniciIndex] === i){
    bz3KullaniciIndex++;
    if(bz3KullaniciIndex === bz3Sira.length){
      setTimeout(()=>bz3SonrakiTur(), 900);
    }
  } else {
    document.getElementById('bz3Sonuc').textContent = `💥 Yanlış sıra! En uzun hatırladığın zincir: ${bz3Seviye-1}`;
  }
}
function bz3OrnekOyna(){
  document.getElementById('bz3Sonuc').textContent = '🎬 Örnek gösteriliyor: önce sıra yanacak, sonra otomatik olarak aynı sırayla tıklanacak...';
  document.getElementById('bz3Seviye').textContent = 'Örnek';
  bz3IzgaraOlustur();
  const demoSira = [0, 2, 1];
  const dugmeler = document.querySelectorAll('#bz3Izgara .bz-tus');
  dugmeler.forEach(d=>d.classList.add('bz-devre-disi'));
  let i = 0;
  const gosterAralik = setInterval(()=>{
    if(i>0) dugmeler[demoSira[i-1]].classList.remove('bz-yanik');
    if(i >= demoSira.length){
      clearInterval(gosterAralik);
      let j = 0;
      const tiklaAralik = setInterval(()=>{
        if(j>0) dugmeler[demoSira[j-1]].classList.remove('bz-yanik');
        if(j >= demoSira.length){
          clearInterval(tiklaAralik);
          dugmeler.forEach(d=>d.classList.remove('bz-devre-disi'));
          document.getElementById('bz3Seviye').textContent = 0;
          document.getElementById('bz3Sonuc').textContent = '👆 Gördüğün gibi: önce kavramlar sırayla yandı, sonra aynı sırayla tıklandı. Şimdi sıra sende — "Oyunu Başlat"a bas!';
          return;
        }
        dugmeler[demoSira[j]].classList.add('bz-yanik');
        j++;
      }, 700);
      return;
    }
    dugmeler[demoSira[i]].classList.add('bz-yanik');
    i++;
  }, 700);
}

// =====================================================================
// KELİME AVI BULMACASI
// =====================================================================
const kelimeAvi3Listesi = [
  {kelime:"VAHİY", anlam:"Allah'ın (cc) bildirdiği ilahi mesaj"},
  {kelime:"AYET", anlam:"Kur'an'ın en küçük bölümü"},
  {kelime:"SURE", anlam:"Kur'an'ın ayetlerden oluşan bölümü"},
  {kelime:"CÜZ", anlam:"Kur'an'ın otuzda birlik parçası"},
  {kelime:"HAFIZ", anlam:"Kur'an'ı ezberleyen kişi"},
  {kelime:"MUSHAF", anlam:"Kur'an'ın yazılı kitabı"},
  {kelime:"TEFSİR", anlam:"Ayetleri açıklama ilmi"},
  {kelime:"MEAL", anlam:"Kur'an'ın anlam çevirisi"},
  {kelime:"HATİM", anlam:"Kur'an'ı baştan sona okuma"},
  {kelime:"FATİHA", anlam:"Kur'an'ın ilk suresi"},
  {kelime:"HİDAYET", anlam:"Doğru yolu bulma"},
  {kelime:"RAHMET", anlam:"Allah'ın (cc) merhameti"},
  {kelime:"NUR", anlam:"Işık, yol gösterme"},
  {kelime:"FURKAN", anlam:"Hakkı batıldan ayıran"}
];
const ka3SatirSayisi = 14, ka3SutunSayisi = 14;
const ka3AsciiHarfler = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ";

function ka3KelimeYerlestir(izgara, kelime){
  const yonler = karistir([{dr:0,dc:1},{dr:0,dc:-1},{dr:1,dc:0},{dr:-1,dc:0}]);
  for(let deneme=0; deneme<200; deneme++){
    const yon = yonler[deneme % yonler.length];
    const satir = Math.floor(Math.random()*ka3SatirSayisi);
    const sutun = Math.floor(Math.random()*ka3SutunSayisi);
    const bitSatir = satir + yon.dr*(kelime.length-1);
    const bitSutun = sutun + yon.dc*(kelime.length-1);
    if(bitSatir<0 || bitSatir>=ka3SatirSayisi || bitSutun<0 || bitSutun>=ka3SutunSayisi) continue;
    let uygun = true;
    for(let i=0;i<kelime.length;i++){
      const r = satir + yon.dr*i, c = sutun + yon.dc*i;
      if(izgara[r][c] !== null && izgara[r][c] !== kelime[i]){ uygun=false; break; }
    }
    if(!uygun) continue;
    const hucreler=[];
    for(let i=0;i<kelime.length;i++){
      const r = satir + yon.dr*i, c = sutun + yon.dc*i;
      izgara[r][c] = kelime[i];
      hucreler.push({r,c});
    }
    return hucreler;
  }
  return null;
}

function kelimeAvi83Olustur(){
  let izgara, basarili=false;
  for(let genelDeneme=0; genelDeneme<40 && !basarili; genelDeneme++){
    izgara = Array.from({length:ka3SatirSayisi}, ()=>Array(ka3SutunSayisi).fill(null));
    basarili = true;
    const siraliKelimeler = kelimeAvi3Listesi.slice().sort((a,b)=>b.kelime.length-a.kelime.length);
    for(const item of siraliKelimeler){
      const hucreler = ka3KelimeYerlestir(izgara, item.kelime);
      if(!hucreler){ basarili=false; break; }
    }
  }
  for(let r=0;r<ka3SatirSayisi;r++){
    for(let c=0;c<ka3SutunSayisi;c++){
      if(izgara[r][c]===null) izgara[r][c] = ka3AsciiHarfler[Math.floor(Math.random()*ka3AsciiHarfler.length)];
    }
  }

  const kutu = document.getElementById('ka3Izgara');
  kutu.innerHTML = '';
  kutu.style.gridTemplateColumns = `repeat(${ka3SutunSayisi}, 1fr)`;
  const hucreElemanlari = [];
  for(let r=0;r<ka3SatirSayisi;r++){
    hucreElemanlari.push([]);
    for(let c=0;c<ka3SutunSayisi;c++){
      const h = document.createElement('div');
      h.className = 'ka-hucre';
      h.textContent = izgara[r][c];
      h.dataset.r = r; h.dataset.c = c;
      kutu.appendChild(h);
      hucreElemanlari[r].push(h);
    }
  }

  const liste = document.getElementById('ka3Liste');
  liste.innerHTML = '';
  kelimeAvi3Listesi.forEach(item=>{
    const li = document.createElement('li');
    li.id = 'ka3-kelime-' + item.kelime;
    li.textContent = `${item.kelime} — ${item.anlam}`;
    liste.appendChild(li);
  });
  document.getElementById('ka3Bulunan').textContent = 0;
  document.getElementById('ka3Toplam').textContent = kelimeAvi3Listesi.length;
  document.getElementById('ka3Sonuc').textContent = '';

  let ilkHucre = null;
  hucreElemanlari.flat().forEach(h=>{
    h.onclick = ()=>{
      if(h.classList.contains('ka-bulundu')) return;
      if(!ilkHucre){ ilkHucre = h; h.classList.add('ka-secili'); return; }
      if(ilkHucre === h){ ilkHucre.classList.remove('ka-secili'); ilkHucre=null; return; }
      const r1=+ilkHucre.dataset.r, c1=+ilkHucre.dataset.c;
      const r2=+h.dataset.r, c2=+h.dataset.c;
      let yol = [];
      if(r1===r2){
        const adim = c2>c1?1:-1;
        for(let c=c1;;c+=adim){ yol.push({r:r1,c}); if(c===c2) break; }
      } else if(c1===c2){
        const adim = r2>r1?1:-1;
        for(let r=r1;;r+=adim){ yol.push({r,c:c1}); if(r===r2) break; }
      } else {
        ilkHucre.classList.remove('ka-secili');
        h.classList.add('ka-secili');
        ilkHucre = h;
        return;
      }
      const secilenKelime = yol.map(p=>izgara[p.r][p.c]).join('');
      const tersKelime = secilenKelime.split('').reverse().join('');
      const eslesen = kelimeAvi3Listesi.find(item =>
        (item.kelime===secilenKelime || item.kelime===tersKelime) &&
        !document.getElementById('ka3-kelime-'+item.kelime).classList.contains('bulundu-satir')
      );
      if(eslesen){
        yol.forEach(p=>{
          hucreElemanlari[p.r][p.c].classList.remove('ka-secili');
          hucreElemanlari[p.r][p.c].classList.add('ka-bulundu');
        });
        document.getElementById('ka3-kelime-'+eslesen.kelime).classList.add('bulundu-satir');
        const bulunanSayisi = document.querySelectorAll('#ka3Liste .bulundu-satir').length;
        document.getElementById('ka3Bulunan').textContent = bulunanSayisi;
        if(bulunanSayisi === kelimeAvi3Listesi.length){
          document.getElementById('ka3Sonuc').textContent = '🎉 Tebrikler! Tüm kelimeleri buldun!';
        }
      } else {
        ilkHucre.classList.remove('ka-secili');
      }
      ilkHucre = null;
    };
  });
}

// =====================================================================
// ÇENGEL BULMACA
// =====================================================================
const cengel3Zinciri = [
  {kelime:"SURE", anlam:"Kur'an'ın ayetlerden oluşan bölümü"},
  {kelime:"EZBER", anlam:"Bir metni tekrar ederek zihinde tutma"},
  {kelime:"RAHMET", anlam:"Allah'ın (cc) sonsuz merhameti"},
  {kelime:"TEFSİR", anlam:"Ayetlerin anlamını açıklama ilmi"},
  {kelime:"RIZA", anlam:"Allah'ın (cc) hoşnutluğu"}
];
let cengel3HucreHarita = {}, cengel3InputMap = {};

function cengel3Olustur(){
  let r=0, c=0, dir='right';
  const yerlesimler = [];
  cengel3Zinciri.forEach(item=>{
    const kelime = item.kelime;
    const hucreler = [];
    for(let j=0;j<kelime.length;j++){
      hucreler.push(dir==='right' ? {r, c:c+j} : {r:r+j, c});
    }
    yerlesimler.push({...item, hucreler, dir});
    const son = hucreler[hucreler.length-1];
    r = son.r; c = son.c;
    dir = dir==='right' ? 'down' : 'right';
  });

  let minR=Infinity,maxR=-Infinity,minC=Infinity,maxC=-Infinity;
  yerlesimler.forEach(p=>p.hucreler.forEach(h=>{
    minR=Math.min(minR,h.r); maxR=Math.max(maxR,h.r);
    minC=Math.min(minC,h.c); maxC=Math.max(maxC,h.c);
  }));
  const satirSayisi = maxR-minR+1, sutunSayisi = maxC-minC+1;

  cengel3HucreHarita = {};
  yerlesimler.forEach(p=>{
    p.hucreler.forEach((h,i)=>{
      const key = (h.r-minR)+','+(h.c-minC);
      cengel3HucreHarita[key] = p.kelime[i];
    });
  });

  const siraliHucreler = [];
  const gorulen = new Set();
  yerlesimler.forEach((p, idx)=>{
    const baslangic = idx===0 ? 0 : 1;
    for(let i=baslangic;i<p.hucreler.length;i++){
      const h = p.hucreler[i];
      const key = (h.r-minR)+','+(h.c-minC);
      if(!gorulen.has(key)){ gorulen.add(key); siraliHucreler.push(key); }
    }
  });

  const izgara = document.getElementById('cengel3Izgara');
  izgara.innerHTML = '';
  izgara.style.gridTemplateColumns = `repeat(${sutunSayisi}, 34px)`;
  izgara.style.gridTemplateRows = `repeat(${satirSayisi}, 34px)`;
  cengel3InputMap = {};
  for(let rr=0; rr<satirSayisi; rr++){
    for(let cc=0; cc<sutunSayisi; cc++){
      const key = rr+','+cc;
      const hucreDiv = document.createElement('div');
      hucreDiv.style.gridColumn = (cc+1);
      hucreDiv.style.gridRow = (rr+1);
      if(cengel3HucreHarita[key] !== undefined){
        hucreDiv.className = 'cengel-hucre';
        const girdi = document.createElement('input');
        girdi.maxLength = 1;
        girdi.className = 'cengel-girdi';
        girdi.dataset.key = key;
        girdi.oninput = (e)=>{
          e.target.value = e.target.value.toLocaleUpperCase('tr-TR').slice(-1);
          e.target.classList.remove('dogru','yanlis');
          const idx = siraliHucreler.indexOf(key);
          if(idx>=0 && idx<siraliHucreler.length-1){
            const sonrakiKey = siraliHucreler[idx+1];
            if(cengel3InputMap[sonrakiKey]) cengel3InputMap[sonrakiKey].focus();
          }
        };
        hucreDiv.appendChild(girdi);
        cengel3InputMap[key] = girdi;
      } else {
        hucreDiv.className = 'cengel-bos';
      }
      izgara.appendChild(hucreDiv);
    }
  }

  const liste = document.getElementById('cengel3Liste');
  liste.innerHTML = '';
  yerlesimler.forEach((p, idx)=>{
    const li = document.createElement('li');
    li.textContent = `${idx+1}. ${p.dir==='right'?'➡️':'⬇️'} (${p.kelime.length} harf) ${p.anlam}`;
    liste.appendChild(li);
  });

  document.getElementById('cengel3Sonuc').textContent = '';
}

function cengel3KontrolEt(){
  let dogruSayisi=0, toplam=0;
  Object.keys(cengel3HucreHarita).forEach(key=>{
    toplam++;
    const girdi = cengel3InputMap[key];
    const beklenen = cengel3HucreHarita[key];
    if(girdi.value && girdi.value.toLocaleUpperCase('tr-TR') === beklenen.toLocaleUpperCase('tr-TR')){
      girdi.classList.add('dogru'); girdi.classList.remove('yanlis');
      dogruSayisi++;
    } else {
      girdi.classList.add('yanlis'); girdi.classList.remove('dogru');
    }
  });
  document.getElementById('cengel3Sonuc').textContent = dogruSayisi===toplam
    ? `🎉 Tebrikler! Çengel bulmacayı tamamen doğru çözdün! (${dogruSayisi}/${toplam})`
    : `Sonuç: ${dogruSayisi}/${toplam} doğru harf. Devam et!`;
}

// =====================================================================
// SÖZCÜK MERDİVENİ
// =====================================================================
const merdiven3Zinciri = [
  {kelime:"MUSHAF", anlam:"Kur'an-ı Kerim'in yazılı kitabı"},
  {kelime:"FATİHA", anlam:"Kur'an'ın ilk suresi"},
  {kelime:"AYET", anlam:"Kur'an'ın en küçük bölümü"},
  {kelime:"TEFSİR", anlam:"Ayetlerin anlamını açıklama ilmi"},
  {kelime:"RAHMET", anlam:"Allah'ın (cc) sonsuz merhameti"}
];
const merdiven3Havuz = ["VAHİY","SURE","CÜZ","HAFIZ","TECVİT","NÜZUL","KIRAAT","MEAL","HATİM","CEBRAİL","KADİR","BESMELE","HİDAYET","ŞİFA","NUR","FURKAN","KELAMULLAH","MEKKİ","MEDENİ","İCAZ"];
let merdiven3Index = 0;

function merdiven3Baslat(){
  merdiven3Index = 0;
  document.getElementById('merdiven3Toplam').textContent = merdiven3Zinciri.length;
  document.getElementById('merdiven3Sonuc').textContent = '';
  document.getElementById('merdiven3Gorsel').innerHTML = '';
  merdiven3BasamakEkle(merdiven3Zinciri[0].kelime, 0);
  merdiven3Tur();
}
function merdiven3BasamakEkle(kelime, index){
  const basamak = document.createElement('div');
  basamak.style.background='white'; basamak.style.border='2px solid var(--yesil)'; basamak.style.borderRadius='10px';
  basamak.style.padding='8px 14px'; basamak.style.margin='6px 0'; basamak.style.fontWeight='bold';
  basamak.style.marginLeft = (index*24) + 'px';
  basamak.textContent = `${index+1}. ${kelime}`;
  document.getElementById('merdiven3Gorsel').appendChild(basamak);
}
function merdiven3Tur(){
  document.getElementById('merdiven3Basamak').textContent = merdiven3Index+1;
  if(merdiven3Index+1 >= merdiven3Zinciri.length){
    document.getElementById('merdiven3Ipucu').textContent = '';
    document.getElementById('merdiven3Secenekler').innerHTML = '';
    document.getElementById('merdiven3Sonuc').textContent = '🎉 Tebrikler! Sözcük merdivenini tamamen tırmandın!';
    return;
  }
  const oncekiKelime = merdiven3Zinciri[merdiven3Index].kelime;
  const hedef = merdiven3Zinciri[merdiven3Index+1];
  const gerekliHarf = oncekiKelime[oncekiKelime.length-1];
  document.getElementById('merdiven3Ipucu').innerHTML = `🗨️ İpucu: <b>${hedef.anlam}</b><br>Bu kelime "<b>${gerekliHarf}</b>" harfiyle başlamalı!`;
  const yanlisHavuz = karistir(merdiven3Havuz.filter(k=>k!==hedef.kelime)).slice(0,3);
  const secenekler = karistir([hedef.kelime, ...yanlisHavuz]);
  const kutu = document.getElementById('merdiven3Secenekler');
  kutu.innerHTML = '';
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = secenek;
    btn.onclick = ()=>{
      if(secenek === hedef.kelime){
        btn.classList.add('dogru');
        merdiven3Index++;
        setTimeout(()=>{ merdiven3BasamakEkle(hedef.kelime, merdiven3Index); merdiven3Tur(); }, 700);
      } else {
        btn.classList.add('yanlis');
        setTimeout(()=>btn.classList.remove('yanlis'), 400);
      }
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// ŞİFRELİ SÖZCÜK
// =====================================================================
const turkAlfabesi83 = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ".split('');
let sifre3Anahtari = {};

function sifre3Olustur(){
  const sayilar = karistir(turkAlfabesi83.map((_,i)=>i+1));
  sifre3Anahtari = {};
  turkAlfabesi83.forEach((harf,i)=>{ sifre3Anahtari[harf] = sayilar[i]; });

  const anahtarKutu = document.getElementById('sifre3Anahtar');
  anahtarKutu.innerHTML = '';
  turkAlfabesi83.forEach(harf=>{
    const hucre = document.createElement('div');
    hucre.className = 'sifre-anahtar-hucre';
    hucre.innerHTML = `<b>${harf}</b><br>${sifre3Anahtari[harf]}`;
    anahtarKutu.appendChild(hucre);
  });

  const kutu = document.getElementById('sifre3Kelimeler');
  kutu.innerHTML = '';
  document.getElementById('sifre3Sonuc').textContent = '';

  kelimeHavuzu3.slice(0,20).forEach(item=>{
    const satir = document.createElement('div');
    satir.className = 'sifre-satir';
    const anlamP = document.createElement('p');
    anlamP.className = 'sifre-ipucu';
    anlamP.textContent = `💡 ${item.anlam}`;
    satir.appendChild(anlamP);

    const kutucuklar = document.createElement('div');
    kutucuklar.className = 'sifre-kutucuklar';
    const harfler = item.kelime.split('');
    const girdiler = [];
    harfler.forEach((harf)=>{
      const grup = document.createElement('div');
      grup.className = 'sifre-grup';
      const sayiEtiket = document.createElement('div');
      sayiEtiket.className = 'sifre-sayi';
      sayiEtiket.textContent = sifre3Anahtari[harf];
      const girdi = document.createElement('input');
      girdi.maxLength = 1;
      girdi.className = 'sifre-girdi';
      girdi.dataset.beklenen = harf;
      grup.appendChild(sayiEtiket);
      grup.appendChild(girdi);
      kutucuklar.appendChild(grup);
      girdiler.push(girdi);
    });
    girdiler.forEach((girdi, hIdx)=>{
      girdi.oninput = (e)=>{
        e.target.value = e.target.value.toLocaleUpperCase('tr-TR').slice(-1);
        e.target.classList.remove('dogru','yanlis');
        if(girdiler[hIdx+1]) girdiler[hIdx+1].focus();
      };
    });
    satir.appendChild(kutucuklar);
    kutu.appendChild(satir);
  });
}

function sifre3KontrolEt(){
  const girdiler = document.querySelectorAll('#sifre3Kelimeler .sifre-girdi');
  let dogruSayisi=0;
  girdiler.forEach(g=>{
    const beklenen = g.dataset.beklenen;
    if(g.value && g.value.toLocaleUpperCase('tr-TR') === beklenen.toLocaleUpperCase('tr-TR')){
      g.classList.add('dogru'); g.classList.remove('yanlis');
      dogruSayisi++;
    } else {
      g.classList.add('yanlis'); g.classList.remove('dogru');
    }
  });
  document.getElementById('sifre3Sonuc').textContent = dogruSayisi===girdiler.length
    ? `🎉 Tebrikler! Tüm şifreleri doğru çözdün! (${dogruSayisi}/${girdiler.length})`
    : `Sonuç: ${dogruSayisi}/${girdiler.length} doğru harf. Anahtar tablosuna bakarak devam et!`;
}

// =====================================================================
// ŞİFRELİ TANIM
// =====================================================================
const st3LeetHarita = {'a':'4','A':'4','e':'3','E':'3','i':'1','I':'1','İ':'1','ı':'1','o':'0','O':'0'};
function st3TanimSifrele(metin){
  return metin.split('').map(ch => st3LeetHarita[ch] !== undefined ? st3LeetHarita[ch] : ch).join('');
}
let st3Index = 0, st3Puan = 0, st3Sira = [];

function st3Baslat(){
  st3Sira = karistir(kelimeHavuzu3.slice());
  st3Index = 0; st3Puan = 0;
  document.getElementById('st3Puan').textContent = 0;
  document.getElementById('st3Toplam').textContent = st3Sira.length;
  document.getElementById('st3Sonuc').textContent = '';
  st3Tur();
}
function st3Tur(){
  if(st3Index >= st3Sira.length){
    document.getElementById('st3Tanim').textContent = '';
    document.getElementById('st3Secenekler').innerHTML = '';
    document.getElementById('st3Sonuc').textContent = `🏆 Tebrikler! ${st3Puan}/${st3Sira.length} şifreli tanımı doğru çözdün!`;
    return;
  }
  document.getElementById('st3Tur').textContent = st3Index+1;
  const oge = st3Sira[st3Index];
  document.getElementById('st3Tanim').textContent = st3TanimSifrele(oge.anlam);
  const digerler = karistir(kelimeHavuzu3.filter(x=>x.kelime!==oge.kelime)).slice(0,3);
  const secenekler = karistir([oge, ...digerler]);
  const kutu = document.getElementById('st3Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.style.display='block'; btn.style.width='100%'; btn.style.marginBottom='6px';
    btn.textContent = secenek.kelime;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      tiklandiMi = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(secenek.kelime === oge.kelime){
        btn.classList.add('dogru');
        st3Puan++;
        document.getElementById('st3Puan').textContent = st3Puan;
      } else {
        btn.classList.add('yanlis');
        tumBtn.forEach(b=>{ if(b.textContent===oge.kelime) b.classList.add('dogru'); });
      }
      st3Index++;
      setTimeout(()=>st3Tur(), 900);
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// KELİME KODLAMA
// =====================================================================
const kk3Alfabe = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ".split('');
const kk3KodTablosu = {};
kk3Alfabe.forEach((harf,i)=>{ kk3KodTablosu[harf] = (i+1).toString(2).padStart(5,'0'); });
function kk3KelimeyiKodla(kelime){
  return kelime.split('').map(h => kk3KodTablosu[h] || '?????').join(' ');
}
let kk3Index = 0, kk3Puan = 0, kk3Sira = [];

function kk3AnahtarOlustur(){
  const kutu = document.getElementById('kk3Anahtar');
  kutu.innerHTML = '';
  kk3Alfabe.forEach(harf=>{
    const hucre = document.createElement('div');
    hucre.className = 'sifre-anahtar-hucre';
    hucre.innerHTML = `<b>${harf}</b><br>${kk3KodTablosu[harf]}`;
    kutu.appendChild(hucre);
  });
}
function kk3Baslat(){
  kk3AnahtarOlustur();
  kk3Sira = karistir(kelimeHavuzu3.slice());
  kk3Index = 0; kk3Puan = 0;
  document.getElementById('kk3Puan').textContent = 0;
  document.getElementById('kk3Toplam').textContent = kk3Sira.length;
  document.getElementById('kk3Sonuc').textContent = '';
  kk3Tur();
}
function kk3Tur(){
  if(kk3Index >= kk3Sira.length){
    document.getElementById('kk3Kod').textContent = '';
    document.getElementById('kk3Ipucu').textContent = '';
    document.getElementById('kk3Secenekler').innerHTML = '';
    document.getElementById('kk3Sonuc').textContent = `🏆 Tebrikler! ${kk3Puan}/${kk3Sira.length} kodu doğru çözdün!`;
    return;
  }
  document.getElementById('kk3Tur').textContent = kk3Index+1;
  const oge = kk3Sira[kk3Index];
  document.getElementById('kk3Ipucu').innerHTML = `💡 İpucu: <b>${oge.anlam}</b>`;
  document.getElementById('kk3Kod').textContent = kk3KelimeyiKodla(oge.kelime);
  const digerler = karistir(kelimeHavuzu3.filter(x=>x.kelime!==oge.kelime)).slice(0,3);
  const secenekler = karistir([oge, ...digerler]);
  const kutu = document.getElementById('kk3Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.style.display='block'; btn.style.width='100%'; btn.style.marginBottom='6px';
    btn.textContent = secenek.kelime;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      tiklandiMi = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(secenek.kelime === oge.kelime){
        btn.classList.add('dogru');
        kk3Puan++;
        document.getElementById('kk3Puan').textContent = kk3Puan;
      } else {
        btn.classList.add('yanlis');
        tumBtn.forEach(b=>{ if(b.textContent===oge.kelime) b.classList.add('dogru'); });
      }
      kk3Index++;
      setTimeout(()=>kk3Tur(), 1000);
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// NONOGRAM
// =====================================================================
const nonogram3Resimleri = {
  kitap: { etiket: "📖 Açık Kitap (Kur'an-ı Kerim)", veri: [
    "0000000000000000","0011111001111100","0111111111111110","0111000110001110",
    "0111011111011110","0111011111011110","0111011111011110","0111011111011110",
    "0111011111011110","0111011111011110","0111000110001110","0111111111111110",
    "0011111001111100","0000000000000000","0000000000000000","0000000000000000"
  ]},
  hilal: { etiket: "🌙⭐ Hilal (Kadir Gecesi)", veri: [
    "0000000000000000","0000011110000000","0001111111000000","0011111111100000",
    "0111111111110000","0111111000000000","0111111000000000","0111111000000000",
    "0011111100000000","0001111111000000","0000011110000000","0000000000110000",
    "0000000001111000","0000000000110000","0000000000000000","0000000000000000"
  ]}
};
let nonogram3AktifResim = 'kumsaati';
const nono3Boyut = nonogram3Resimleri.kumsaati.veri.length;
let nono3KullaniciIzgara = [];
let nono3HucreElemanlari = [];

function ipucu83Hesapla(diziStr){
  const gruplar = diziStr.split('0').filter(s=>s.length>0).map(s=>s.length);
  return gruplar.length ? gruplar : [0];
}
function nonogram3Sec(resimAdi){ nonogram3AktifResim = resimAdi; nonogram3Olustur(); }
function nonogram3Olustur(){
  const cozum = nonogram3Resimleri[nonogram3AktifResim].veri;
  nono3KullaniciIzgara = Array.from({length:nono3Boyut}, ()=>Array(nono3Boyut).fill(false));
  document.getElementById('nono3Sonuc').textContent = '';
  const satirIpuclari = cozum.map(r=>ipucu83Hesapla(r));
  const sutunDizeleri = [];
  for(let c=0;c<nono3Boyut;c++){
    let s='';
    for(let r=0;r<nono3Boyut;r++) s += cozum[r][c];
    sutunDizeleri.push(s);
  }
  const sutunIpuclari = sutunDizeleri.map(s=>ipucu83Hesapla(s));
  const tablo = document.getElementById('nono3Tablo');
  tablo.innerHTML = '';
  const basSatir = document.createElement('tr');
  const koseTd = document.createElement('td');
  basSatir.appendChild(koseTd);
  for(let c=0;c<nono3Boyut;c++){
    const td = document.createElement('td');
    td.className = 'nono-sutun-ipucu';
    sutunIpuclari[c].forEach((sayi,i)=>{
      if(i>0) td.appendChild(document.createElement('br'));
      td.appendChild(document.createTextNode(sayi));
    });
    if((c+1)%5===0 && c<nono3Boyut-1) td.style.borderRight = '2px solid #333';
    basSatir.appendChild(td);
  }
  tablo.appendChild(basSatir);
  nono3HucreElemanlari = [];
  for(let r=0;r<nono3Boyut;r++){
    const tr = document.createElement('tr');
    const satirTd = document.createElement('td');
    satirTd.className = 'nono-satir-ipucu';
    satirTd.textContent = satirIpuclari[r].join(' ');
    if((r+1)%5===0 && r<nono3Boyut-1) satirTd.style.borderBottom = '2px solid #333';
    tr.appendChild(satirTd);
    nono3HucreElemanlari.push([]);
    for(let c=0;c<nono3Boyut;c++){
      const td = document.createElement('td');
      td.className = 'nono-hucre';
      if((c+1)%5===0 && c<nono3Boyut-1) td.style.borderRight = '2px solid #333';
      if((r+1)%5===0 && r<nono3Boyut-1) td.style.borderBottom = '2px solid #333';
      td.onclick = ((rr,cc)=>()=>{
        nono3KullaniciIzgara[rr][cc] = !nono3KullaniciIzgara[rr][cc];
        td.classList.toggle('dolu', nono3KullaniciIzgara[rr][cc]);
        nonogram3KontrolEt(false);
      })(r,c);
      tr.appendChild(td);
      nono3HucreElemanlari[r].push(td);
    }
    tablo.appendChild(tr);
  }
}
function nonogram3KontrolEt(manuel){
  const cozum = nonogram3Resimleri[nonogram3AktifResim].veri;
  let tamMi = true;
  for(let r=0;r<nono3Boyut;r++){
    for(let c=0;c<nono3Boyut;c++){
      const beklenen = cozum[r][c] === '1';
      if(nono3KullaniciIzgara[r][c] !== beklenen) tamMi = false;
    }
  }
  if(tamMi){
    document.getElementById('nono3Sonuc').textContent = `🎉 Tebrikler! Gizli resmi (${nonogram3Resimleri[nonogram3AktifResim].etiket}) doğru tamamladın!`;
  } else if(manuel){
    document.getElementById('nono3Sonuc').textContent = 'Henüz tam değil, ipuçlarına bakarak devam et!';
  }
}
function nonogram3Temizle(){
  nono3KullaniciIzgara = Array.from({length:nono3Boyut}, ()=>Array(nono3Boyut).fill(false));
  nono3HucreElemanlari.forEach(satir=>satir.forEach(td=>td.classList.remove('dolu')));
  document.getElementById('nono3Sonuc').textContent = '';
}

// =====================================================================
// KELİME SATRANCI
// =====================================================================
const ks3Boyut = 8;
const ks3AtHamleleri = [[1,2],[1,-2],[-1,2],[-1,-2],[2,1],[2,-1],[-2,1],[-2,-1]];
const ks3KelimeListesi = [
  {kelime:"VAHİY", anlam:"Allah'ın (cc) bildirdiği ilahi mesaj"},
  {kelime:"SURE", anlam:"Kur'an'ın ayetlerden oluşan bölümü"},
  {kelime:"CÜZ", anlam:"Kur'an'ın otuzda birlik parçası"},
  {kelime:"HAFIZ", anlam:"Kur'an'ı ezberleyen kişi"},
  {kelime:"MEAL", anlam:"Kur'an'ın anlam çevirisi"},
  {kelime:"NUR", anlam:"Işık, yol gösterme"},
  {kelime:"HATİM", anlam:"Kur'an'ı baştan sona okuma"},
  {kelime:"ŞİFA", anlam:"Kalplere derman olma"}
];
const ks3AsciiHarfler = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ";
let ks3IzgaraVeri = [];
let ks3HucreElemanlari = [];
let ks3BulunanKelimeler = new Set();
let ks3Yol = [];

function ks3KelimeYerlestir(izgara, kelime){
  for(let deneme=0; deneme<300; deneme++){
    const gecici = izgara.map(satir=>satir.slice());
    const r0 = Math.floor(Math.random()*ks3Boyut);
    const c0 = Math.floor(Math.random()*ks3Boyut);
    if(gecici[r0][c0] !== null && gecici[r0][c0] !== kelime[0]) continue;
    gecici[r0][c0] = kelime[0];
    const hucreler = [{r:r0,c:c0}];
    const kullanilan = new Set([r0+','+c0]);
    let r=r0, c=c0, basarili=true;
    for(let i=1;i<kelime.length;i++){
      const olasilar = karistir(ks3AtHamleleri.slice()).filter(([dr,dc])=>{
        const nr=r+dr, nc=c+dc;
        if(nr<0 || nr>=ks3Boyut || nc<0 || nc>=ks3Boyut) return false;
        if(kullanilan.has(nr+','+nc)) return false;
        return gecici[nr][nc]===null || gecici[nr][nc]===kelime[i];
      });
      if(olasilar.length===0){ basarili=false; break; }
      const [dr,dc] = olasilar[0];
      r+=dr; c+=dc;
      gecici[r][c] = kelime[i];
      hucreler.push({r,c});
      kullanilan.add(r+','+c);
    }
    if(basarili){
      hucreler.forEach((h,i)=>{ izgara[h.r][h.c] = kelime[i]; });
      return hucreler;
    }
  }
  return null;
}
function ks3Olustur(){
  let izgara, basarili=false;
  for(let genelDeneme=0; genelDeneme<40 && !basarili; genelDeneme++){
    izgara = Array.from({length:ks3Boyut}, ()=>Array(ks3Boyut).fill(null));
    basarili = true;
    const siraliKelimeler = ks3KelimeListesi.slice().sort((a,b)=>b.kelime.length-a.kelime.length);
    for(const item of siraliKelimeler){
      const hucreler = ks3KelimeYerlestir(izgara, item.kelime);
      if(!hucreler){ basarili=false; break; }
    }
  }
  for(let r=0;r<ks3Boyut;r++){
    for(let c=0;c<ks3Boyut;c++){
      if(izgara[r][c]===null) izgara[r][c] = ks3AsciiHarfler[Math.floor(Math.random()*ks3AsciiHarfler.length)];
    }
  }
  ks3IzgaraVeri = izgara;
  ks3BulunanKelimeler = new Set();
  ks3Yol = [];
  const kutu = document.getElementById('ks3Izgara');
  kutu.innerHTML = '';
  ks3HucreElemanlari = [];
  for(let r=0;r<ks3Boyut;r++){
    ks3HucreElemanlari.push([]);
    for(let c=0;c<ks3Boyut;c++){
      const h = document.createElement('div');
      h.className = 'ks-hucre ' + ((r+c)%2===0 ? 'acik' : 'koyu');
      h.textContent = izgara[r][c];
      h.onclick = ()=>ks3Tikla(r,c);
      kutu.appendChild(h);
      ks3HucreElemanlari[r].push(h);
    }
  }
  const liste = document.getElementById('ks3Liste');
  liste.innerHTML = '';
  ks3KelimeListesi.forEach(item=>{
    const li = document.createElement('li');
    li.id = 'ks3-kelime-' + item.kelime;
    li.textContent = `${item.kelime} — ${item.anlam}`;
    liste.appendChild(li);
  });
  document.getElementById('ks3Bulunan').textContent = 0;
  document.getElementById('ks3Toplam').textContent = ks3KelimeListesi.length;
  document.getElementById('ks3Sonuc').textContent = '';
}
function ks3SecimiTemizle(){
  ks3Yol.forEach(p=>ks3HucreElemanlari[p.r][p.c].classList.remove('ks-secili'));
  ks3Yol = [];
}
function ks3Tikla(r,c){
  const hucreEl = ks3HucreElemanlari[r][c];
  if(hucreEl.classList.contains('ks-bulundu')) return;
  let yeniYol;
  if(ks3Yol.length===0){ yeniYol = [{r,c}]; }
  else {
    const son = ks3Yol[ks3Yol.length-1];
    const gecerliHamle = ks3AtHamleleri.some(([hr,hc]) => son.r+hr===r && son.c+hc===c);
    yeniYol = gecerliHamle ? [...ks3Yol, {r,c}] : [{r,c}];
  }
  const dizi = yeniYol.map(p=>ks3IzgaraVeri[p.r][p.c]).join('');
  const tamEslesen = ks3KelimeListesi.find(item => item.kelime===dizi && !ks3BulunanKelimeler.has(item.kelime));
  const onEkMi = ks3KelimeListesi.some(item => !ks3BulunanKelimeler.has(item.kelime) && item.kelime.startsWith(dizi));
  ks3Yol.forEach(p=>ks3HucreElemanlari[p.r][p.c].classList.remove('ks-secili'));
  if(tamEslesen){
    yeniYol.forEach(p=>ks3HucreElemanlari[p.r][p.c].classList.add('ks-bulundu'));
    ks3BulunanKelimeler.add(tamEslesen.kelime);
    document.getElementById('ks3Bulunan').textContent = ks3BulunanKelimeler.size;
    document.getElementById('ks3-kelime-'+tamEslesen.kelime).classList.add('bulundu-satir');
    ks3Yol = [];
    if(ks3BulunanKelimeler.size === ks3KelimeListesi.length){
      document.getElementById('ks3Sonuc').textContent = '🎉 Tebrikler! Tüm kelimeleri at hamlesiyle buldun!';
    }
  } else if(onEkMi){
    yeniYol.forEach(p=>ks3HucreElemanlari[p.r][p.c].classList.add('ks-secili'));
    ks3Yol = yeniYol;
  } else {
    const tekBaslangicUygun = ks3KelimeListesi.some(item => !ks3BulunanKelimeler.has(item.kelime) && item.kelime[0]===ks3IzgaraVeri[r][c]);
    if(tekBaslangicUygun){ ks3Yol = [{r,c}]; hucreEl.classList.add('ks-secili'); }
    else { ks3Yol = []; }
  }
}

// =====================================================================
// KELİME DEDEKTİFİ
// =====================================================================
const dd3KelimeHavuzu = kelimeHavuzu3.filter(x => x.kelime.length>=5 && x.kelime.length<=8);
let dd3Hedef = null, dd3Deneme = 0;
const dd3MaxDeneme = 5, dd3IpucuAcilmaSiniri = 2;
let dd3Bitti = true, dd3SiraliVakalar = [], dd3VakaIndex = 0, dd3CozulenSayisi = 0;

function dd3Baslat(){
  dd3SiraliVakalar = karistir(dd3KelimeHavuzu.slice());
  dd3VakaIndex = 0; dd3CozulenSayisi = 0;
  document.getElementById('dd3Cozulen').textContent = 0;
  document.getElementById('dd3ToplamVaka').textContent = dd3SiraliVakalar.length;
  document.getElementById('dd3MaxDeneme').textContent = dd3MaxDeneme;
  dd3VakaBaslat();
}
function dd3VakaBaslat(){
  if(dd3VakaIndex >= dd3SiraliVakalar.length){
    document.getElementById('dd3Ipucu').textContent = '';
    document.getElementById('dd3Izgara').innerHTML = '';
    document.getElementById('dd3Girdi').disabled = true;
    document.getElementById('dd3Sonuc').textContent = `🏆 Tüm vakalar bitti! ${dd3CozulenSayisi}/${dd3SiraliVakalar.length} vakayı çözdün!`;
    return;
  }
  document.getElementById('dd3Vaka').textContent = dd3VakaIndex+1;
  dd3Hedef = dd3SiraliVakalar[dd3VakaIndex];
  dd3Deneme = 0; dd3Bitti = false;
  document.getElementById('dd3Ipucu').innerHTML = `🔍 Vaka: <b>${dd3Hedef.kelime.length} harfli</b> bir kavram (anlamı ${dd3IpucuAcilmaSiniri} yanlış tahminden sonra açılacak!)`;
  document.getElementById('dd3Deneme').textContent = 0;
  document.getElementById('dd3Izgara').innerHTML = '';
  document.getElementById('dd3Sonuc').textContent = '';
  document.getElementById('dd3Uyari').textContent = '';
  const girdi = document.getElementById('dd3Girdi');
  girdi.value = ''; girdi.disabled = false; girdi.maxLength = dd3Hedef.kelime.length; girdi.focus();
}
function dd3TahminEt(){
  if(dd3Bitti) return;
  const girdi = document.getElementById('dd3Girdi');
  const tahmin = girdi.value.trim().toLocaleUpperCase('tr-TR');
  if(tahmin.length !== dd3Hedef.kelime.length){
    document.getElementById('dd3Uyari').textContent = `Tahminin ${dd3Hedef.kelime.length} harfli olmalı!`;
    return;
  }
  document.getElementById('dd3Uyari').textContent = '';
  const hedefHarfler = dd3Hedef.kelime.split('');
  const tahminHarfler = tahmin.split('');
  const durumlar = new Array(tahminHarfler.length).fill('yok');
  const kullanilan = new Array(hedefHarfler.length).fill(false);
  tahminHarfler.forEach((h,i)=>{ if(h === hedefHarfler[i]){ durumlar[i]='dogru-yer'; kullanilan[i]=true; } });
  tahminHarfler.forEach((h,i)=>{
    if(durumlar[i]==='dogru-yer') return;
    const idx = hedefHarfler.findIndex((hh,j)=> hh===h && !kullanilan[j]);
    if(idx!==-1){ durumlar[i]='yanlis-yer'; kullanilan[idx]=true; }
  });
  const satir = document.createElement('div');
  satir.className = 'dd-satir';
  tahminHarfler.forEach((h,i)=>{
    const kutu = document.createElement('div');
    kutu.className = 'dd-kutu ' + durumlar[i];
    kutu.textContent = h;
    satir.appendChild(kutu);
  });
  document.getElementById('dd3Izgara').appendChild(satir);
  dd3Deneme++;
  document.getElementById('dd3Deneme').textContent = dd3Deneme;
  girdi.value = '';
  if(tahmin === dd3Hedef.kelime){
    dd3Bitti = true; girdi.disabled = true;
    dd3CozulenSayisi++;
    document.getElementById('dd3Cozulen').textContent = dd3CozulenSayisi;
    document.getElementById('dd3Ipucu').innerHTML = `🔍 İpucu: <b>${dd3Hedef.anlam}</b> (${dd3Hedef.kelime.length} harfli)`;
    document.getElementById('dd3Sonuc').textContent = `🎉 Vaka çözüldü! Kelime: ${dd3Hedef.kelime} (${dd3Deneme} denemede)`;
    dd3VakaIndex++;
    setTimeout(()=>dd3VakaBaslat(), 1500);
  } else if(dd3Deneme >= dd3MaxDeneme){
    dd3Bitti = true; girdi.disabled = true;
    document.getElementById('dd3Ipucu').innerHTML = `🔍 İpucu: <b>${dd3Hedef.anlam}</b> (${dd3Hedef.kelime.length} harfli)`;
    document.getElementById('dd3Sonuc').textContent = `🔍 Vaka çözülemedi! Doğru kelime: ${dd3Hedef.kelime} — ${dd3Hedef.anlam}`;
    dd3VakaIndex++;
    setTimeout(()=>dd3VakaBaslat(), 2200);
  } else if(dd3Deneme >= dd3IpucuAcilmaSiniri){
    document.getElementById('dd3Ipucu').innerHTML = `🔍 İpucu açıldı: <b>${dd3Hedef.anlam}</b> (${dd3Hedef.kelime.length} harfli)`;
  }
}

// =====================================================================
// DİL DEDEKTİFİ
// =====================================================================
const dilDedektifi3Listesi = [
  {dogru:"Kur'an-ı Kerim, Hz. Muhammed'e (sav) Cebrail (as) aracılığıyla vahyedilmiştir.", yanlislar:["Kur'an-ı Kerim, Hz. Muhammed'e (sav) rüyasında gelmiştir.","Kur'an-ı Kerim'i Hz. Muhammed (sav) kendisi yazmıştır.","Kur'an-ı Kerim başka bir peygambere indirilmiştir."]},
  {dogru:"Kur'an-ı Kerim 114 sureden oluşur.", yanlislar:["Kur'an-ı Kerim 30 sureden oluşur.","Kur'an-ı Kerim'de sure yoktur, sadece ayet vardır.","Kur'an-ı Kerim 7 sureden oluşur."]},
  {dogru:"Kur'an-ı Kerim'in ilk suresi Fatiha'dır.", yanlislar:["Kur'an-ı Kerim'in ilk suresi Bakara'dır.","Kur'an-ı Kerim'in ilk suresi İhlas'tır.","Kur'an-ı Kerim'in sure sırası yoktur."]},
  {dogru:"Kur'an-ı Kerim, indirildiği günden bu yana hiç değişmeden korunmuştur.", yanlislar:["Kur'an-ı Kerim zamanla değişikliğe uğramıştır.","Kur'an-ı Kerim'in sadece bir kısmı günümüze ulaşmıştır.","Kur'an-ı Kerim her yüzyılda yeniden yazılmıştır."]},
  {dogru:"Kur'an-ı Kerim'i tamamını ezberleyen kişiye hafız denir.", yanlislar:["Kur'an-ı Kerim'i okuyan herkese hafız denir.","Hafız, Kur'an'ı Arapça öğreten öğretmendir.","Hafız, camide görev yapan kişidir."]},
  {dogru:"Tecvit, Kur'an-ı Kerim'i doğru ve güzel okuma kurallarıdır.", yanlislar:["Tecvit, Kur'an'ı ezberleme yöntemidir.","Tecvit, Kur'an'ın başka dile çevrilmesidir.","Tecvit, Kur'an'ın yazılma şeklidir."]}
];
let ddl3Index = 0, ddl3Puan = 0, ddl3Sira = [];

function ddl3Baslat(){
  ddl3Sira = karistir(dilDedektifi3Listesi.slice());
  ddl3Index = 0; ddl3Puan = 0;
  document.getElementById('ddl3Puan').textContent = 0;
  document.getElementById('ddl3Toplam').textContent = ddl3Sira.length;
  document.getElementById('ddl3Sonuc').textContent = '';
  ddl3Tur();
}
function ddl3Tur(){
  if(ddl3Index >= ddl3Sira.length){
    document.getElementById('ddl3Secenekler').innerHTML = '';
    document.getElementById('ddl3Baslik').textContent = '';
    document.getElementById('ddl3Sonuc').textContent = `🕵️ Soruşturma bitti! ${ddl3Puan}/${ddl3Sira.length} doğru bilgiyi tespit ettin!`;
    return;
  }
  document.getElementById('ddl3Tur').textContent = ddl3Index+1;
  const oge = ddl3Sira[ddl3Index];
  document.getElementById('ddl3Baslik').textContent = '🔎 Hangi cümle DOĞRU bilgi veriyor?';
  const secenekler = karistir([{metin:oge.dogru, dogruMu:true}, ...oge.yanlislar.map(y=>({metin:y, dogruMu:false}))]);
  const kutu = document.getElementById('ddl3Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = secenek.metin;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      tiklandiMi = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(secenek.dogruMu){
        btn.classList.add('dogru');
        ddl3Puan++;
        document.getElementById('ddl3Puan').textContent = ddl3Puan;
      } else {
        btn.classList.add('yanlis');
        tumBtn.forEach(b=>{ if(b.textContent === oge.dogru) b.classList.add('dogru'); });
      }
      ddl3Index++;
      setTimeout(()=>ddl3Tur(), 1200);
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// MANTIK ZİNCİRİ
// =====================================================================
const mantikZinciri3 = [
  {kavram:"VAHİY", tanim:"Allah'ın (cc) peygamberlerine bildirdiği ilahi mesaj", mantik:"Kur'an'ın cümle veya cümle grubu hâlindeki en küçük bölümüne ne denir?"},
  {kavram:"AYET", tanim:"Kur'an-ı Kerim'in cümle veya cümle grubu hâlindeki en küçük bölümü", mantik:"Ayetlerden oluşan bölümlere ne denir?"},
  {kavram:"SURE", tanim:"Kur'an-ı Kerim'in ayetlerden oluşan bölümlerinden her biri", mantik:"Kur'an'ın tamamını ezberleyen kişiye ne denir?"},
  {kavram:"HAFIZ", tanim:"Kur'an-ı Kerim'in tamamını ezberleyen kişi", mantik:"Kur'an'ı doğru ve güzel okuma kurallarına ne denir?"},
  {kavram:"TECVİT", tanim:"Kur'an-ı Kerim'i doğru ve güzel okuma kuralları", mantik:""}
];
let mz3Index = 0;

function mz3Baslat(){
  mz3Index = 0;
  document.getElementById('mz3Toplam').textContent = mantikZinciri3.length;
  document.getElementById('mz3Sonuc').textContent = '';
  document.getElementById('mz3Gorsel').innerHTML = '';
  mz3HalkaEkle(mantikZinciri3[0].kavram, 0);
  mz3Tur();
}
function mz3HalkaEkle(kavram, index){
  const halka = document.createElement('div');
  halka.style.background='white'; halka.style.border='2px solid var(--yesil)'; halka.style.borderRadius='10px';
  halka.style.padding='8px 14px'; halka.style.margin='6px 0'; halka.style.fontWeight='bold';
  halka.style.marginLeft = (index*24) + 'px';
  halka.textContent = `${index+1}. ${kavram}`;
  document.getElementById('mz3Gorsel').appendChild(halka);
}
function mz3Tur(){
  document.getElementById('mz3Halka').textContent = mz3Index+1;
  if(mz3Index+1 >= mantikZinciri3.length){
    document.getElementById('mz3Soru').textContent = '';
    document.getElementById('mz3Secenekler').innerHTML = '';
    document.getElementById('mz3Sonuc').textContent = '🎉 Tebrikler! Mantık zincirini tamamen çözdün!';
    return;
  }
  const mevcut = mantikZinciri3[mz3Index];
  const hedef = mantikZinciri3[mz3Index+1];
  document.getElementById('mz3Soru').innerHTML = `🔗 <b>${mevcut.kavram}</b>: ${mevcut.tanim}<br>❓ ${mevcut.mantik}`;
  const havuzDistractor = karistir(kelimeHavuzu3.filter(x => x.kelime!==hedef.kavram && !mantikZinciri3.some(z=>z.kavram===x.kelime))).slice(0,3);
  const secenekler = karistir([{kelime:hedef.kavram}, ...havuzDistractor]);
  const kutu = document.getElementById('mz3Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = secenek.kelime;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      if(secenek.kelime === hedef.kavram){
        tiklandiMi = true;
        btn.classList.add('dogru');
        mz3Index++;
        setTimeout(()=>{ mz3HalkaEkle(hedef.kavram, mz3Index); mz3Tur(); }, 700);
      } else {
        btn.classList.add('yanlis');
        setTimeout(()=>btn.classList.remove('yanlis'), 400);
      }
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// SEMANTİK LABİRENT
// =====================================================================
const semantikOdalar3 = [
  {kategori:"KUR'AN'IN BÖLÜMLERİ", kelimeler:["AYET","SURE","CÜZ","HAFIZ"], oddKelime:"HAFIZ"},
  {kategori:"KUR'AN İLE İLGİLİ MESLEK/GÖREVLER", kelimeler:["HAFIZ","MÜFESSİR","KARİ","NUR"], oddKelime:"NUR"},
  {kategori:"KUR'AN'IN ÖZELLİKLERİ", kelimeler:["RAHMET","ŞİFA","HİDAYET","MEAL"], oddKelime:"MEAL"},
  {kategori:"KUR'AN OKUMA/ANLAMA KAVRAMLARI", kelimeler:["TECVİT","TEFSİR","MEAL","KADİR"], oddKelime:"KADİR"}
];
let sz3OdaIndex = 0, sz3Can = 3;

function sz3CanGoster(){ document.getElementById('sz3Can').textContent = '❤️'.repeat(Math.max(sz3Can,0)) + '🖤'.repeat(Math.max(3-sz3Can,0)); }
function sz3Baslat(){
  sz3OdaIndex = 0; sz3Can = 3;
  document.getElementById('sz3ToplamOda').textContent = semantikOdalar3.length;
  sz3CanGoster();
  document.getElementById('sz3Sonuc').textContent = '';
  sz3OdaGoster();
}
function sz3OdaGoster(){
  document.getElementById('sz3Oda').textContent = sz3OdaIndex+1;
  const oda = semantikOdalar3[sz3OdaIndex];
  document.getElementById('sz3Kategori').innerHTML = `🚪 Oda ${sz3OdaIndex+1}: Bu kategoriye AİT OLMAYAN kelimeyi bul, kapıyı aç!<br>📂 Kategori: <b>${oda.kategori}</b>`;
  const kutu = document.getElementById('sz3Secenekler');
  kutu.innerHTML = '';
  const karisikKelimeler = karistir(oda.kelimeler.slice());
  karisikKelimeler.forEach(kelime=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = kelime;
    btn.onclick = ()=>{
      if(kelime === oda.oddKelime){
        btn.classList.add('dogru');
        sz3OdaIndex++;
        setTimeout(()=>{
          if(sz3OdaIndex >= semantikOdalar3.length){
            document.getElementById('sz3Kategori').textContent = '';
            document.getElementById('sz3Secenekler').innerHTML = '';
            document.getElementById('sz3Sonuc').textContent = '🎉 Tebrikler! Semantik labirentten çıktın!';
          } else { sz3OdaGoster(); }
        }, 700);
      } else {
        btn.classList.add('yanlis');
        sz3Can--;
        sz3CanGoster();
        if(sz3Can<=0){
          setTimeout(()=>{
            sz3OdaIndex = 0; sz3Can = 3;
            sz3CanGoster();
            document.getElementById('sz3Sonuc').textContent = '💥 Canların bitti, labirentte kayboldun! Baştan başlıyorsun...';
            setTimeout(()=>{ document.getElementById('sz3Sonuc').textContent=''; sz3OdaGoster(); }, 1500);
          }, 500);
        } else {
          setTimeout(()=>btn.classList.remove('yanlis'), 400);
        }
      }
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// ÇELİŞKİ AVI
// =====================================================================
const celiskiListesi3 = [
  {kelime:"Hafız", anlam1:"Kur'an'ın tamamını ezberleyen kişi", anlam2:"Kur'an'ı sadece okuyabilen kişi", celiskiVarMi:true},
  {kelime:"Tefsir", anlam1:"Ayetlerin anlamını açıklama ilmi", anlam2:"Kur'an ayetlerinin anlamını açıklama ilmi", celiskiVarMi:false},
  {kelime:"Meal", anlam1:"Kur'an'ın başka dile çevrilmiş anlamı", anlam2:"Kur'an'ın Arapça aslı", celiskiVarMi:true},
  {kelime:"Sure", anlam1:"Kur'an'ın ayetlerden oluşan bölümü", anlam2:"Kur'an'ın ayetlerden oluşan bölümlerinden biri", celiskiVarMi:false},
  {kelime:"Vahiy", anlam1:"Allah'ın (cc) peygamberlere bildirdiği mesaj", anlam2:"Peygamberlerin kendi düşünceleri", celiskiVarMi:true},
  {kelime:"Hatim", anlam1:"Kur'an'ı baştan sona okuyup bitirmek", anlam2:"Kur'an'ı başından sonuna kadar okumak", celiskiVarMi:false}
];
let ca3Index = 0, ca3Puan = 0, ca3Sira = [], ca3Kilit = false;

function ca3Baslat(){
  ca3Sira = karistir(celiskiListesi3.slice());
  ca3Index = 0; ca3Puan = 0;
  document.getElementById('ca3Puan').textContent = 0;
  document.getElementById('ca3Toplam').textContent = ca3Sira.length;
  document.getElementById('ca3Sonuc').textContent = '';
  document.getElementById('ca3Butonlar').style.display = 'flex';
  ca3Tur();
}
function ca3Tur(){
  if(ca3Index >= ca3Sira.length){
    document.getElementById('ca3Cumle').textContent = '';
    document.getElementById('ca3Butonlar').style.display = 'none';
    document.getElementById('ca3GeriBildirim').textContent = '';
    document.getElementById('ca3Sonuc').textContent = `🕵️ Avın bitti! ${ca3Puan}/${ca3Sira.length} çelişkiyi doğru tespit ettin!`;
    return;
  }
  document.getElementById('ca3Tur').textContent = ca3Index+1;
  const oge = ca3Sira[ca3Index];
  document.getElementById('ca3Cumle').innerHTML = `"<b>${oge.kelime}</b>" hem "${oge.anlam1}" hem de "${oge.anlam2}" demektir.`;
  document.getElementById('ca3GeriBildirim').textContent = '';
  ca3Kilit = false;
}
function ca3Cevapla(cevapVarMi){
  if(ca3Kilit) return;
  ca3Kilit = true;
  const oge = ca3Sira[ca3Index];
  const dogruMu = (cevapVarMi === oge.celiskiVarMi);
  if(dogruMu){
    ca3Puan++;
    document.getElementById('ca3Puan').textContent = ca3Puan;
    document.getElementById('ca3GeriBildirim').textContent = '✅ Doğru!';
  } else {
    document.getElementById('ca3GeriBildirim').textContent = `❌ Yanlış! Doğrusu: ${oge.celiskiVarMi ? 'Çelişki VAR' : 'Çelişki YOK'}`;
  }
  ca3Index++;
  setTimeout(()=>ca3Tur(), 1300);
}

// =====================================================================
// LABİRENT
// =====================================================================
const lab3Satir = 12, lab3Sutun = 15;
const lab3IfadeHavuzu = [
  {kelime:"VAHİY", anlam:"Allah'ın (cc) peygamberlerine bildirdiği ilahi mesaj"},
  {kelime:"AYET", anlam:"Kur'an-ı Kerim'in cümle veya cümle grubu hâlindeki en küçük bölümü"},
  {kelime:"SURE", anlam:"Kur'an-ı Kerim'in ayetlerden oluşan bölümlerinden her biri"},
  {kelime:"CÜZ", anlam:"Kur'an-ı Kerim'in otuza bölünmüş parçalarından her biri"},
  {kelime:"HAFIZ", anlam:"Kur'an-ı Kerim'in tamamını ezberleyen kişi"},
  {kelime:"TECVİT", anlam:"Kur'an-ı Kerim'i doğru ve güzel okuma kuralları"},
  {kelime:"MUSHAF", anlam:"Kur'an-ı Kerim'in yazılı hâldeki kitabı"},
  {kelime:"NÜZUL", anlam:"Kur'an'ın Hz. Muhammed'e (sav) indirilmesi"},
  {kelime:"KIRAAT", anlam:"Kur'an-ı Kerim'i okuma biçimi"},
  {kelime:"TEFSİR", anlam:"Kur'an ayetlerinin anlamını açıklama ilmi"},
  {kelime:"MEAL", anlam:"Kur'an'ın başka bir dile yapılan anlam çevirisi"},
  {kelime:"HATİM", anlam:"Kur'an-ı Kerim'i baştan sona okuyup bitirme"},
  {kelime:"CEBRAİL", anlam:"Vahyi peygamberlere getiren melek"},
  {kelime:"KADİR", anlam:"Kur'an'ın indirilmeye başladığı, bin aydan hayırlı gece"},
  {kelime:"FATİHA", anlam:"Kur'an-ı Kerim'in ilk suresi"},
  {kelime:"BESMELE", anlam:"'Bismillahirrahmanirrahim' sözü"},
  {kelime:"HİDAYET", anlam:"Doğru yolu bulma, Kur'an'ın insanlara sunduğu rehberlik"},
  {kelime:"ŞİFA", anlam:"Kur'an'ın kalplere derman olması"},
  {kelime:"RAHMET", anlam:"Allah'ın (cc) sonsuz merhameti, Kur'an'ın bir özelliği"},
  {kelime:"NUR", anlam:"Işık, Kur'an'ın insanlara yol gösteren bir özelliği"},
  {kelime:"FURKAN", anlam:"Hakkı batıldan ayıran, Kur'an'ın bir ismi"},
  {kelime:"KELAMULLAH", anlam:"Allah'ın (cc) sözü, Kur'an'ın bir ismi"},
  {kelime:"MEKKİ", anlam:"Hicretten önce Mekke'de indirilen ayet ve sureler"},
  {kelime:"MEDENİ", anlam:"Hicretten sonra Medine'de indirilen ayet ve sureler"},
  {kelime:"ARAPÇA", anlam:"Kur'an-ı Kerim'in indirildiği dil"},
  {kelime:"KORUNMUŞLUK", anlam:"Kur'an'ın günümüze kadar değişmeden ulaşması özelliği"},
  {kelime:"İCAZ", anlam:"Kur'an'ın eşsiz ve benzersiz oluşu"}
];
let lab3Hucreler = [], lab3HucreElemanlari = [], lab3OyuncuKonum = {r:0,c:0}, lab3Toplananlar = {};
let lab3HamleSayisi = 0, lab3ToplananSayisi = 0, lab3Saniye = 0, lab3Zamanlayici = null, lab3Bitti = false;

function lab3Uret(){
  const hucreler = [];
  for(let r=0;r<lab3Satir;r++){
    hucreler.push([]);
    for(let c=0;c<lab3Sutun;c++){ hucreler[r].push({top:true,right:true,bottom:true,left:true,ziyaretEdildi:false}); }
  }
  const yigin = [{r:0,c:0}];
  hucreler[0][0].ziyaretEdildi = true;
  while(yigin.length>0){
    const mevcut = yigin[yigin.length-1];
    const {r,c} = mevcut;
    const komsular = [];
    if(r>0 && !hucreler[r-1][c].ziyaretEdildi) komsular.push({r:r-1,c,yon:'top'});
    if(c<lab3Sutun-1 && !hucreler[r][c+1].ziyaretEdildi) komsular.push({r,c:c+1,yon:'right'});
    if(r<lab3Satir-1 && !hucreler[r+1][c].ziyaretEdildi) komsular.push({r:r+1,c,yon:'bottom'});
    if(c>0 && !hucreler[r][c-1].ziyaretEdildi) komsular.push({r,c:c-1,yon:'left'});
    if(komsular.length===0){ yigin.pop(); }
    else {
      const secilen = komsular[Math.floor(Math.random()*komsular.length)];
      if(secilen.yon==='top'){ hucreler[r][c].top=false; hucreler[secilen.r][secilen.c].bottom=false; }
      if(secilen.yon==='right'){ hucreler[r][c].right=false; hucreler[secilen.r][secilen.c].left=false; }
      if(secilen.yon==='bottom'){ hucreler[r][c].bottom=false; hucreler[secilen.r][secilen.c].top=false; }
      if(secilen.yon==='left'){ hucreler[r][c].left=false; hucreler[secilen.r][secilen.c].right=false; }
      hucreler[secilen.r][secilen.c].ziyaretEdildi = true;
      yigin.push({r:secilen.r,c:secilen.c});
    }
  }
  return hucreler;
}
function labirent3Baslat(){
  clearInterval(lab3Zamanlayici);
  lab3Hucreler = lab3Uret();
  lab3OyuncuKonum = {r:0,c:0};
  lab3HamleSayisi = 0; lab3ToplananSayisi = 0; lab3Saniye = 0; lab3Bitti = false;
  document.getElementById('lab3Hamle').textContent = 0;
  document.getElementById('lab3Toplanan').textContent = 0;
  document.getElementById('lab3Sure').textContent = 0;
  document.getElementById('lab3Durum').textContent = '';
  document.getElementById('lab3Sonuc').textContent = '';
  const tumHucreler = [];
  for(let r=0;r<lab3Satir;r++) for(let c=0;c<lab3Sutun;c++){
    if(!(r===0&&c===0) && !(r===lab3Satir-1&&c===lab3Sutun-1)) tumHucreler.push({r,c});
  }
  const secilenler = karistir(tumHucreler).slice(0, lab3IfadeHavuzu.length);
  lab3Toplananlar = {};
  secilenler.forEach((konum, i)=>{
    lab3Toplananlar[konum.r+','+konum.c] = {kelime: lab3IfadeHavuzu[i].kelime, anlam: lab3IfadeHavuzu[i].anlam, toplandi:false};
  });
  document.getElementById('lab3ToplamYildiz').textContent = secilenler.length;
  const izgara = document.getElementById('lab3Izgara');
  izgara.innerHTML = '';
  izgara.style.gridTemplateColumns = `repeat(${lab3Sutun}, 30px)`;
  izgara.style.gridTemplateRows = `repeat(${lab3Satir}, 30px)`;
  lab3HucreElemanlari = [];
  for(let r=0;r<lab3Satir;r++){
    lab3HucreElemanlari.push([]);
    for(let c=0;c<lab3Sutun;c++){
      const h = lab3Hucreler[r][c];
      const div = document.createElement('div');
      div.className = 'labirent-hucre';
      div.style.gridColumn = c+1;
      div.style.gridRow = r+1;
      div.style.borderTop = h.top ? '2px solid #333' : '2px solid transparent';
      div.style.borderRight = h.right ? '2px solid #333' : '2px solid transparent';
      div.style.borderBottom = h.bottom ? '2px solid #333' : '2px solid transparent';
      div.style.borderLeft = h.left ? '2px solid #333' : '2px solid transparent';
      const key = r+','+c;
      if(r===0 && c===0) div.textContent = '🚶';
      else if(r===lab3Satir-1 && c===lab3Sutun-1) div.textContent = '🕌';
      else if(lab3Toplananlar[key]) div.textContent = '⭐';
      izgara.appendChild(div);
      lab3HucreElemanlari[r].push(div);
    }
  }
  lab3Zamanlayici = setInterval(()=>{
    lab3Saniye++;
    document.getElementById('lab3Sure').textContent = lab3Saniye;
  }, 1000);
}
function labirent3Hareket(dr, dc){
  if(lab3Bitti) return;
  const {r,c} = lab3OyuncuKonum;
  const hucre = lab3Hucreler[r][c];
  let yeniR=r, yeniC=c;
  if(dr===-1 && !hucre.top) yeniR = r-1;
  else if(dr===1 && !hucre.bottom) yeniR = r+1;
  else if(dc===-1 && !hucre.left) yeniC = c-1;
  else if(dc===1 && !hucre.right) yeniC = c+1;
  else return;
  lab3HucreElemanlari[r][c].textContent = '';
  lab3OyuncuKonum = {r:yeniR, c:yeniC};
  lab3HamleSayisi++;
  document.getElementById('lab3Hamle').textContent = lab3HamleSayisi;
  const key = yeniR+','+yeniC;
  if(lab3Toplananlar[key] && !lab3Toplananlar[key].toplandi){
    lab3Toplananlar[key].toplandi = true;
    lab3ToplananSayisi++;
    document.getElementById('lab3Toplanan').textContent = lab3ToplananSayisi;
    document.getElementById('lab3Durum').textContent = `✨ Topladın: ${lab3Toplananlar[key].kelime} — ${lab3Toplananlar[key].anlam}`;
  }
  if(yeniR===lab3Satir-1 && yeniC===lab3Sutun-1){
    lab3HucreElemanlari[yeniR][yeniC].textContent = '🏁';
    lab3Bitti = true;
    clearInterval(lab3Zamanlayici);
    const toplamYildiz = document.getElementById('lab3ToplamYildiz').textContent;
    document.getElementById('lab3Sonuc').textContent =
      `🎉 Tebrikler! Labirenti ${lab3HamleSayisi} hamlede ve ${lab3Saniye} saniyede tamamladın! (${lab3ToplananSayisi}/${toplamYildiz} yıldız topladın)`;
    return;
  }
  lab3HucreElemanlari[yeniR][yeniC].textContent = '🚶';
}
document.addEventListener('keydown', (e)=>{
  const aktifBolum = document.getElementById('labirent3');
  if(!aktifBolum.classList.contains('aktif')) return;
  const etiket = document.activeElement ? document.activeElement.tagName : '';
  if(etiket==='INPUT' || etiket==='TEXTAREA') return;
  if(e.key==='ArrowUp'){ e.preventDefault(); labirent3Hareket(-1,0); }
  else if(e.key==='ArrowDown'){ e.preventDefault(); labirent3Hareket(1,0); }
  else if(e.key==='ArrowLeft'){ e.preventDefault(); labirent3Hareket(0,-1); }
  else if(e.key==='ArrowRight'){ e.preventDefault(); labirent3Hareket(0,1); }
});

