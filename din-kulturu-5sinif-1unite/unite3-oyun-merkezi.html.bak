/* ===================== PEDAGOJIK YAPI: giris / amac / ozet + yeni kutu tipleri ===================== */
.ko-giris{ font-size:1.06em; font-style:italic; color:var(--mavi); margin:0 0 12px; padding:2px 0 2px 14px; border-left:3px solid var(--acik); line-height:1.5; }
