const ezberVeri3 = [
  {parca:"Elif Lâm Mîm.", anlam:"Bazı surelerin başında yer alan, anlamı Allah (cc) katında bilinen harfler.", gizli:"Elif Lâm Mîm."},
  {parca:"Bu, kendisinde şüphe olmayan bir kitaptır.", anlam:"Kur'an'ın hak ve kesin bir kitap olduğu vurgulanır.", gizli:"kendisinde şüphe olmayan bir kitaptır"},
  {parca:"Takva sahipleri için bir yol göstericidir.", anlam:"Kur'an'ın hidayet kaynağı olduğu belirtilir.", gizli:"takva sahipleri için bir yol göstericidir"},
  {parca:"Kur'an'ı biz indirdik, onu koruyacak olan da biziz.", anlam:"Kur'an'ın Allah (cc) tarafından korunduğu vurgulanır.", gizli:"onu koruyacak olan da biziz"},
  {parca:"Ramazan ayı, insanlara yol gösterici olarak Kur'an'ın indirildiği aydır.", anlam:"Kur'an'ın Ramazan ayında indirilmeye başladığı belirtilir.", gizli:"Kur'an'ın indirildiği aydır"},
  {parca:"Sizden hanginizin daha güzel amel edeceğini sınamak için yarattı.", anlam:"Yaratılışın imtihan amacı taşıdığı vurgulanır.", gizli:"daha güzel amel edeceğini sınamak"},
  {parca:"De ki: O Allah bir tektir.", anlam:"İhlas suresinin tevhit vurgusu.", gizli:"O Allah bir tektir"},
  {parca:"Kur'an okuduğun zaman kovulmuş şeytandan Allah'a sığın.", anlam:"Kur'an okumaya besmele ve euzü ile başlanması öğütlenir.", gizli:"kovulmuş şeytandan Allah'a sığın"},
  {parca:"Andolsun, Kur'an'ı öğüt alınsın diye kolaylaştırdık.", anlam:"Kur'an'ın anlaşılır kılındığı vurgulanır.", gizli:"öğüt alınsın diye kolaylaştırdık"},
  {parca:"Kur'an'la amel eden kurtulur, ondan yüz çeviren pişman olur.", anlam:"Kur'an'a uymanın önemi vurgulanır.", gizli:"amel eden kurtulur"}
];

