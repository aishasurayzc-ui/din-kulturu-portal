.s-zg-merak .zg-slayt-ust{ color:#7c3aed; }
.s-zg-soru .zg-slayt-ust{ color:#c9740b; }
.s-zg-hayat .zg-slayt-ust{ color:#40916c; }
.zg-slayt-metin{ font-size:1.15em; line-height:1.55; max-width:640px; }


/* ===================== OGRETMEN PANELI ===================== */
.op-baglanti-satiri{ text-align:center; padding:6px; background:#f1f5f9; }
.op-baglanti-satiri a{ color:#64748b; font-size:.8em; text-decoration:none; cursor:pointer; }
.op-baglanti-satiri a:hover{ text-decoration:underline; }
.op-tablo{ width:100%; border-collapse:collapse; margin:16px 0; font-size:.92em; }
.op-tablo th{ background:var(--navy); color:#fff; padding:8px 10px; text-align:left; }
.op-tablo td{ padding:8px 10px; border-bottom:1px solid #e2e8f0; }
.op-tablo tr:nth-child(4n+1){ background:#f8fafc; }
.op-detay-btn{ background:var(--mavi); color:#fff; border:none; padding:4px 12px; border-radius:12px; cursor:pointer; font-size:.85em; }
.op-detay-satir td{ background:#eef2f7; font-size:.88em; }
#ogretmenpaneli .aciklama{ margin-bottom:14px; }


/* ===================== DOGRU CEVAPTA YILDIZ + KONFETI PATLAMASI ===================== */
.dogru{ position:relative; overflow:visible !important; }
.dogru::before{
  content:'⭐';
  position:absolute; top:50%; left:-4px; font-size:1.5em;
  animation: dogruPatlamaSol .9s ease-out forwards;
  pointer-events:none; z-index:5;
}
.dogru::after{
  content:'🎊';
  position:absolute; top:50%; right:-4px; font-size:1.5em;
  animation: dogruPatlamaSag .9s ease-out forwards;
  pointer-events:none; z-index:5;
}
@keyframes dogruPatlamaSol{
  0%{ opacity:0; transform:translate(0,-50%) scale(0) rotate(0deg); }
  25%{ opacity:1; transform:translate(-10px,-70%) scale(1.4) rotate(-20deg); }
  100%{ opacity:0; transform:translate(-32px,-125%) scale(1.1) rotate(-60deg); }
}
@keyframes dogruPatlamaSag{
  0%{ opacity:0; transform:translate(0,-50%) scale(0) rotate(0deg); }
  25%{ opacity:1; transform:translate(10px,-70%) scale(1.4) rotate(20deg); }
  100%{ opacity:0; transform:translate(32px,-125%) scale(1.1) rotate(60deg); }
}


/* ===================== OZEL MODAL / BILDIRIM (alert-confirm yerine) ===================== */
.ozel-modal-arka{ position:fixed; inset:0; background:rgba(0,0,0,.5); display:flex; align-items:center; justify-content:center; z-index:1000; padding:20px; }
.ozel-modal-kutu{ background:#fff; border-radius:16px; padding:24px; max-width:360px; text-align:center; box-shadow:0 10px 30px rgba(0,0,0,.35); animation:ozelModalGir .2s ease; }
@keyframes ozelModalGir{ from{opacity:0; transform:scale(.9);} to{opacity:1; transform:scale(1);} }
.ozel-modal-mesaj{ margin:0 0 18px; font-size:1.05em; line-height:1.4; }
.ozel-modal-btn{ padding:10px 20px; border:none; border-radius:20px; font-weight:bold; cursor:pointer; margin:0 6px; font-size:.95em; }
.ozel-toast{ position:fixed; bottom:24px; left:50%; transform:translateX(-50%); background:#22333b; color:#fff; padding:14px 22px; border-radius:24px; box-shadow:0 6px 20px rgba(0,0,0,.3); z-index:1000; animation:ozelToastGir .3s ease; font-weight:bold; max-width:80vw; text-align:center; }
@keyframes ozelToastGir{ from{opacity:0; transform:translateX(-50%) translateY(20px);} to{opacity:1; transform:translateX(-50%) translateY(0);} }


/* ===================== 6 BOLUMLU ZENGINLESTIRME (Konu Ozeti) ===================== */
.zb-kutu{ border-radius:12px; padding:16px 18px; margin:16px 0; box-shadow:0 3px 10px rgba(0,0,0,.08); }
