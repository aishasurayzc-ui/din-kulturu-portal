  setTimeout(()=>{
    document.getElementById('ez72Metin').textContent = '🙈 ...';
    const digerIdx = karistir(ezberVeri2.map((_,j)=>j).filter(j=>j!==i)).slice(0,2);
    const varyantlar = digerIdx.map(j=>oge.parca.replace(oge.gizli, ezberVeri2[j].gizli));
    const secenekler = karistir([oge.parca, ...varyantlar]);
    const kutu = document.getElementById('ez72Secenekler');
    kutu.innerHTML='';
    secenekler.forEach(sec=>{
      const btn=document.createElement('div');
      btn.className='merdiven-secenek';
      btn.textContent=sec;
      btn.onclick=()=>{
        document.querySelectorAll('#ez72Secenekler .merdiven-secenek').forEach(b=>b.onclick=null);
        document.getElementById('ez72Metin').textContent = oge.parca;
        if(sec===oge.parca){ btn.classList.add('dogru'); ez72Dogru++; document.getElementById('ez72Dogru').textContent=ez72Dogru; }
        else {
          btn.classList.add('yanlis');
          [...kutu.children].find(b=>b.textContent===oge.parca).classList.add('dogru');
        }
        setTimeout(()=>{ ez72Tur++; ez72Round(); }, 1300);
      };
      kutu.appendChild(btn);
    });
  }, 3000);
}

// --- 8) HIZ TESTİ ---
let ez82Zamanlayici=null, ez82Kalan=60, ez82Dogru=0, ez82Yanlis=0, ez82Aktif=false;
function ez82Baslat(){
  clearInterval(ez82Zamanlayici);
  ez82Kalan=60; ez82Dogru=0; ez82Yanlis=0; ez82Aktif=true;
  document.getElementById('ez82Sayac').textContent=ez82Kalan;
  document.getElementById('ez82Dogru').textContent='0';
  document.getElementById('ez82Yanlis').textContent='0';
  document.getElementById('ez82Sonuc').textContent='';
  ez82Zamanlayici = setInterval(()=>{
    ez82Kalan--;
    document.getElementById('ez82Sayac').textContent=ez82Kalan;
    if(ez82Kalan<=0){ ez82Bitir(); }
  }, 1000);
  ez82SoruGoster();
}
function ez82SoruGoster(){
  if(!ez82Aktif) return;
  const i = Math.floor(Math.random()*ezberVeri2.length);
  const oge = ezberVeri2[i];
  document.getElementById('ez82Metin').textContent = oge.anlam;
  const digerleri = ezberVeri2.filter((_,j)=>j!==i).map(x=>x.parca);
  const secenekler = karistir([oge.parca, ...karistir(digerleri).slice(0,3)]);
  const kutu = document.getElementById('ez82Secenekler');
  kutu.innerHTML='';
  secenekler.forEach(sec=>{
    const btn=document.createElement('div');
    btn.className='merdiven-secenek';
    btn.textContent=sec;
    btn.onclick=()=>{
      if(!ez82Aktif) return;
      if(sec===oge.parca){ ez82Dogru++; document.getElementById('ez82Dogru').textContent=ez82Dogru; }
      else { ez82Yanlis++; document.getElementById('ez82Yanlis').textContent=ez82Yanlis; }
      ez82SoruGoster();
    };
    kutu.appendChild(btn);
  });
}
function ez82Bitir(){
  ez82Aktif=false;
  clearInterval(ez82Zamanlayici);
  document.getElementById('ez82Secenekler').innerHTML='';
  document.getElementById('ez82Metin').textContent='';
  const basari = ez82Dogru>=8 ? '🏆 Efsane Hız!' : ez82Dogru>=5 ? '🥇 Çok İyi!' : '📚 Biraz Daha Pratik!';
  document.getElementById('ez82Sonuc').innerHTML = `🎉 Süre bitti! ${basari}<br>${ez82Dogru} doğru, ${ez82Yanlis} yanlış.`;
}

// ===================== SUNUM (SLAYT) GORUNUMU JS =====================
window.sunumDurumu = window.sunumDurumu || {};
function sunumNoktalariOlustur(suf){
  const alan = document.getElementById('sunumAlan'+suf);
  const nokta = document.getElementById('sunumNoktalar'+suf);
  if(!alan || !nokta) return;
  const toplam = alan.querySelectorAll('.sunum-slayt').length;
  nokta.innerHTML = '';
  for(let i=0;i<toplam;i++){
    const d = document.createElement('span');
    d.className = 'sunum-nokta' + (i===0?' aktif':'');
    d.onclick = function(){ sunumIndexeGit(suf, i); };
    nokta.appendChild(d);
  }
}
function sunumGuncelle(suf){
  const alan = document.getElementById('sunumAlan'+suf);
  if(!alan) return;
  const slaytlar = alan.querySelectorAll('.sunum-slayt');
  const idx = sunumDurumu[suf] || 0;
  slaytlar.forEach(function(s,i){ s.classList.toggle('aktif', i===idx); });
  const sayac = document.getElementById('sunumSayac'+suf);
  if(sayac) sayac.textContent = (idx+1)+' / '+slaytlar.length;
  document.querySelectorAll('#sunumNoktalar'+suf+' .sunum-nokta').forEach(function(n,i){ n.classList.toggle('aktif', i===idx); });
}
function sunumIndexeGit(suf, i){
  sunumDurumu[suf] = i;
  sunumGuncelle(suf);
}
function sunumGit(suf, yon){
  const alan = document.getElementById('sunumAlan'+suf);
  if(!alan) return;
  const toplam = alan.querySelectorAll('.sunum-slayt').length;
  let idx = (sunumDurumu[suf]||0) + yon;
  if(idx<0) idx=0;
  if(idx>=toplam) idx=toplam-1;
  sunumIndexeGit(suf, idx);
}
function sunumTamEkran(suf){
  const alan = document.getElementById('sunumAlan'+suf);
  if(!alan) return;
  if(alan.requestFullscreen) alan.requestFullscreen();
  else if(alan.webkitRequestFullscreen) alan.webkitRequestFullscreen();
}
document.addEventListener('keydown', function(e){
  const slaytBolumu = document.getElementById('slayt');
  if(!slaytBolumu || !slaytBolumu.classList.contains('aktif')) return;
  if(e.key === 'ArrowRight') sunumGit('', 1);
  if(e.key === 'ArrowLeft') sunumGit('', -1);
});
document.addEventListener('DOMContentLoaded', function(){ sunumNoktalariOlustur(''); sunumGuncelle(''); });


const UNITE_KIMLIK = '5-2';

// ===================== OGRENCI KIMLIGI VE OGRETMEN PANELI =====================
const OP_ANAHTAR = 'dkabOgretmenPaneli_' + (typeof UNITE_KIMLIK !== 'undefined' ? UNITE_KIMLIK : location.pathname);

function opOgrenciAdi(){
  let ad = sessionStorage.getItem('dkabAktifOgrenci');
  if(!ad){
    ad = prompt('Merhaba! Öğretmenin ilerlemeni takip edebilmesi için adını ve soyadını yazar mısın?');
    if(!ad || !ad.trim()) ad = 'İsimsiz Öğrenci';
    ad = ad.trim().slice(0,40);
    sessionStorage.setItem('dkabAktifOgrenci', ad);
  }
  return ad;
}
function opOgrenciDegistir(){
  sessionStorage.removeItem('dkabAktifOgrenci');
  ozelBildirim('Öğrenci bilgisi sıfırlandı. Bir sonraki oyun tamamlandığında yeni isim sorulacak.');
}
function opVerileriOku(){
  try{ return JSON.parse(localStorage.getItem(OP_ANAHTAR)) || {}; }catch(e){ return {}; }
}
function opVerileriYaz(v){
  try{ localStorage.setItem(OP_ANAHTAR, JSON.stringify(v)); }catch(e){}
}
function opOgrenciKaydiGetir(v, ad){
  if(!v[ad]) v[ad] = {oyunlar:[], sonPuan:0, sonRozetler:[], ilkTarih:new Date().toLocaleString('tr-TR')};
  return v[ad];
}
function opOyunTamamlandiKaydet(bolumId, toplamPuan, rozetler){
  const ad = opOgrenciAdi();
  const v = opVerileriOku();
  const kayit = opOgrenciKaydiGetir(v, ad);
  kayit.oyunlar.push({bolum: bolumId || 'bilinmiyor', tarih: new Date().toLocaleString('tr-TR')});
  kayit.sonPuan = toplamPuan;
  kayit.sonRozetler = rozetler || [];
  opVerileriYaz(v);
}

const OP_SIFRE = 'ogretmen2026';
let opGirisYapildi = false;

function opGirisKontrol(){
  if(opGirisYapildi){ opPaneliGoster(); return; }
  const girilen = prompt('Öğretmen paneline erişim için şifreyi girin:');
  if(girilen === OP_SIFRE){
    opGirisYapildi = true;
    opPaneliGoster();
  } else if(girilen !== null){
    ozelBildirim('Şifre yanlış.');
    document.getElementById('opGirisEkrani').style.display = 'block';
    document.getElementById('opPanelEkrani').style.display = 'none';
  }
}

function opPaneliGoster(){
  document.getElementById('opGirisEkrani').style.display = 'none';
  document.getElementById('opPanelEkrani').style.display = 'block';
  const v = opVerileriOku();
  const isimler = Object.keys(v);
  const govde = document.getElementById('opTabloGovde');
  const bosMesaj = document.getElementById('opBosMesaj');
  govde.innerHTML = '';
  if(isimler.length === 0){
    bosMesaj.style.display = 'block';
    return;
  }
  bosMesaj.style.display = 'none';
  isimler.sort((a,b)=> (v[b].oyunlar.length - v[a].oyunlar.length)).forEach(ad=>{
    const kayit = v[ad];
    const tr = document.createElement('tr');
    const sonAktivite = kayit.oyunlar.length ? kayit.oyunlar[kayit.oyunlar.length-1].tarih : '-';
    const oyunListesi = kayit.oyunlar.map(o=>o.bolum).join(', ');
    tr.innerHTML = `
      <td>${ad}</td>
      <td>${kayit.sonPuan}</td>
      <td>${kayit.oyunlar.length}</td>
      <td>${(kayit.sonRozetler||[]).join(' ') || '-'}</td>
      <td>${sonAktivite}</td>
      <td><button class="op-detay-btn" onclick="opDetayGoster(this, '${ad.replace(/'/g,"\\'")}')">Detay</button></td>
    `;
    govde.appendChild(tr);
    const detayTr = document.createElement('tr');
    detayTr.className = 'op-detay-satir';
    detayTr.style.display = 'none';
    detayTr.innerHTML = `<td colspan="6"><b>Tamamlanan bölümler:</b> ${esc(oyunListesi) || 'Henüz yok'}</td>`;
    govde.appendChild(detayTr);
  });
}
function esc(s){ return String(s).replace(/</g,'&lt;'); }
function opDetayGoster(btn, ad){
  const tr = btn.closest('tr').nextElementSibling;
  tr.style.display = tr.style.display === 'none' ? 'table-row' : 'none';
}
function opVerileriTemizle(){
  ozelOnay('Bu ünitedeki tüm öğrenci verileri silinecek. Emin misiniz?', function(onaylandi){
    if(onaylandi){
      localStorage.removeItem(OP_ANAHTAR);
      opPaneliGoster();
    }
  });
}


// ===================== OZEL MODAL / BILDIRIM (alert-confirm yerine) =====================
function ozelBildirim(mesaj){
  const eski = document.querySelector('.ozel-toast');
  if(eski) eski.remove();
  const toast = document.createElement('div');
  toast.className = 'ozel-toast';
  toast.textContent = mesaj;
  document.body.appendChild(toast);
  setTimeout(()=>toast.remove(), 3200);
}
function ozelOnay(mesaj, callback){
  const arka = document.createElement('div');
  arka.className = 'ozel-modal-arka';
  arka.innerHTML = '<div class="ozel-modal-kutu"><p class="ozel-modal-mesaj"></p>' +
    '<button class="ozel-modal-btn" style="background:var(--kirmizi);color:#fff;">Evet</button>' +
    '<button class="ozel-modal-btn" style="background:#e2e8f0;">Vazgeç</button></div>';
  arka.querySelector('.ozel-modal-mesaj').textContent = mesaj;
  document.body.appendChild(arka);
  const btnler = arka.querySelectorAll('.ozel-modal-btn');
  btnler[0].onclick = ()=>{ arka.remove(); callback(true); };
  btnler[1].onclick = ()=>{ arka.remove(); callback(false); };
}


// ===================== KENDIMI DEGERLENDIRIYORUM - CHECKBOX KAYDI =====================
function degOku(uniteKimlik){
  try{ return JSON.parse(localStorage.getItem('dkabDegerlendirme_'+uniteKimlik)) || {}; }catch(e){ return {}; }
}
function degKaydet(uniteKimlik){
  const durum = {};
  document.querySelectorAll('[id^="deg_'+uniteKimlik+'_"]').forEach(cb=>{ durum[cb.id] = cb.checked; });
  try{ localStorage.setItem('dkabDegerlendirme_'+uniteKimlik, JSON.stringify(durum)); }catch(e){}
}
function degYukle(uniteKimlik){
  const durum = degOku(uniteKimlik);
  Object.keys(durum).forEach(id=>{
    const cb = document.getElementById(id);
    if(cb) cb.checked = durum[id];
  });
}
document.addEventListener('DOMContentLoaded', function(){
  if(typeof UNITE_KIMLIK !== 'undefined') degYukle(UNITE_KIMLIK);
});


// ===================== DUSUN VE CEVAPLA / AILEMLE YAPIYORUM - CEVAP KAYDI =====================
function zbCevapAnahtari(tur){ return 'dkabZbCevap_' + (typeof UNITE_KIMLIK !== 'undefined' ? UNITE_KIMLIK : location.pathname) + '_' + tur; }
function zbCevapKaydet(tur, el){
  try{ localStorage.setItem(zbCevapAnahtari(tur), el.value); }catch(e){}
  const not = document.getElementById('zbNot_'+tur);
  if(not){
    not.textContent = '✓ Cevabın kaydedildi';
    clearTimeout(not._zbT);
    not._zbT = setTimeout(()=>{ not.textContent=''; }, 2500);
  }
}
function zbCevapYukle(){
  document.querySelectorAll('[id^="zbAlan_"]').forEach(el=>{
    const tur = el.id.slice('zbAlan_'.length);
    try{ const v = localStorage.getItem(zbCevapAnahtari(tur)); if(v) el.value = v; }catch(e){}
  });
}
document.addEventListener('DOMContentLoaded', zbCevapYukle);


// ===================== TEKRAR ZAMANI HATIRLATMASI =====================
function zbTekrarHatirlatmaKontrol(){
  const uniteKimlik = (typeof UNITE_KIMLIK !== 'undefined') ? UNITE_KIMLIK : location.pathname;
  const anahtar = 'dkabSonZiyaret_' + uniteKimlik;
  let son = null;
  try{ son = localStorage.getItem(anahtar); }catch(e){}
  const bugun = new Date();
  if(son){
    const gecenGun = Math.floor((bugun - new Date(son)) / 86400000);
    if(gecenGun >= 3 && typeof ozelBildirim === 'function'){
      setTimeout(()=>{ ozelBildirim('👋 Bu üniteyi ' + gecenGun + ' gündür tekrar etmedin. Hafızanı tazelemek ister misin?'); }, 1500);
    }
  }
  try{ localStorage.setItem(anahtar, bugun.toISOString()); }catch(e){}
}
document.addEventListener('DOMContentLoaded', zbTekrarHatirlatmaKontrol);

</script>
<script id="ogrKatmaniScript">
/* ===================== OGRENME DENEYIMI KATMANI (JS) =====================
   Sadece EKLEME yapar: mevcut id/onclick/veri yapisina dokunmaz, hicbir
   fonksiyonu yeniden tanimlamaz. Amac: hero'ya hedef+ilerleme, konu ozetine
   "ogrenme yolu" (modul kartlari + ilerleme cubugu), sunum/test bolumlerine
   kisa tanitim kartlari eklemek. Tum yeni fonksiyon/degiskenler "ogr" onekiyle
   isimlendirildi ki mevcut kodla asla çakismasin. */
(function(){
  function ogrUniteKimlik(){ return (typeof UNITE_KIMLIK !== 'undefined') ? UNITE_KIMLIK : location.pathname; }
  function ogrEmojiTemizle(t){
    return (t||'')
      .replace(/^\s*\d+️?⃣\s*/,'') /* baştaki "1️⃣" gibi sayı+tuş takımı simgesi */
      .replace(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}\u{2000}-\u{206F}️⃣]/gu,'')
      .trim();
  }
  function ogrSureTahmini(karakterSayisi){
    return Math.max(1, Math.round(karakterSayisi/700));
  }
  function ogrGorulenOku(anahtar){
    try{ return JSON.parse(localStorage.getItem(anahtar)) || []; }catch(e){ return []; }
  }
  function ogrGorulenYaz(anahtar, dizi){
    try{ localStorage.setItem(anahtar, JSON.stringify(dizi)); }catch(e){}
  }

  /* ---------- 1) KONU OZETI: ogrenme yolu + ilerleme ---------- */
  function ogrOzetGelistir(){
    const ozet = document.querySelector('main section[id^="ozet"]');
    if(!ozet || ozet.dataset.ogrHazir) return;

    const cocuklar = Array.from(ozet.children);
    const modulBaslar = [];
    cocuklar.forEach(function(c, i){
      if(c.classList && c.classList.contains('kutu-panel') && c.querySelector(':scope > h3')) modulBaslar.push(i);
    });
    if(modulBaslar.length < 2) return; /* tek modullu ünitede ekstra karmasaya gerek yok */
    ozet.dataset.ogrHazir = '1';

    const moduller = modulBaslar.map(function(baslangic, idx){
      const bitis = idx+1 < modulBaslar.length ? modulBaslar[idx+1] : cocuklar.length;
      const nodes = cocuklar.slice(baslangic, bitis);
      const h3 = nodes[0].querySelector(':scope > h3');
      const baslikMetni = ogrEmojiTemizle(h3 ? h3.textContent : ('Bölüm ' + (idx+1)));
      const karakterSayisi = nodes.reduce(function(t,n){ return t + (n.textContent||'').length; }, 0);
      return { nodes:nodes, baslik:baslikMetni, sure: ogrSureTahmini(karakterSayisi) };
    });
    const toplamSure = moduller.reduce(function(t,m){ return t+m.sure; }, 0);

    const gorulenAnahtar = 'dkabOzetGorulen_' + ogrUniteKimlik();
    let gorulenler = ogrGorulenOku(gorulenAnahtar);

    /* Üst özet paneli */
    const ustPanel = document.createElement('div');
    ustPanel.className = 'ogr-ozet-ust';
    const yolLi = moduller.map(function(m,i){
      return '<a href="#ogrModul'+i+'" class="ogr-yol-adim" data-ogr-index="'+i+'">'+
        '<span class="ogr-yol-no">'+(i+1)+'</span><span class="ogr-yol-baslik">'+m.baslik+'</span></a>';
    }).join('');
    ustPanel.innerHTML =
      '<div class="ogr-ozet-ust-satir">'+
        '<p class="ogr-ozet-baslik">🗺️ Öğrenme Yolu</p>'+
        '<div class="ogr-ozet-meta">'+
          '<span>📚 '+moduller.length+' bölüm</span>'+
          '<span>⏱️ ~'+toplamSure+' dk okuma</span>'+
        '</div>'+
      '</div>'+
      '<ul class="ogr-yol-liste">'+yolLi+'</ul>'+
      '<div class="ogr-ilerleme-cubuk-dis"><div class="ogr-ilerleme-cubuk-ic" id="ogrIlerlemeCubuk"></div></div>';
    const ozetH2 = ozet.querySelector(':scope > h2');
    if(ozetH2 && ozetH2.nextSibling) ozet.insertBefore(ustPanel, ozetH2.nextSibling);
    else ozet.insertBefore(ustPanel, ozet.firstChild);

    ustPanel.querySelectorAll('.ogr-yol-adim').forEach(function(a){
      a.addEventListener('click', function(e){
        e.preventDefault();
        const hedef = document.getElementById('ogrModul'+a.dataset.ogrIndex);
        if(hedef) hedef.scrollIntoView({behavior:'smooth', block:'start'});
      });
    });

    /* Modülleri sar (mevcut node'lar tasinir, KOPYALANMAZ; id/onclick/veri korunur) */
    moduller.forEach(function(m, i){
      const sarmalayici = document.createElement('div');
      sarmalayici.className = 'ogr-modul';
      sarmalayici.id = 'ogrModul' + i;
      if(gorulenler.indexOf(i) !== -1) sarmalayici.classList.add('ogr-tamamlandi');
      const no = document.createElement('div'); no.className='ogr-modul-no'; no.textContent = String(i+1);
      const sure = document.createElement('div'); sure.className='ogr-modul-sure'; sure.textContent = '⏱️ ~'+m.sure+' dk';
      const govde = document.createElement('div'); govde.className='ogr-modul-govde';
      m.nodes.forEach(function(n){ govde.appendChild(n); }); /* appendChild = tasima, kopyalama degil */
      sarmalayici.appendChild(no);
      sarmalayici.appendChild(sure);
      sarmalayici.appendChild(govde);
      ozet.appendChild(sarmalayici);
    });

    function ogrIlerlemeGuncelle(){
      const oran = moduller.length ? gorulenler.length/moduller.length : 0;
      const cubuk = document.getElementById('ogrIlerlemeCubuk');
      if(cubuk) cubuk.style.width = Math.round(oran*100)+'%';
      ustPanel.querySelectorAll('.ogr-yol-adim').forEach(function(a){
        a.classList.toggle('ogr-gorulen', gorulenler.indexOf(+a.dataset.ogrIndex) !== -1);
      });
    }
    ogrIlerlemeGuncelle();

    if('IntersectionObserver' in window){
      const gozlemci = new IntersectionObserver(function(kayitlar){
        let degisti = false;
        kayitlar.forEach(function(kayit){
          if(kayit.isIntersecting){
            const idx = +kayit.target.id.replace('ogrModul','');
            if(gorulenler.indexOf(idx) === -1){
              gorulenler.push(idx);
              kayit.target.classList.add('ogr-tamamlandi');
              degisti = true;
            }
          }
        });
        if(degisti){ ogrGorulenYaz(gorulenAnahtar, gorulenler); ogrIlerlemeGuncelle(); }
      }, {threshold:0.55});
      moduller.forEach(function(m,i){ gozlemci.observe(document.getElementById('ogrModul'+i)); });
    }
  }

  /* ---------- 2) HERO: ogrenme hedefleri + ilerleme rozeti ---------- */
  function ogrHeroGelistir(){
    const hedefKonteyner = document.getElementById('ogrHedefKonteyner');
    if(!hedefKonteyner || hedefKonteyner.dataset.ogrHazir) return;
    hedefKonteyner.dataset.ogrHazir = '1';

    const basliklar = Array.from(document.querySelectorAll('main section[id^="ozet"] .kutu-panel > h3')).map(function(h){
      return ogrEmojiTemizle(h.textContent);
    });
    const ek = document.createElement('div');
    ek.className = 'ogr-hero-ek';
    let ic = '';
    if(basliklar.length){
      ic += '<div class="ogr-hedef-satir">' + basliklar.map(function(b,i){
        return '<span class="ogr-hedef-cip"><span class="ogr-hedef-no">'+(i+1)+'</span>'+b+'</span>';
      }).join('') + '</div>';
    }
    ic += '<span class="ogr-ilerleme-rozet"><svg class="ogr-ring" viewBox="0 0 32 32" aria-hidden="true">'+
      '<circle class="ogr-ring-arka" cx="16" cy="16" r="13"></circle>'+
      '<circle class="ogr-ring-on" id="ogrHeroRing" cx="16" cy="16" r="13" stroke-dasharray="81.68" stroke-dashoffset="81.68"></circle>'+
      '</svg><span id="ogrHeroRozetMetin">Bu üniteye yeni başlıyorsun</span></span>';
    ek.innerHTML = ic;
    hedefKonteyner.appendChild(ek);

    const toplamEtkinlik = document.querySelectorAll('.oyun-grubu button').length || 1;
    function ogrHeroIlerlemeGuncelle(){
      const tamamlananEl = document.getElementById('istTamamlanan');
      const tamamlanan = tamamlananEl ? (parseInt(tamamlananEl.textContent,10) || 0) : 0;
      const oran = Math.min(1, tamamlanan/toplamEtkinlik);
      const ring = document.getElementById('ogrHeroRing');
      if(ring) ring.setAttribute('stroke-dashoffset', String(81.68*(1-oran)));
      const metin = document.getElementById('ogrHeroRozetMetin');
      if(metin){
        metin.textContent = tamamlanan===0
          ? 'Bu üniteye yeni başlıyorsun'
          : (tamamlanan+'/'+toplamEtkinlik+' etkinlik tamamlandı (%'+Math.round(oran*100)+')');
      }
    }
    ogrHeroIlerlemeGuncelle();
    const istTamamlananEl = document.getElementById('istTamamlanan');
    if(istTamamlananEl && 'MutationObserver' in window){
      new MutationObserver(ogrHeroIlerlemeGuncelle).observe(istTamamlananEl, {childList:true, characterData:true, subtree:true});
    }
  }

  /* ---------- 3) SUNUM / TEST: kisa tanitim kartlari ---------- */
  function ogrGirisKartiEkle(sectionEl, ikon, baslik, metin){
    if(!sectionEl || sectionEl.dataset.ogrGirisHazir) return;
    sectionEl.dataset.ogrGirisHazir = '1';
    const h2 = sectionEl.querySelector(':scope > h2');
    if(!h2) return;
    const kart = document.createElement('div');
    kart.className = 'ogr-giris-karti';
    kart.innerHTML = '<div class="ogr-giris-ikon">'+ikon+'</div><div class="ogr-giris-metin"><b>'+baslik+'</b><span>'+metin+'</span></div>';
    h2.insertAdjacentElement('afterend', kart);
  }
  function ogrSunumTanitimEkle(){
    const slaytBolumu = document.getElementById('slayt');
    if(!slaytBolumu) return;
    const sayac = slaytBolumu.querySelector('#sunumSayac');
    const eslesme = sayac ? sayac.textContent.match(/\/\s*(\d+)/) : null;
    const toplamSlayt = eslesme ? eslesme[1] : '?';
    ogrGirisKartiEkle(slaytBolumu, '🖥️', 'Ünitenin tamamını 5-10 dakikada gözden geçir',
      toplamSlayt+' slaytlık kısa bir sunum — okuduğun konuları toparlamak için ideal.');
  }
  function ogrTestTanitimEkle(){
    const testBolumu = document.querySelector('main section[id^="konutekrari"]');
    if(!testBolumu) return;
    const h2Metin = testBolumu.querySelector(':scope > h2') ? testBolumu.querySelector(':scope > h2').textContent : '';
    const eslesme = h2Metin.match(/\((\d+)\s*Soru\)/i);
    const soruSayisi = eslesme ? eslesme[1] : '?';
    ogrGirisKartiEkle(testBolumu, '📝', 'Ne kadar hazır olduğunu ölç',
      soruSayisi+' soruluk karma bir test — her yanlışta açıklamasıyla birlikte anında geri bildirim alırsın.');
  }

  function ogrBaslat(){
    ogrOzetGelistir();
    ogrHeroGelistir();
    ogrSunumTanitimEkle();
    ogrTestTanitimEkle();
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', ogrBaslat);
  else ogrBaslat();
})();
</script>
</body>
</html>
