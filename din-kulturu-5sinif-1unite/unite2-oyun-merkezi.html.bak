.omg-kart-alan{
  flex:1 1 420px; min-width:0; width:100%;
  max-height:660px; overflow-y:auto; padding:4px 4px 4px 0;
  animation: omgKartGiris .3s ease;
}
@keyframes omgKartGiris{ from{ opacity:0; transform:translateY(8px); } to{ opacity:1; transform:translateY(0); } }
.omg-kart-izgara{
  display:grid; grid-template-columns:repeat(2, 1fr);
  gap:22px; width:100%; align-content:start;
}
.omg-oyun-kart{
  position:relative; cursor:pointer;
  background:#fff; border-radius:18px; padding:30px 24px 26px;
  text-align:left; box-shadow:0 2px 10px rgba(0,0,0,.06);
  transition:.18s; display:flex; flex-direction:column; gap:8px;
  min-height:180px; border:1px solid transparent;
}
.omg-oyun-kart:hover{ transform:translateY(-4px); box-shadow:0 14px 28px rgba(0,0,0,.12); border-color:var(--acik); }
.omg-oyun-kart-ikon{ font-size:1.8em; }
.omg-oyun-kart h4{ margin:2px 0 0; font-size:1.08em; color:#22333b; line-height:1.35; }
.omg-oyun-kart p{ margin:0; font-size:.86em; color:#8892a0; line-height:1.5; flex:1; }
.omg-oyun-kart-alt{ display:flex; align-items:center; justify-content:space-between; margin-top:4px; }
.omg-zorluk{ font-size:.72em; font-weight:800; letter-spacing:.3px; padding:4px 11px; border-radius:999px; background:var(--acikgri); color:#667; }
.omg-oyna-ok{ font-size:.85em; font-weight:800; color:var(--mavi); }
@media(max-width:640px){
  .omg-2kolon{ flex-direction:column; gap:16px; }
  .omg-yan-menu{
    flex-direction:row; flex-wrap:nowrap; overflow-x:auto; -webkit-overflow-scrolling:touch;
