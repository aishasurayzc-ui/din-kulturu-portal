    document.getElementById('ez72Metin').textContent='';
    document.getElementById('ez72Secenekler').innerHTML='';
    document.getElementById('ez72Sonuc').innerHTML = `🎉 Bitti! ${ez72Dogru}/${ez72Sira.length} doğru hatırladın.`;
