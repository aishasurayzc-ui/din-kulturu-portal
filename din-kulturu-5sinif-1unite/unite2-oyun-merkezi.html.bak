  padding:12px 18px; border-radius:14px;
  border:2px solid var(--acik); border-left:5px solid transparent;
  background:#fff; color:#22333b;
  box-shadow:0 1px 3px rgba(0,0,0,.06);
  font-size:.95em; font-weight:700;
  transition:.15s; white-space:normal;
}
