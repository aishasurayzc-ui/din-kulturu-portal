.merdiven-secenek.secili{ background:#fff3cd; border-color:#f4a261; }
.merdiven-secenek.eslesti{ background:#d8f3dc; border-color:var(--yesil); cursor:default; opacity:.85; }
.merdiven-secenek.ez-oge{ font-size:.85em; text-align:left; padding:9px 12px; }
.ez-zamanlayici{ text-align:center; font-size:1.6em; font-weight:800; color:var(--kirmizi); margin:8px 0; }
.ez-ogrenilen-liste{ max-width:560px; margin:10px auto; padding:10px 16px; background:#f4f0ff; border-radius:8px; font-size:.88em; line-height:1.7; min-height:20px; }
.ez-ogrenilen-liste b{ color:#4c1d95; }
