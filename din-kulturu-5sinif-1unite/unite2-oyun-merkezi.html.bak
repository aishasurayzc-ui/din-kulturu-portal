  {parca:"Namaz dinin direğidir.", anlam:"Hz. Muhammed (sav), namazın dindeki önemini vurgular.", gizli:"Namaz dinin direğidir."},
  {parca:"Namazı vaktinde kılınız.", anlam:"Namazın vaktinde kılınması gerektiği öğütlenir.", gizli:"Namazı vaktinde kılınız."},
  {parca:"Beni namaz kılarken gördüğünüz gibi siz de namaz kılınız.", anlam:"Namazın Hz. Muhammed'in (sav) örnekliğine göre kılınması istenir.", gizli:"namaz kılarken gördüğünüz gibi"},
  {parca:"Kıldığı namazla kul, Rabbine en çok secdede yaklaşır.", anlam:"Secdenin Allah'a (cc) en yakın olunan an olduğu vurgulanır.", gizli:"Rabbine en çok secdede yaklaşır"},
  {parca:"Namaz, kötülükten ve çirkinlikten alıkoyar.", anlam:"Namazın ahlaki koruyucu etkisi vurgulanır.", gizli:"kötülükten ve çirkinlikten alıkoyar"},
  {parca:"Cemaatle kılınan namaz, tek başına kılınan namazdan daha faziletlidir.", anlam:"Cemaatin önemi vurgulanır.", gizli:"tek başına kılınan namazdan daha faziletlidir"},
  {parca:"Ezan, minarelerden okunarak insanları namaza çağırır.", anlam:"Ezanın işlevi açıklanır.", gizli:"insanları namaza çağırır"},
  {parca:"Abdest, namazın ön şartlarından biridir.", anlam:"Abdestin namaz için gerekliliği vurgulanır.", gizli:"namazın ön şartlarından biridir"},
  {parca:"Kıble, tüm dünyadaki Müslümanları birleştiren ortak bir yöndür.", anlam:"Kıblenin birleştirici anlamı vurgulanır.", gizli:"Müslümanları birleştiren ortak bir yöndür"},
  {parca:"Huşu ile kılınan namaz, kalbi Allah'a (cc) yaklaştırır.", anlam:"Huşunun namazdaki önemi vurgulanır.", gizli:"kalbi Allah'a (cc) yaklaştırır"}
];

// --- 1) SIRALA BAKALIM ---
function ez12Baslat(){
  document.getElementById('ez12Sonuc').textContent='';
  document.getElementById('ez12Dizilen').textContent='0';
  siraOlustur({
    tokens: ezberVeri2.map(x=>x.parca),
    bankaId:'ez12Banka', cevapId:'ez12Cevap',
    ilerleme:(n)=>{ document.getElementById('ez12Dizilen').textContent=n; },
