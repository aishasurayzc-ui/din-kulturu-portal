<script>
function goster(id, ev){
  document.querySelectorAll('section').forEach(s=>s.classList.remove('aktif'));
  document.getElementById(id).classList.add('aktif');
  document.querySelectorAll('.oyun-grubu button').forEach(b=>b.classList.remove('aktif'));
  if(ev && ev.target) ev.target.classList.add('aktif');
}
function kategoriGoster(id, ev){
  document.querySelectorAll('.oyun-grubu').forEach(g=>g.classList.remove('aktif'));
  document.getElementById(id).classList.add('aktif');
  document.querySelectorAll('.kategori-nav button').forEach(b=>b.classList.remove('kat-aktif'));
  if(ev && ev.target) ev.target.classList.add('kat-aktif');
}
function kategoriGosterVeKaydir(kategoriId){
  document.querySelectorAll('.oyun-grubu').forEach(g=>g.classList.remove('aktif'));
  document.getElementById(kategoriId).classList.add('aktif');
  document.querySelectorAll('.kategori-nav button').forEach(b=>{
    b.classList.toggle('kat-aktif', b.getAttribute('onclick').includes(kategoriId));
  });
  document.getElementById('oyun-gruplari').scrollIntoView({behavior:'smooth'});
}

function karistir(a){ return a.map(v=>[Math.random(),v]).sort((x,y)=>x[0]-y[0]).map(v=>v[1]); }

let puanDurumu;
try{ puanDurumu = JSON.parse(localStorage.getItem('dkabPuanDurumu8sinif')) || {}; }catch(e){ puanDurumu = {}; }
puanDurumu = Object.assign({toplamPuan:0, tamamlanan:0, rozetler:[], sonOyunTarihi:null, seri:0}, puanDurumu);

function puanKaydet(){ try{ localStorage.setItem('dkabPuanDurumu8sinif', JSON.stringify(puanDurumu)); }catch(e){} }

function gunlukSeriGuncelle(){
  const bugun = new Date().toDateString();
  if(puanDurumu.sonOyunTarihi !== bugun){
    const dun = new Date(); dun.setDate(dun.getDate()-1);
    puanDurumu.seri = (puanDurumu.sonOyunTarihi === dun.toDateString()) ? puanDurumu.seri+1 : 1;
    puanDurumu.sonOyunTarihi = bugun;
  }
}

function istatistikleriGuncelleGoster(){
  const tp = document.getElementById('istToplamPuan');
  if(!tp) return;
  document.getElementById('istToplamPuan').textContent = puanDurumu.toplamPuan;
  document.getElementById('istTamamlanan').textContent = puanDurumu.tamamlanan;
  document.getElementById('istSeri').textContent = puanDurumu.seri;
  document.getElementById('istRozet').textContent = puanDurumu.rozetler.length;
}

function oyunTamamlandi(bolumId){
  puanDurumu.toplamPuan += 10;
  puanDurumu.tamamlanan++;
  gunlukSeriGuncelle();
  const esikler = [{sayi:1,ad:"🥉 İlk Adım"},{sayi:5,ad:"🥈 Azimli Öğrenci"},{sayi:10,ad:"🥇 Kelime Ustası"},{sayi:20,ad:"🏆 Efsane"}];
  esikler.forEach(e=>{
    if(puanDurumu.tamamlanan>=e.sayi && !puanDurumu.rozetler.includes(e.ad)) puanDurumu.rozetler.push(e.ad);
  });
  puanKaydet();
  istatistikleriGuncelleGoster();
  opOyunTamamlandiKaydet(bolumId, puanDurumu.toplamPuan, puanDurumu.rozetler);
}

function sonucIzlemeBaslat(){
  document.querySelectorAll('.sonuc-kutusu').forEach(el=>{
    const gozlemci = new MutationObserver(()=>{
      const metin = el.textContent;
      if((metin.includes('🎉') || metin.includes('🏆')) && el.dataset.sonOdul !== metin){
        el.dataset.sonOdul = metin;
        oyunTamamlandi(el.closest('section') ? el.closest('section').id : null);
      }
    });
    gozlemci.observe(el, {childList:true, characterData:true, subtree:true});
  });
}

function siraOlustur(cfg){
  const banka = document.getElementById(cfg.bankaId);
  const cevap = document.getElementById(cfg.cevapId);
  banka.innerHTML=''; cevap.innerHTML='';
  let beklenen = 0;
  const karisikSira = karistir(cfg.tokens.map((t,i)=>({t,i})));
  karisikSira.forEach(obj=>{
    const tas = document.createElement('div');
    tas.className='kelime-tas';
    tas.textContent = obj.t;
    tas.dataset.sira = obj.i;
    tas.onclick = ()=>{
      if(tas.classList.contains('kullanildi')) return;
      if(parseInt(tas.dataset.sira,10) === beklenen){
        tas.classList.add('kullanildi');
        tas.onclick = null;
        const kopya = document.createElement('div');
        kopya.className='kelime-tas';
        kopya.textContent = obj.t;
        cevap.appendChild(kopya);
        beklenen++;
        if(cfg.ilerleme) cfg.ilerleme(beklenen);
        if(beklenen === cfg.tokens.length && cfg.tamamlandi) cfg.tamamlandi();
      } else {
        tas.classList.add('yanlis');
        setTimeout(()=>tas.classList.remove('yanlis'), 300);
      }
    };
    banka.appendChild(tas);
  });
}

// =====================================================================
// 2. ÜNİTE KELİME HAVUZU (27 kavram) — 5. Sınıf
// =====================================================================
const kelimeHavuzu2 = [
  {kelime:"NAMAZ", anlam:"Allah'ın (cc) huzurunda belirli hareket ve sözlerle yapılan ibadet"},
  {kelime:"EZAN", anlam:"Namaz vaktinin geldiğini bildiren dini çağrı"},
  {kelime:"KAMET", anlam:"Namaza başlamadan hemen önce okunan çağrı"},
  {kelime:"ABDEST", anlam:"Namazdan önce yapılan dini temizlik"},
  {kelime:"KIBLE", anlam:"Namazda yönelinen Kâbe yönü"},
  {kelime:"SECDE", anlam:"Alnı yere koyarak Allah'a (cc) en yakın olunan namaz hareketi"},
  {kelime:"RÜKÛ", anlam:"Namazda eğilerek yapılan hareket"},
  {kelime:"KIYAM", anlam:"Namazda ayakta durma hâli"},
  {kelime:"TEKBİR", anlam:"'Allahu ekber' diyerek namaza başlama"},
  {kelime:"FATİHA", anlam:"Her rekâtta okunması gereken Kur'an'ın ilk suresi"},
  {kelime:"HUTBE", anlam:"Cuma ve bayram namazlarında imamın yaptığı konuşma"},
  {kelime:"CEMAAT", anlam:"Namazı birlikte kılan topluluk"},
  {kelime:"İMAM", anlam:"Namazı cemaate kıldıran kişi"},
  {kelime:"MÜEZZİN", anlam:"Ezan okuyan kişi"},
  {kelime:"TERAVİH", anlam:"Ramazan ayına özel kılınan gece namazı"},
  {kelime:"HUŞU", anlam:"Namazda kalbin Allah'a (cc) yönelmesi, saygılı dikkat"},
  {kelime:"NİYET", anlam:"Bir ibadeti yapmaya kalpten karar vermek"},
  {kelime:"FARZ", anlam:"Yapılması kesin olarak emredilen ibadet"},
  {kelime:"VACİP", anlam:"Farza yakın derecede önemli olan dini görev"},
  {kelime:"SÜNNET", anlam:"Hz. Muhammed'in (sav) yaptığı, örnek gösterdiği davranış"},
  {kelime:"NAFİLE", anlam:"Farz olmayan, gönüllü yapılan ibadet"},
  {kelime:"VİTİR", anlam:"Yatsı namazından sonra kılınan tek rekâtlı vacip namaz"},
  {kelime:"MESCİT", anlam:"Namaz kılınan küçük ibadet yeri"},
  {kelime:"MİHRAP", anlam:"Camide imamın namaz kıldırdığı, kıbleyi gösteren yer"},
  {kelime:"MİNBER", anlam:"Camide hutbe okumak için kullanılan yer"},
  {kelime:"SECCADE", anlam:"Namaz kılarken üzerine secde edilen küçük halı"},
  {kelime:"TESPİH", anlam:"Namazdan sonra zikir çekmek için kullanılan boncuk dizisi"}
];
function ku2AnlamBul(kelime){
  const bulunan = kelimeHavuzu2.find(x=>x.kelime===kelime);
  return bulunan ? bulunan.anlam : '';
}

// =====================================================================
// HIZLI KELİME ÜRETME
// =====================================================================
const ku2GecerliHarfler = ["N","E","A","K","S","T"];
let ku2AktifHarf = '', ku2Bulunanlar = [], ku2Sure = 60, ku2Zamanlayici = null, ku2Puan = 0, ku2Bitti = true;

function ku2Baslat(){
  clearInterval(ku2Zamanlayici);
  ku2AktifHarf = ku2GecerliHarfler[Math.floor(Math.random()*ku2GecerliHarfler.length)];
  ku2Bulunanlar = []; ku2Puan = 0; ku2Sure = 60; ku2Bitti = false;
  document.getElementById('ku2Harf').textContent = ku2AktifHarf;
  document.getElementById('ku2Sure').textContent = ku2Sure;
  document.getElementById('ku2Puan').textContent = 0;
  document.getElementById('ku2Liste').innerHTML = '';
  document.getElementById('ku2Sonuc').textContent = '';
  document.getElementById('ku2Uyari').textContent = '';
  document.getElementById('ku2Kacirilan').innerHTML = '';
  const girdi = document.getElementById('ku2Girdi');
  girdi.value = ''; girdi.disabled = false; girdi.focus();
  ku2Zamanlayici = setInterval(()=>{
    ku2Sure--;
    document.getElementById('ku2Sure').textContent = ku2Sure;
    if(ku2Sure<=0) ku2Bitir();
  }, 1000);
}

function ku2Ekle(){
  if(ku2Bitti) return;
  const girdi = document.getElementById('ku2Girdi');
  const kelime = girdi.value.trim().toLocaleUpperCase('tr-TR');
  girdi.value = '';
  if(!kelime) return;
  const uyari = document.getElementById('ku2Uyari');
  if(!kelime.startsWith(ku2AktifHarf)){ uyari.textContent = `❌ "${ku2AktifHarf}" harfiyle başlamalı!`; return; }
  if(!kelimeHavuzu2.some(x=>x.kelime===kelime)){ uyari.textContent = `🤔 Bu kelimeyi bilmiyorum, ünitedeki bir kavram olmalı!`; return; }
  if(ku2Bulunanlar.includes(kelime)){ uyari.textContent = `⚠️ Bu kelimeyi zaten yazdın!`; return; }
  ku2Bulunanlar.push(kelime);
  ku2Puan++;
  document.getElementById('ku2Puan').textContent = ku2Puan;
  const li = document.createElement('li');
  li.textContent = kelime;
  document.getElementById('ku2Liste').appendChild(li);
  uyari.textContent = '';
}

function ku2Bitir(){
  clearInterval(ku2Zamanlayici);
  ku2Bitti = true;
  document.getElementById('ku2Girdi').disabled = true;
  document.querySelectorAll('#ku2Liste li').forEach(li=>{
    const kelime = li.textContent;
    li.textContent = `${kelime} — ${ku2AnlamBul(kelime)}`;
  });
  const kacirilanKutu = document.getElementById('ku2Kacirilan');
  kacirilanKutu.innerHTML = '';
  const kacirilanlar = kelimeHavuzu2.filter(x=>x.kelime.startsWith(ku2AktifHarf) && !ku2Bulunanlar.includes(x.kelime));
  if(kacirilanlar.length){
    const baslik = document.createElement('p');
    baslik.style.textAlign='center'; baslik.style.fontWeight='bold'; baslik.style.color='var(--kirmizi)';
    baslik.textContent = 'Kaçırdıkların:';
    kacirilanKutu.appendChild(baslik);
    const ul = document.createElement('ul'); ul.className='ku-liste';
    kacirilanlar.forEach(item=>{
      const li = document.createElement('li');
      li.style.background='#ffe8d6'; li.style.borderColor='var(--sari)';
      li.textContent = `${item.kelime} — ${item.anlam}`;
      ul.appendChild(li);
    });
    kacirilanKutu.appendChild(ul);
  }
  document.getElementById('ku2Sonuc').textContent = `⏰ Süre bitti! "${ku2AktifHarf}" harfiyle ${ku2Puan} doğru kelime yazdın!`;
}

// =====================================================================
// TUZAK HARF
// =====================================================================
const tuzak2GecerliHarfler = ["A","E","İ","N","T"];
let tuzak2Harf = '', tuzak2Bulunanlar = [], tuzak2Sure = 40, tuzak2Zamanlayici = null, tuzak2Puan = 0, tuzak2Bitti = true;

function tuzak2Baslat(){
  clearInterval(tuzak2Zamanlayici);
  tuzak2Harf = tuzak2GecerliHarfler[Math.floor(Math.random()*tuzak2GecerliHarfler.length)];
  tuzak2Bulunanlar = []; tuzak2Puan = 0; tuzak2Sure = 40; tuzak2Bitti = false;
  document.getElementById('tuzak2Harf').textContent = tuzak2Harf;
  document.getElementById('tuzak2Sure').textContent = tuzak2Sure;
  document.getElementById('tuzak2Puan').textContent = 0;
  document.getElementById('tuzak2Liste').innerHTML = '';
  document.getElementById('tuzak2Sonuc').textContent = '';
  document.getElementById('tuzak2Uyari').textContent = '';
  const girdi = document.getElementById('tuzak2Girdi');
  girdi.value = ''; girdi.disabled = false; girdi.focus();
  tuzak2Zamanlayici = setInterval(()=>{
    tuzak2Sure--;
    document.getElementById('tuzak2Sure').textContent = tuzak2Sure;
    if(tuzak2Sure<=0) tuzak2Bitir();
  }, 1000);
}

function tuzak2Ekle(){
  if(tuzak2Bitti) return;
  const girdi = document.getElementById('tuzak2Girdi');
  const kelime = girdi.value.trim().toLocaleUpperCase('tr-TR');
  girdi.value = '';
  if(!kelime) return;
  const uyari = document.getElementById('tuzak2Uyari');
  if(kelime.includes(tuzak2Harf)){ uyari.textContent = `🚫 Bu kelimede tuzak harf "${tuzak2Harf}" var, geçersiz!`; return; }
  if(!kelimeHavuzu2.some(x=>x.kelime===kelime)){ uyari.textContent = `🤔 Bu kelimeyi bilmiyorum, ünitedeki bir kavram olmalı!`; return; }
  if(tuzak2Bulunanlar.includes(kelime)){ uyari.textContent = `⚠️ Bu kelimeyi zaten yazdın!`; return; }
  tuzak2Bulunanlar.push(kelime);
  tuzak2Puan++;
  document.getElementById('tuzak2Puan').textContent = tuzak2Puan;
  const li = document.createElement('li');
  li.textContent = kelime;
  document.getElementById('tuzak2Liste').appendChild(li);
  uyari.textContent = '';
}

function tuzak2Bitir(){
  clearInterval(tuzak2Zamanlayici);
  tuzak2Bitti = true;
  document.getElementById('tuzak2Girdi').disabled = true;
  document.querySelectorAll('#tuzak2Liste li').forEach(li=>{
    const kelime = li.textContent;
    li.textContent = `${kelime} — ${ku2AnlamBul(kelime)}`;
  });
  document.getElementById('tuzak2Sonuc').textContent = `⏰ Süre bitti! "${tuzak2Harf}" harfini kullanmadan ${tuzak2Puan} kelime yazdın!`;
}

// =====================================================================
// KELİME FABRİKASI
// =====================================================================
let kf2Sira = [], kf2Index = 0, kf2Uretilen = 0, kf2Hata = 0;

function kf2Baslat(){
  kf2Sira = karistir(kelimeHavuzu2.slice());
  kf2Index = 0; kf2Uretilen = 0; kf2Hata = 0;
  document.getElementById('kf2Uretilen').textContent = 0;
  document.getElementById('kf2Toplam').textContent = kf2Sira.length;
  document.getElementById('kf2Hata').textContent = 0;
  document.getElementById('kf2Urunler').innerHTML = '';
  document.getElementById('kf2Sonuc').textContent = '';
  kf2Tur();
}

function kf2Tur(){
  if(kf2Index >= kf2Sira.length){
    document.getElementById('kf2BantAlani').innerHTML = '';
    document.getElementById('kf2Siparis').textContent = '';
    document.getElementById('kf2Girdi').disabled = true;
    document.getElementById('kf2Sonuc').textContent = `🏭 Fabrika kapandı! ${kf2Uretilen}/${kf2Sira.length} kelime ürettin, ${kf2Hata} hata yaptın.`;
    return;
  }
  const oge = kf2Sira[kf2Index];
  document.getElementById('kf2Siparis').textContent = `📋 Sipariş: ${oge.anlam}`;
  const harfler = karistir(oge.kelime.split(''));
  const bant = document.getElementById('kf2BantAlani');
  bant.innerHTML = '';
  harfler.forEach(h=>{
    const kutu = document.createElement('div');
    kutu.className = 'kf-kutu';
    kutu.textContent = h;
    bant.appendChild(kutu);
  });
  const girdi = document.getElementById('kf2Girdi');
  girdi.value = ''; girdi.disabled = false; girdi.focus();
}

function kf2Uret(){
  if(kf2Index >= kf2Sira.length) return;
  const oge = kf2Sira[kf2Index];
  const girdi = document.getElementById('kf2Girdi');
  const tahmin = girdi.value.trim().toLocaleUpperCase('tr-TR');
  if(!tahmin) return;
  if(tahmin === oge.kelime){
    kf2Uretilen++;
    document.getElementById('kf2Uretilen').textContent = kf2Uretilen;
    const cip = document.createElement('div');
    cip.className = 'dua-cip';
    cip.textContent = `✅ ${oge.kelime}`;
    document.getElementById('kf2Urunler').appendChild(cip);
    kf2Index++;
    setTimeout(()=>kf2Tur(), 400);
  } else {
    kf2Hata++;
    document.getElementById('kf2Hata').textContent = kf2Hata;
    girdi.classList.add('yanlis-girdi');
    setTimeout(()=>girdi.classList.remove('yanlis-girdi'), 400);
    girdi.value = '';
  }
}

// =====================================================================
// KELİME MÜHENDİSİ
// =====================================================================
function parcalaraBol(kelime){
  const uzunluk = kelime.length;
  let parcaSayisi = uzunluk<=4 ? 2 : uzunluk<=7 ? 3 : 4;
  parcaSayisi = Math.min(parcaSayisi, uzunluk);
  const parcalar = [];
  let index = 0;
  for(let i=0;i<parcaSayisi;i++){
    const kalan = parcaSayisi - i;
    const buBoyut = i===parcaSayisi-1 ? uzunluk-index : Math.ceil((uzunluk-index)/kalan);
    parcalar.push(kelime.slice(index, index+buBoyut));
    index += buBoyut;
  }
  return parcalar;
}

let km2Sira = [], km2Index = 0, km2DogruSayisi = 0;

function km2Baslat(){
  km2Sira = karistir(kelimeHavuzu2.slice());
  km2Index = 0; km2DogruSayisi = 0;
  document.getElementById('km2Dogru').textContent = 0;
  document.getElementById('km2Toplam').textContent = km2Sira.length;
  document.getElementById('km2Sonuc').textContent = '';
  km2Tur();
}

function km2Tur(){
  if(km2Index >= km2Sira.length){
    document.getElementById('km2Ipucu').textContent = '';
    document.getElementById('km2Banka').innerHTML = '';
    document.getElementById('km2Cevap').innerHTML = '';
    document.getElementById('km2Sonuc').textContent = `🏆 Tebrikler! Kelime mühendisliğini tamamladın! ${km2DogruSayisi}/${km2Sira.length} kelime inşa ettin.`;
    return;
  }
  document.getElementById('km2Tur').textContent = km2Index+1;
  const oge = km2Sira[km2Index];
  document.getElementById('km2Ipucu').innerHTML = `📐 Plan: <b>${oge.anlam}</b>`;
  const parcalar = parcalaraBol(oge.kelime);
  siraOlustur({tokens:parcalar, bankaId:'km2Banka', cevapId:'km2Cevap', tamamlandi:()=>{
    km2DogruSayisi++;
    document.getElementById('km2Dogru').textContent = km2DogruSayisi;
    document.getElementById('km2Sonuc').textContent = `✅ İnşa edildi: ${oge.kelime}`;
    km2Index++;
    setTimeout(()=>{ document.getElementById('km2Sonuc').textContent=''; km2Tur(); }, 1000);
  }});
}

// =====================================================================
// KAVRAM TURNUVASI
// =====================================================================
const turnuvaEslesmeler2 = [
  {tur:"Çeyrek Final 1", a:"NAMAZ", b:"EZAN", soru:"Allah'ın (cc) huzurunda belirli hareket ve sözlerle yapılan ibadete ne denir?", dogruCevap:"NAMAZ"},
  {tur:"Çeyrek Final 2", a:"ABDEST", b:"KIBLE", soru:"Namazdan önce yapılan dini temizliğe ne denir?", dogruCevap:"ABDEST"},
  {tur:"Çeyrek Final 3", a:"SECDE", b:"RÜKÛ", soru:"Alnı yere koyarak yapılan namaz hareketine ne denir?", dogruCevap:"SECDE"},
  {tur:"Çeyrek Final 4", a:"CEMAAT", b:"İMAM", soru:"Namazı birlikte kılan topluluğa ne denir?", dogruCevap:"CEMAAT"},
  {tur:"Yarı Final 1", a:"NAMAZ", b:"ABDEST", soru:"Beş vakit farz olan ibadet hangisidir?", dogruCevap:"NAMAZ"},
  {tur:"Yarı Final 2", a:"SECDE", b:"CEMAAT", soru:"Allah'a (cc) en yakın olunan namaz hareketi hangisidir?", dogruCevap:"SECDE"},
  {tur:"Final", a:"NAMAZ", b:"SECDE", soru:"Bu ünitenin ana konusu olan ibadete ne denir?", dogruCevap:"NAMAZ"}
];
let kt2Index = 0, kt2DogruHakemlik = 0;

function kt2Baslat(){
  kt2Index = 0; kt2DogruHakemlik = 0;
  document.getElementById('kt2Puan').textContent = 0;
  document.getElementById('kt2Toplam').textContent = turnuvaEslesmeler2.length;
  document.getElementById('kt2Sonuc').textContent = '';
  kt2Tur();
}

function kt2Tur(){
  if(kt2Index >= turnuvaEslesmeler2.length){
    document.getElementById('kt2Asama').textContent = '';
    document.getElementById('kt2Eslesme').textContent = '';
    document.getElementById('kt2Secenekler').innerHTML = '';
    const sampiyon = turnuvaEslesmeler2[turnuvaEslesmeler2.length-1].dogruCevap;
    document.getElementById('kt2Sonuc').textContent = `🏆 Turnuva Şampiyonu: ${sampiyon}! Hakemlik doğruluğun: ${kt2DogruHakemlik}/${turnuvaEslesmeler2.length}`;
    return;
  }
  const mac = turnuvaEslesmeler2[kt2Index];
  document.getElementById('kt2Tur').textContent = kt2Index+1;
  document.getElementById('kt2Asama').textContent = mac.tur;
  document.getElementById('kt2Eslesme').innerHTML = `🥊 <b>${mac.a}</b> vs <b>${mac.b}</b><br>❓ ${mac.soru}`;
  const kutu = document.getElementById('kt2Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  [mac.a, mac.b].forEach(aday=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = aday;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      tiklandiMi = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(aday === mac.dogruCevap){
        btn.classList.add('dogru');
        kt2DogruHakemlik++;
        document.getElementById('kt2Puan').textContent = kt2DogruHakemlik;
      } else {
        btn.classList.add('yanlis');
        tumBtn.forEach(b=>{ if(b.textContent===mac.dogruCevap) b.classList.add('dogru'); });
      }
      kt2Index++;
      setTimeout(()=>kt2Tur(), 1300);
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// BONUS OYUN — Hafıza Zinciri
// =====================================================================
const bz2Tuslar = [
  {simge:"NAMAZ", renk:"#2a6f97"}, {simge:"EZAN", renk:"#40916c"},
  {simge:"ABDEST", renk:"#d62828"}, {simge:"KIBLE", renk:"#f4a261"},
  {simge:"SECDE", renk:"#1E3A8A"}, {simge:"RÜKÛ", renk:"#06B6D4"},
  {simge:"CEMAAT", renk:"#7c3aed"}, {simge:"İMAM", renk:"#be123c"},
  {simge:"HUŞU", renk:"#0f766e"}, {simge:"NİYET", renk:"#ea580c"},
  {simge:"FARZ", renk:"#2a6f97"}, {simge:"SÜNNET", renk:"#40916c"}
];
let bz2Sira = [], bz2KullaniciIndex = 0, bz2Seviye = 0, bz2Oynatiliyor = false;

function bz2IzgaraOlustur(){
  const izgara = document.getElementById('bz2Izgara');
  izgara.innerHTML = '';
  bz2Tuslar.forEach((t,i)=>{
    const tus = document.createElement('div');
    tus.className = 'bz-tus';
    tus.style.background = t.renk;
    tus.textContent = t.simge;
    tus.onclick = ()=>bz2TusaTikla(i);
    izgara.appendChild(tus);
  });
}
function bz2Baslat(){
  bz2Sira = []; bz2Seviye = 0; bz2KullaniciIndex = 0;
  document.getElementById('bz2Seviye').textContent = 0;
  document.getElementById('bz2Sonuc').textContent = '';
  bz2IzgaraOlustur();
  bz2SonrakiTur();
}
function bz2SonrakiTur(){
  bz2Seviye++;
  document.getElementById('bz2Seviye').textContent = bz2Seviye;
  bz2Sira.push(Math.floor(Math.random()*bz2Tuslar.length));
  bz2KullaniciIndex = 0;
  bz2Oynat();
}
function bz2Oynat(){
  bz2Oynatiliyor = true;
  const dugmeler = document.querySelectorAll('#bz2Izgara .bz-tus');
  dugmeler.forEach(d=>d.classList.add('bz-devre-disi'));
  let i = 0;
  const aralik = setInterval(()=>{
    if(i>0) dugmeler[bz2Sira[i-1]].classList.remove('bz-yanik');
    if(i>=bz2Sira.length){
      clearInterval(aralik);
      bz2Oynatiliyor = false;
      dugmeler.forEach(d=>d.classList.remove('bz-devre-disi'));
      return;
    }
    dugmeler[bz2Sira[i]].classList.add('bz-yanik');
    i++;
  }, 700);
}
function bz2TusaTikla(i){
  if(bz2Oynatiliyor) return;
  const dugmeler = document.querySelectorAll('#bz2Izgara .bz-tus');
  dugmeler[i].classList.add('bz-yanik');
  setTimeout(()=>dugmeler[i].classList.remove('bz-yanik'), 250);
  if(bz2Sira[bz2KullaniciIndex] === i){
    bz2KullaniciIndex++;
    if(bz2KullaniciIndex === bz2Sira.length){
      setTimeout(()=>bz2SonrakiTur(), 900);
    }
  } else {
    document.getElementById('bz2Sonuc').textContent = `💥 Yanlış sıra! En uzun hatırladığın zincir: ${bz2Seviye-1}`;
  }
}
function bz2OrnekOyna(){
  document.getElementById('bz2Sonuc').textContent = '🎬 Örnek gösteriliyor: önce sıra yanacak, sonra otomatik olarak aynı sırayla tıklanacak...';
  document.getElementById('bz2Seviye').textContent = 'Örnek';
  bz2IzgaraOlustur();
  const demoSira = [0, 2, 1];
  const dugmeler = document.querySelectorAll('#bz2Izgara .bz-tus');
  dugmeler.forEach(d=>d.classList.add('bz-devre-disi'));
  let i = 0;
  const gosterAralik = setInterval(()=>{
    if(i>0) dugmeler[demoSira[i-1]].classList.remove('bz-yanik');
    if(i >= demoSira.length){
      clearInterval(gosterAralik);
      let j = 0;
      const tiklaAralik = setInterval(()=>{
        if(j>0) dugmeler[demoSira[j-1]].classList.remove('bz-yanik');
        if(j >= demoSira.length){
          clearInterval(tiklaAralik);
          dugmeler.forEach(d=>d.classList.remove('bz-devre-disi'));
          document.getElementById('bz2Seviye').textContent = 0;
          document.getElementById('bz2Sonuc').textContent = '👆 Gördüğün gibi: önce kavramlar sırayla yandı, sonra aynı sırayla tıklandı. Şimdi sıra sende — "Oyunu Başlat"a bas!';
          return;
        }
        dugmeler[demoSira[j]].classList.add('bz-yanik');
        j++;
      }, 700);
      return;
    }
    dugmeler[demoSira[i]].classList.add('bz-yanik');
    i++;
  }, 700);
}

// =====================================================================
// KELİME AVI BULMACASI
// =====================================================================
const kelimeAvi2Listesi = [
  {kelime:"NAMAZ", anlam:"Allah'ın (cc) huzurunda kılınan ibadet"},
  {kelime:"EZAN", anlam:"Namaz vaktini bildiren çağrı"},
  {kelime:"ABDEST", anlam:"Namazdan önce yapılan temizlik"},
  {kelime:"KIBLE", anlam:"Namazda yönelinen yön"},
  {kelime:"SECDE", anlam:"Alnı yere koyma hareketi"},
  {kelime:"RÜKÛ", anlam:"Eğilerek yapılan hareket"},
  {kelime:"TEKBİR", anlam:"Namaza başlama sözü"},
  {kelime:"FATİHA", anlam:"Her rekâtta okunan sure"},
  {kelime:"CEMAAT", anlam:"Birlikte namaz kılan topluluk"},
  {kelime:"İMAM", anlam:"Namaz kıldıran kişi"},
  {kelime:"HUŞU", anlam:"Kalbin Allah'a (cc) yönelmesi"},
  {kelime:"NİYET", anlam:"İbadete kalpten karar vermek"},
  {kelime:"FARZ", anlam:"Kesin olarak emredilen ibadet"},
  {kelime:"SÜNNET", anlam:"Hz. Muhammed'in (sav) örnek davranışı"}
];
const ka2SatirSayisi = 14, ka2SutunSayisi = 14;
const ka2AsciiHarfler = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ";

function ka2KelimeYerlestir(izgara, kelime){
  const yonler = karistir([{dr:0,dc:1},{dr:0,dc:-1},{dr:1,dc:0},{dr:-1,dc:0}]);
  for(let deneme=0; deneme<200; deneme++){
    const yon = yonler[deneme % yonler.length];
    const satir = Math.floor(Math.random()*ka2SatirSayisi);
    const sutun = Math.floor(Math.random()*ka2SutunSayisi);
    const bitSatir = satir + yon.dr*(kelime.length-1);
    const bitSutun = sutun + yon.dc*(kelime.length-1);
    if(bitSatir<0 || bitSatir>=ka2SatirSayisi || bitSutun<0 || bitSutun>=ka2SutunSayisi) continue;
    let uygun = true;
    for(let i=0;i<kelime.length;i++){
      const r = satir + yon.dr*i, c = sutun + yon.dc*i;
      if(izgara[r][c] !== null && izgara[r][c] !== kelime[i]){ uygun=false; break; }
    }
    if(!uygun) continue;
    const hucreler=[];
    for(let i=0;i<kelime.length;i++){
      const r = satir + yon.dr*i, c = sutun + yon.dc*i;
      izgara[r][c] = kelime[i];
      hucreler.push({r,c});
    }
    return hucreler;
  }
  return null;
}

function kelimeAvi82Olustur(){
  let izgara, basarili=false;
  for(let genelDeneme=0; genelDeneme<40 && !basarili; genelDeneme++){
    izgara = Array.from({length:ka2SatirSayisi}, ()=>Array(ka2SutunSayisi).fill(null));
    basarili = true;
    const siraliKelimeler = kelimeAvi2Listesi.slice().sort((a,b)=>b.kelime.length-a.kelime.length);
    for(const item of siraliKelimeler){
      const hucreler = ka2KelimeYerlestir(izgara, item.kelime);
      if(!hucreler){ basarili=false; break; }
    }
  }
  for(let r=0;r<ka2SatirSayisi;r++){
    for(let c=0;c<ka2SutunSayisi;c++){
      if(izgara[r][c]===null) izgara[r][c] = ka2AsciiHarfler[Math.floor(Math.random()*ka2AsciiHarfler.length)];
    }
  }

  const kutu = document.getElementById('ka2Izgara');
  kutu.innerHTML = '';
  kutu.style.gridTemplateColumns = `repeat(${ka2SutunSayisi}, 1fr)`;
  const hucreElemanlari = [];
  for(let r=0;r<ka2SatirSayisi;r++){
    hucreElemanlari.push([]);
    for(let c=0;c<ka2SutunSayisi;c++){
      const h = document.createElement('div');
      h.className = 'ka-hucre';
      h.textContent = izgara[r][c];
      h.dataset.r = r; h.dataset.c = c;
      kutu.appendChild(h);
      hucreElemanlari[r].push(h);
    }
  }

  const liste = document.getElementById('ka2Liste');
  liste.innerHTML = '';
  kelimeAvi2Listesi.forEach(item=>{
    const li = document.createElement('li');
    li.id = 'ka2-kelime-' + item.kelime;
    li.textContent = `${item.kelime} — ${item.anlam}`;
    liste.appendChild(li);
  });
  document.getElementById('ka2Bulunan').textContent = 0;
  document.getElementById('ka2Toplam').textContent = kelimeAvi2Listesi.length;
  document.getElementById('ka2Sonuc').textContent = '';

  let ilkHucre = null;
  hucreElemanlari.flat().forEach(h=>{
    h.onclick = ()=>{
      if(h.classList.contains('ka-bulundu')) return;
      if(!ilkHucre){ ilkHucre = h; h.classList.add('ka-secili'); return; }
      if(ilkHucre === h){ ilkHucre.classList.remove('ka-secili'); ilkHucre=null; return; }
      const r1=+ilkHucre.dataset.r, c1=+ilkHucre.dataset.c;
      const r2=+h.dataset.r, c2=+h.dataset.c;
      let yol = [];
      if(r1===r2){
        const adim = c2>c1?1:-1;
        for(let c=c1;;c+=adim){ yol.push({r:r1,c}); if(c===c2) break; }
      } else if(c1===c2){
        const adim = r2>r1?1:-1;
        for(let r=r1;;r+=adim){ yol.push({r,c:c1}); if(r===r2) break; }
      } else {
        ilkHucre.classList.remove('ka-secili');
        h.classList.add('ka-secili');
        ilkHucre = h;
        return;
      }
      const secilenKelime = yol.map(p=>izgara[p.r][p.c]).join('');
      const tersKelime = secilenKelime.split('').reverse().join('');
      const eslesen = kelimeAvi2Listesi.find(item =>
        (item.kelime===secilenKelime || item.kelime===tersKelime) &&
        !document.getElementById('ka2-kelime-'+item.kelime).classList.contains('bulundu-satir')
      );
      if(eslesen){
        yol.forEach(p=>{
          hucreElemanlari[p.r][p.c].classList.remove('ka-secili');
          hucreElemanlari[p.r][p.c].classList.add('ka-bulundu');
        });
        document.getElementById('ka2-kelime-'+eslesen.kelime).classList.add('bulundu-satir');
        const bulunanSayisi = document.querySelectorAll('#ka2Liste .bulundu-satir').length;
        document.getElementById('ka2Bulunan').textContent = bulunanSayisi;
        if(bulunanSayisi === kelimeAvi2Listesi.length){
          document.getElementById('ka2Sonuc').textContent = '🎉 Tebrikler! Tüm kelimeleri buldun!';
        }
      } else {
        ilkHucre.classList.remove('ka-secili');
      }
      ilkHucre = null;
    };
  });
}

// =====================================================================
// ÇENGEL BULMACA
// =====================================================================
const cengel2Zinciri = [
  {kelime:"NAMAZ", anlam:"Allah'ın (cc) huzurunda kılınan ibadet"},
  {kelime:"ZİKİR", anlam:"Allah'ı (cc) anmak, hatırlamak"},
  {kelime:"RÜKÛ", anlam:"Namazda eğilerek yapılan hareket"},
  {kelime:"ÜMMET", anlam:"Bir peygambere inanan topluluk"},
  {kelime:"TESPİH", anlam:"Zikir çekmek için kullanılan boncuk dizisi"}
];
let cengel2HucreHarita = {}, cengel2InputMap = {};

function cengel2Olustur(){
  let r=0, c=0, dir='right';
  const yerlesimler = [];
  cengel2Zinciri.forEach(item=>{
    const kelime = item.kelime;
    const hucreler = [];
    for(let j=0;j<kelime.length;j++){
      hucreler.push(dir==='right' ? {r, c:c+j} : {r:r+j, c});
    }
    yerlesimler.push({...item, hucreler, dir});
    const son = hucreler[hucreler.length-1];
    r = son.r; c = son.c;
    dir = dir==='right' ? 'down' : 'right';
  });

  let minR=Infinity,maxR=-Infinity,minC=Infinity,maxC=-Infinity;
  yerlesimler.forEach(p=>p.hucreler.forEach(h=>{
    minR=Math.min(minR,h.r); maxR=Math.max(maxR,h.r);
    minC=Math.min(minC,h.c); maxC=Math.max(maxC,h.c);
  }));
  const satirSayisi = maxR-minR+1, sutunSayisi = maxC-minC+1;

  cengel2HucreHarita = {};
  yerlesimler.forEach(p=>{
    p.hucreler.forEach((h,i)=>{
      const key = (h.r-minR)+','+(h.c-minC);
      cengel2HucreHarita[key] = p.kelime[i];
    });
  });

  const siraliHucreler = [];
  const gorulen = new Set();
  yerlesimler.forEach((p, idx)=>{
    const baslangic = idx===0 ? 0 : 1;
    for(let i=baslangic;i<p.hucreler.length;i++){
      const h = p.hucreler[i];
      const key = (h.r-minR)+','+(h.c-minC);
      if(!gorulen.has(key)){ gorulen.add(key); siraliHucreler.push(key); }
    }
  });

  const izgara = document.getElementById('cengel2Izgara');
  izgara.innerHTML = '';
  izgara.style.gridTemplateColumns = `repeat(${sutunSayisi}, 34px)`;
  izgara.style.gridTemplateRows = `repeat(${satirSayisi}, 34px)`;
  cengel2InputMap = {};
  for(let rr=0; rr<satirSayisi; rr++){
    for(let cc=0; cc<sutunSayisi; cc++){
      const key = rr+','+cc;
      const hucreDiv = document.createElement('div');
      hucreDiv.style.gridColumn = (cc+1);
      hucreDiv.style.gridRow = (rr+1);
      if(cengel2HucreHarita[key] !== undefined){
        hucreDiv.className = 'cengel-hucre';
        const girdi = document.createElement('input');
        girdi.maxLength = 1;
        girdi.className = 'cengel-girdi';
        girdi.dataset.key = key;
        girdi.oninput = (e)=>{
          e.target.value = e.target.value.toLocaleUpperCase('tr-TR').slice(-1);
          e.target.classList.remove('dogru','yanlis');
          const idx = siraliHucreler.indexOf(key);
          if(idx>=0 && idx<siraliHucreler.length-1){
            const sonrakiKey = siraliHucreler[idx+1];
            if(cengel2InputMap[sonrakiKey]) cengel2InputMap[sonrakiKey].focus();
          }
        };
        hucreDiv.appendChild(girdi);
        cengel2InputMap[key] = girdi;
      } else {
        hucreDiv.className = 'cengel-bos';
      }
      izgara.appendChild(hucreDiv);
    }
  }

  const liste = document.getElementById('cengel2Liste');
  liste.innerHTML = '';
  yerlesimler.forEach((p, idx)=>{
    const li = document.createElement('li');
    li.textContent = `${idx+1}. ${p.dir==='right'?'➡️':'⬇️'} (${p.kelime.length} harf) ${p.anlam}`;
    liste.appendChild(li);
  });

  document.getElementById('cengel2Sonuc').textContent = '';
}

function cengel2KontrolEt(){
  let dogruSayisi=0, toplam=0;
  Object.keys(cengel2HucreHarita).forEach(key=>{
    toplam++;
    const girdi = cengel2InputMap[key];
    const beklenen = cengel2HucreHarita[key];
    if(girdi.value && girdi.value.toLocaleUpperCase('tr-TR') === beklenen.toLocaleUpperCase('tr-TR')){
      girdi.classList.add('dogru'); girdi.classList.remove('yanlis');
      dogruSayisi++;
    } else {
      girdi.classList.add('yanlis'); girdi.classList.remove('dogru');
    }
  });
  document.getElementById('cengel2Sonuc').textContent = dogruSayisi===toplam
    ? `🎉 Tebrikler! Çengel bulmacayı tamamen doğru çözdün! (${dogruSayisi}/${toplam})`
    : `Sonuç: ${dogruSayisi}/${toplam} doğru harf. Devam et!`;
}

// =====================================================================
// SÖZCÜK MERDİVENİ
// =====================================================================
const merdiven2Zinciri = [
  {kelime:"SECDE", anlam:"Alnı yere koyarak yapılan namaz hareketi"},
  {kelime:"EZAN", anlam:"Namaz vaktinin geldiğini bildiren çağrı"},
  {kelime:"NİYET", anlam:"İbadete kalpten karar vermek"},
  {kelime:"TEKBİR", anlam:"'Allahu ekber' diyerek namaza başlama"},
  {kelime:"RÜKÛ", anlam:"Namazda eğilerek yapılan hareket"}
];
const merdiven2Havuz = ["ABDEST","KIBLE","KIYAM","FATİHA","HUTBE","CEMAAT","İMAM","MÜEZZİN","TERAVİH","HUŞU","FARZ","VACİP","SÜNNET","NAFİLE","VİTİR","MESCİT","MİHRAP","MİNBER","SECCADE","TESPİH"];
let merdiven2Index = 0;

function merdiven2Baslat(){
  merdiven2Index = 0;
  document.getElementById('merdiven2Toplam').textContent = merdiven2Zinciri.length;
  document.getElementById('merdiven2Sonuc').textContent = '';
  document.getElementById('merdiven2Gorsel').innerHTML = '';
  merdiven2BasamakEkle(merdiven2Zinciri[0].kelime, 0);
  merdiven2Tur();
}
function merdiven2BasamakEkle(kelime, index){
  const basamak = document.createElement('div');
  basamak.style.background='white'; basamak.style.border='2px solid var(--yesil)'; basamak.style.borderRadius='10px';
  basamak.style.padding='8px 14px'; basamak.style.margin='6px 0'; basamak.style.fontWeight='bold';
  basamak.style.marginLeft = (index*24) + 'px';
  basamak.textContent = `${index+1}. ${kelime}`;
  document.getElementById('merdiven2Gorsel').appendChild(basamak);
}
function merdiven2Tur(){
  document.getElementById('merdiven2Basamak').textContent = merdiven2Index+1;
  if(merdiven2Index+1 >= merdiven2Zinciri.length){
    document.getElementById('merdiven2Ipucu').textContent = '';
    document.getElementById('merdiven2Secenekler').innerHTML = '';
    document.getElementById('merdiven2Sonuc').textContent = '🎉 Tebrikler! Sözcük merdivenini tamamen tırmandın!';
    return;
  }
  const oncekiKelime = merdiven2Zinciri[merdiven2Index].kelime;
  const hedef = merdiven2Zinciri[merdiven2Index+1];
  const gerekliHarf = oncekiKelime[oncekiKelime.length-1];
  document.getElementById('merdiven2Ipucu').innerHTML = `🗨️ İpucu: <b>${hedef.anlam}</b><br>Bu kelime "<b>${gerekliHarf}</b>" harfiyle başlamalı!`;
  const yanlisHavuz = karistir(merdiven2Havuz.filter(k=>k!==hedef.kelime)).slice(0,3);
  const secenekler = karistir([hedef.kelime, ...yanlisHavuz]);
  const kutu = document.getElementById('merdiven2Secenekler');
  kutu.innerHTML = '';
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = secenek;
    btn.onclick = ()=>{
      if(secenek === hedef.kelime){
        btn.classList.add('dogru');
        merdiven2Index++;
        setTimeout(()=>{ merdiven2BasamakEkle(hedef.kelime, merdiven2Index); merdiven2Tur(); }, 700);
      } else {
        btn.classList.add('yanlis');
        setTimeout(()=>btn.classList.remove('yanlis'), 400);
      }
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// ŞİFRELİ SÖZCÜK
// =====================================================================
const turkAlfabesi82 = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ".split('');
let sifre2Anahtari = {};

function sifre2Olustur(){
  const sayilar = karistir(turkAlfabesi82.map((_,i)=>i+1));
  sifre2Anahtari = {};
  turkAlfabesi82.forEach((harf,i)=>{ sifre2Anahtari[harf] = sayilar[i]; });

  const anahtarKutu = document.getElementById('sifre2Anahtar');
  anahtarKutu.innerHTML = '';
  turkAlfabesi82.forEach(harf=>{
    const hucre = document.createElement('div');
    hucre.className = 'sifre-anahtar-hucre';
    hucre.innerHTML = `<b>${harf}</b><br>${sifre2Anahtari[harf]}`;
    anahtarKutu.appendChild(hucre);
  });

  const kutu = document.getElementById('sifre2Kelimeler');
  kutu.innerHTML = '';
  document.getElementById('sifre2Sonuc').textContent = '';

  kelimeHavuzu2.slice(0,20).forEach(item=>{
    const satir = document.createElement('div');
    satir.className = 'sifre-satir';
    const anlamP = document.createElement('p');
    anlamP.className = 'sifre-ipucu';
    anlamP.textContent = `💡 ${item.anlam}`;
    satir.appendChild(anlamP);

    const kutucuklar = document.createElement('div');
    kutucuklar.className = 'sifre-kutucuklar';
    const harfler = item.kelime.split('');
    const girdiler = [];
    harfler.forEach((harf)=>{
      const grup = document.createElement('div');
      grup.className = 'sifre-grup';
      const sayiEtiket = document.createElement('div');
      sayiEtiket.className = 'sifre-sayi';
      sayiEtiket.textContent = sifre2Anahtari[harf];
      const girdi = document.createElement('input');
      girdi.maxLength = 1;
      girdi.className = 'sifre-girdi';
      girdi.dataset.beklenen = harf;
      grup.appendChild(sayiEtiket);
      grup.appendChild(girdi);
      kutucuklar.appendChild(grup);
      girdiler.push(girdi);
    });
    girdiler.forEach((girdi, hIdx)=>{
      girdi.oninput = (e)=>{
        e.target.value = e.target.value.toLocaleUpperCase('tr-TR').slice(-1);
        e.target.classList.remove('dogru','yanlis');
        if(girdiler[hIdx+1]) girdiler[hIdx+1].focus();
      };
    });
    satir.appendChild(kutucuklar);
    kutu.appendChild(satir);
  });
}

function sifre2KontrolEt(){
  const girdiler = document.querySelectorAll('#sifre2Kelimeler .sifre-girdi');
  let dogruSayisi=0;
  girdiler.forEach(g=>{
    const beklenen = g.dataset.beklenen;
    if(g.value && g.value.toLocaleUpperCase('tr-TR') === beklenen.toLocaleUpperCase('tr-TR')){
      g.classList.add('dogru'); g.classList.remove('yanlis');
      dogruSayisi++;
    } else {
      g.classList.add('yanlis'); g.classList.remove('dogru');
    }
  });
  document.getElementById('sifre2Sonuc').textContent = dogruSayisi===girdiler.length
    ? `🎉 Tebrikler! Tüm şifreleri doğru çözdün! (${dogruSayisi}/${girdiler.length})`
    : `Sonuç: ${dogruSayisi}/${girdiler.length} doğru harf. Anahtar tablosuna bakarak devam et!`;
}

// =====================================================================
// ŞİFRELİ TANIM
// =====================================================================
const st2LeetHarita = {'a':'4','A':'4','e':'3','E':'3','i':'1','I':'1','İ':'1','ı':'1','o':'0','O':'0'};
function st2TanimSifrele(metin){
  return metin.split('').map(ch => st2LeetHarita[ch] !== undefined ? st2LeetHarita[ch] : ch).join('');
}
let st2Index = 0, st2Puan = 0, st2Sira = [];

function st2Baslat(){
  st2Sira = karistir(kelimeHavuzu2.slice());
  st2Index = 0; st2Puan = 0;
  document.getElementById('st2Puan').textContent = 0;
  document.getElementById('st2Toplam').textContent = st2Sira.length;
  document.getElementById('st2Sonuc').textContent = '';
  st2Tur();
}
function st2Tur(){
  if(st2Index >= st2Sira.length){
    document.getElementById('st2Tanim').textContent = '';
    document.getElementById('st2Secenekler').innerHTML = '';
    document.getElementById('st2Sonuc').textContent = `🏆 Tebrikler! ${st2Puan}/${st2Sira.length} şifreli tanımı doğru çözdün!`;
    return;
  }
  document.getElementById('st2Tur').textContent = st2Index+1;
  const oge = st2Sira[st2Index];
  document.getElementById('st2Tanim').textContent = st2TanimSifrele(oge.anlam);
  const digerler = karistir(kelimeHavuzu2.filter(x=>x.kelime!==oge.kelime)).slice(0,3);
  const secenekler = karistir([oge, ...digerler]);
  const kutu = document.getElementById('st2Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.style.display='block'; btn.style.width='100%'; btn.style.marginBottom='6px';
    btn.textContent = secenek.kelime;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      tiklandiMi = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(secenek.kelime === oge.kelime){
        btn.classList.add('dogru');
        st2Puan++;
        document.getElementById('st2Puan').textContent = st2Puan;
      } else {
        btn.classList.add('yanlis');
        tumBtn.forEach(b=>{ if(b.textContent===oge.kelime) b.classList.add('dogru'); });
      }
      st2Index++;
      setTimeout(()=>st2Tur(), 900);
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// KELİME KODLAMA
// =====================================================================
const kk2Alfabe = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ".split('');
const kk2KodTablosu = {};
kk2Alfabe.forEach((harf,i)=>{ kk2KodTablosu[harf] = (i+1).toString(2).padStart(5,'0'); });
function kk2KelimeyiKodla(kelime){
  return kelime.split('').map(h => kk2KodTablosu[h] || '?????').join(' ');
}
let kk2Index = 0, kk2Puan = 0, kk2Sira = [];

function kk2AnahtarOlustur(){
  const kutu = document.getElementById('kk2Anahtar');
  kutu.innerHTML = '';
  kk2Alfabe.forEach(harf=>{
    const hucre = document.createElement('div');
    hucre.className = 'sifre-anahtar-hucre';
    hucre.innerHTML = `<b>${harf}</b><br>${kk2KodTablosu[harf]}`;
    kutu.appendChild(hucre);
  });
}
function kk2Baslat(){
  kk2AnahtarOlustur();
  kk2Sira = karistir(kelimeHavuzu2.slice());
  kk2Index = 0; kk2Puan = 0;
  document.getElementById('kk2Puan').textContent = 0;
  document.getElementById('kk2Toplam').textContent = kk2Sira.length;
  document.getElementById('kk2Sonuc').textContent = '';
  kk2Tur();
}
function kk2Tur(){
  if(kk2Index >= kk2Sira.length){
    document.getElementById('kk2Kod').textContent = '';
    document.getElementById('kk2Ipucu').textContent = '';
    document.getElementById('kk2Secenekler').innerHTML = '';
    document.getElementById('kk2Sonuc').textContent = `🏆 Tebrikler! ${kk2Puan}/${kk2Sira.length} kodu doğru çözdün!`;
    return;
  }
  document.getElementById('kk2Tur').textContent = kk2Index+1;
  const oge = kk2Sira[kk2Index];
  document.getElementById('kk2Ipucu').innerHTML = `💡 İpucu: <b>${oge.anlam}</b>`;
  document.getElementById('kk2Kod').textContent = kk2KelimeyiKodla(oge.kelime);
  const digerler = karistir(kelimeHavuzu2.filter(x=>x.kelime!==oge.kelime)).slice(0,3);
  const secenekler = karistir([oge, ...digerler]);
  const kutu = document.getElementById('kk2Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.style.display='block'; btn.style.width='100%'; btn.style.marginBottom='6px';
    btn.textContent = secenek.kelime;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      tiklandiMi = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(secenek.kelime === oge.kelime){
        btn.classList.add('dogru');
        kk2Puan++;
        document.getElementById('kk2Puan').textContent = kk2Puan;
      } else {
        btn.classList.add('yanlis');
        tumBtn.forEach(b=>{ if(b.textContent===oge.kelime) b.classList.add('dogru'); });
      }
      kk2Index++;
      setTimeout(()=>kk2Tur(), 1000);
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// NONOGRAM
// =====================================================================
const nonogram2Resimleri = {
  camii: { etiket: "🕌 Cami (İbadet Yeri)", veri: [
    "0000000110000000","0000001111000000","0000011111100000","0000111111110000",
    "0001111111111000","0011111111111100","0111111111111110","0000001111000000",
    "0000001111000000","0000001111000000","0000001111000000","0111111111111110",
    "0111111111111110","0111100000011110","0111100000011110","1111111111111111"
  ]},
  seccade: { etiket: "🟩 Seccade (Namaz Halısı)", veri: [
    "0000000000000000","0111111111111110","0100000000000010","0100111111110010",
    "0100100000010010","0100101111010010","0100100000010010","0100111111110010",
    "0100000000000010","0100000000000010","0111111111111110","0000000000000000",
    "0000000000000000","0000000000000000","0000000000000000","0000000000000000"
  ]}
};
let nonogram2AktifResim = 'camii';
const nono2Boyut = nonogram2Resimleri.camii.veri.length;
let nono2KullaniciIzgara = [];
let nono2HucreElemanlari = [];

function ipucu82Hesapla(diziStr){
  const gruplar = diziStr.split('0').filter(s=>s.length>0).map(s=>s.length);
  return gruplar.length ? gruplar : [0];
}
function nonogram2Sec(resimAdi){ nonogram2AktifResim = resimAdi; nonogram2Olustur(); }
function nonogram2Olustur(){
  const cozum = nonogram2Resimleri[nonogram2AktifResim].veri;
  nono2KullaniciIzgara = Array.from({length:nono2Boyut}, ()=>Array(nono2Boyut).fill(false));
  document.getElementById('nono2Sonuc').textContent = '';
  const satirIpuclari = cozum.map(r=>ipucu82Hesapla(r));
  const sutunDizeleri = [];
  for(let c=0;c<nono2Boyut;c++){
    let s='';
    for(let r=0;r<nono2Boyut;r++) s += cozum[r][c];
    sutunDizeleri.push(s);
  }
  const sutunIpuclari = sutunDizeleri.map(s=>ipucu82Hesapla(s));
  const tablo = document.getElementById('nono2Tablo');
  tablo.innerHTML = '';
  const basSatir = document.createElement('tr');
  const koseTd = document.createElement('td');
  basSatir.appendChild(koseTd);
  for(let c=0;c<nono2Boyut;c++){
    const td = document.createElement('td');
    td.className = 'nono-sutun-ipucu';
    sutunIpuclari[c].forEach((sayi,i)=>{
      if(i>0) td.appendChild(document.createElement('br'));
      td.appendChild(document.createTextNode(sayi));
    });
    if((c+1)%5===0 && c<nono2Boyut-1) td.style.borderRight = '2px solid #333';
    basSatir.appendChild(td);
  }
  tablo.appendChild(basSatir);
  nono2HucreElemanlari = [];
  for(let r=0;r<nono2Boyut;r++){
    const tr = document.createElement('tr');
    const satirTd = document.createElement('td');
    satirTd.className = 'nono-satir-ipucu';
    satirTd.textContent = satirIpuclari[r].join(' ');
    if((r+1)%5===0 && r<nono2Boyut-1) satirTd.style.borderBottom = '2px solid #333';
    tr.appendChild(satirTd);
    nono2HucreElemanlari.push([]);
    for(let c=0;c<nono2Boyut;c++){
      const td = document.createElement('td');
      td.className = 'nono-hucre';
      if((c+1)%5===0 && c<nono2Boyut-1) td.style.borderRight = '2px solid #333';
      if((r+1)%5===0 && r<nono2Boyut-1) td.style.borderBottom = '2px solid #333';
      td.onclick = ((rr,cc)=>()=>{
        nono2KullaniciIzgara[rr][cc] = !nono2KullaniciIzgara[rr][cc];
        td.classList.toggle('dolu', nono2KullaniciIzgara[rr][cc]);
        nonogram2KontrolEt(false);
      })(r,c);
      tr.appendChild(td);
      nono2HucreElemanlari[r].push(td);
    }
    tablo.appendChild(tr);
  }
}
function nonogram2KontrolEt(manuel){
  const cozum = nonogram2Resimleri[nonogram2AktifResim].veri;
  let tamMi = true;
  for(let r=0;r<nono2Boyut;r++){
    for(let c=0;c<nono2Boyut;c++){
      const beklenen = cozum[r][c] === '1';
      if(nono2KullaniciIzgara[r][c] !== beklenen) tamMi = false;
    }
  }
  if(tamMi){
    document.getElementById('nono2Sonuc').textContent = `🎉 Tebrikler! Gizli resmi (${nonogram2Resimleri[nonogram2AktifResim].etiket}) doğru tamamladın!`;
  } else if(manuel){
    document.getElementById('nono2Sonuc').textContent = 'Henüz tam değil, ipuçlarına bakarak devam et!';
  }
}
function nonogram2Temizle(){
  nono2KullaniciIzgara = Array.from({length:nono2Boyut}, ()=>Array(nono2Boyut).fill(false));
  nono2HucreElemanlari.forEach(satir=>satir.forEach(td=>td.classList.remove('dolu')));
  document.getElementById('nono2Sonuc').textContent = '';
}

// =====================================================================
// KELİME SATRANCI
// =====================================================================
const ks2Boyut = 8;
const ks2AtHamleleri = [[1,2],[1,-2],[-1,2],[-1,-2],[2,1],[2,-1],[-2,1],[-2,-1]];
const ks2KelimeListesi = [
  {kelime:"NAMAZ", anlam:"Allah'ın (cc) huzurunda kılınan ibadet"},
  {kelime:"EZAN", anlam:"Namaz vaktini bildiren çağrı"},
  {kelime:"KIBLE", anlam:"Namazda yönelinen yön"},
  {kelime:"İMAM", anlam:"Namaz kıldıran kişi"},
  {kelime:"HUŞU", anlam:"Kalbin Allah'a (cc) yönelmesi"},
  {kelime:"FARZ", anlam:"Kesin olarak emredilen ibadet"},
  {kelime:"VİTİR", anlam:"Yatsıdan sonra kılınan vacip namaz"},
  {kelime:"NİYET", anlam:"İbadete kalpten karar vermek"}
];
const ks2AsciiHarfler = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ";
let ks2IzgaraVeri = [];
let ks2HucreElemanlari = [];
let ks2BulunanKelimeler = new Set();
let ks2Yol = [];

function ks2KelimeYerlestir(izgara, kelime){
  for(let deneme=0; deneme<300; deneme++){
    const gecici = izgara.map(satir=>satir.slice());
    const r0 = Math.floor(Math.random()*ks2Boyut);
    const c0 = Math.floor(Math.random()*ks2Boyut);
    if(gecici[r0][c0] !== null && gecici[r0][c0] !== kelime[0]) continue;
    gecici[r0][c0] = kelime[0];
    const hucreler = [{r:r0,c:c0}];
    const kullanilan = new Set([r0+','+c0]);
    let r=r0, c=c0, basarili=true;
    for(let i=1;i<kelime.length;i++){
      const olasilar = karistir(ks2AtHamleleri.slice()).filter(([dr,dc])=>{
        const nr=r+dr, nc=c+dc;
        if(nr<0 || nr>=ks2Boyut || nc<0 || nc>=ks2Boyut) return false;
        if(kullanilan.has(nr+','+nc)) return false;
        return gecici[nr][nc]===null || gecici[nr][nc]===kelime[i];
      });
      if(olasilar.length===0){ basarili=false; break; }
      const [dr,dc] = olasilar[0];
      r+=dr; c+=dc;
      gecici[r][c] = kelime[i];
      hucreler.push({r,c});
      kullanilan.add(r+','+c);
    }
    if(basarili){
      hucreler.forEach((h,i)=>{ izgara[h.r][h.c] = kelime[i]; });
      return hucreler;
    }
  }
  return null;
}
function ks2Olustur(){
  let izgara, basarili=false;
  for(let genelDeneme=0; genelDeneme<40 && !basarili; genelDeneme++){
    izgara = Array.from({length:ks2Boyut}, ()=>Array(ks2Boyut).fill(null));
    basarili = true;
    const siraliKelimeler = ks2KelimeListesi.slice().sort((a,b)=>b.kelime.length-a.kelime.length);
    for(const item of siraliKelimeler){
      const hucreler = ks2KelimeYerlestir(izgara, item.kelime);
      if(!hucreler){ basarili=false; break; }
    }
  }
  for(let r=0;r<ks2Boyut;r++){
    for(let c=0;c<ks2Boyut;c++){
      if(izgara[r][c]===null) izgara[r][c] = ks2AsciiHarfler[Math.floor(Math.random()*ks2AsciiHarfler.length)];
    }
  }
  ks2IzgaraVeri = izgara;
  ks2BulunanKelimeler = new Set();
  ks2Yol = [];
  const kutu = document.getElementById('ks2Izgara');
  kutu.innerHTML = '';
  ks2HucreElemanlari = [];
  for(let r=0;r<ks2Boyut;r++){
    ks2HucreElemanlari.push([]);
    for(let c=0;c<ks2Boyut;c++){
      const h = document.createElement('div');
      h.className = 'ks-hucre ' + ((r+c)%2===0 ? 'acik' : 'koyu');
      h.textContent = izgara[r][c];
      h.onclick = ()=>ks2Tikla(r,c);
      kutu.appendChild(h);
      ks2HucreElemanlari[r].push(h);
    }
  }
  const liste = document.getElementById('ks2Liste');
  liste.innerHTML = '';
  ks2KelimeListesi.forEach(item=>{
    const li = document.createElement('li');
    li.id = 'ks2-kelime-' + item.kelime;
    li.textContent = `${item.kelime} — ${item.anlam}`;
    liste.appendChild(li);
  });
  document.getElementById('ks2Bulunan').textContent = 0;
  document.getElementById('ks2Toplam').textContent = ks2KelimeListesi.length;
  document.getElementById('ks2Sonuc').textContent = '';
}
function ks2SecimiTemizle(){
  ks2Yol.forEach(p=>ks2HucreElemanlari[p.r][p.c].classList.remove('ks-secili'));
  ks2Yol = [];
}
function ks2Tikla(r,c){
  const hucreEl = ks2HucreElemanlari[r][c];
  if(hucreEl.classList.contains('ks-bulundu')) return;
  let yeniYol;
  if(ks2Yol.length===0){ yeniYol = [{r,c}]; }
  else {
    const son = ks2Yol[ks2Yol.length-1];
    const gecerliHamle = ks2AtHamleleri.some(([hr,hc]) => son.r+hr===r && son.c+hc===c);
    yeniYol = gecerliHamle ? [...ks2Yol, {r,c}] : [{r,c}];
  }
  const dizi = yeniYol.map(p=>ks2IzgaraVeri[p.r][p.c]).join('');
  const tamEslesen = ks2KelimeListesi.find(item => item.kelime===dizi && !ks2BulunanKelimeler.has(item.kelime));
  const onEkMi = ks2KelimeListesi.some(item => !ks2BulunanKelimeler.has(item.kelime) && item.kelime.startsWith(dizi));
  ks2Yol.forEach(p=>ks2HucreElemanlari[p.r][p.c].classList.remove('ks-secili'));
  if(tamEslesen){
    yeniYol.forEach(p=>ks2HucreElemanlari[p.r][p.c].classList.add('ks-bulundu'));
    ks2BulunanKelimeler.add(tamEslesen.kelime);
    document.getElementById('ks2Bulunan').textContent = ks2BulunanKelimeler.size;
    document.getElementById('ks2-kelime-'+tamEslesen.kelime).classList.add('bulundu-satir');
    ks2Yol = [];
    if(ks2BulunanKelimeler.size === ks2KelimeListesi.length){
      document.getElementById('ks2Sonuc').textContent = '🎉 Tebrikler! Tüm kelimeleri at hamlesiyle buldun!';
    }
  } else if(onEkMi){
    yeniYol.forEach(p=>ks2HucreElemanlari[p.r][p.c].classList.add('ks-secili'));
    ks2Yol = yeniYol;
  } else {
    const tekBaslangicUygun = ks2KelimeListesi.some(item => !ks2BulunanKelimeler.has(item.kelime) && item.kelime[0]===ks2IzgaraVeri[r][c]);
    if(tekBaslangicUygun){ ks2Yol = [{r,c}]; hucreEl.classList.add('ks-secili'); }
    else { ks2Yol = []; }
  }
}

// =====================================================================
// KELİME DEDEKTİFİ
// =====================================================================
const dd2KelimeHavuzu = kelimeHavuzu2.filter(x => x.kelime.length>=5 && x.kelime.length<=8);
let dd2Hedef = null, dd2Deneme = 0;
const dd2MaxDeneme = 5, dd2IpucuAcilmaSiniri = 2;
let dd2Bitti = true, dd2SiraliVakalar = [], dd2VakaIndex = 0, dd2CozulenSayisi = 0;

function dd2Baslat(){
  dd2SiraliVakalar = karistir(dd2KelimeHavuzu.slice());
  dd2VakaIndex = 0; dd2CozulenSayisi = 0;
  document.getElementById('dd2Cozulen').textContent = 0;
  document.getElementById('dd2ToplamVaka').textContent = dd2SiraliVakalar.length;
  document.getElementById('dd2MaxDeneme').textContent = dd2MaxDeneme;
  dd2VakaBaslat();
}
function dd2VakaBaslat(){
  if(dd2VakaIndex >= dd2SiraliVakalar.length){
    document.getElementById('dd2Ipucu').textContent = '';
    document.getElementById('dd2Izgara').innerHTML = '';
    document.getElementById('dd2Girdi').disabled = true;
    document.getElementById('dd2Sonuc').textContent = `🏆 Tüm vakalar bitti! ${dd2CozulenSayisi}/${dd2SiraliVakalar.length} vakayı çözdün!`;
    return;
  }
  document.getElementById('dd2Vaka').textContent = dd2VakaIndex+1;
  dd2Hedef = dd2SiraliVakalar[dd2VakaIndex];
  dd2Deneme = 0; dd2Bitti = false;
  document.getElementById('dd2Ipucu').innerHTML = `🔍 Vaka: <b>${dd2Hedef.kelime.length} harfli</b> bir kavram (anlamı ${dd2IpucuAcilmaSiniri} yanlış tahminden sonra açılacak!)`;
  document.getElementById('dd2Deneme').textContent = 0;
  document.getElementById('dd2Izgara').innerHTML = '';
  document.getElementById('dd2Sonuc').textContent = '';
  document.getElementById('dd2Uyari').textContent = '';
  const girdi = document.getElementById('dd2Girdi');
  girdi.value = ''; girdi.disabled = false; girdi.maxLength = dd2Hedef.kelime.length; girdi.focus();
}
function dd2TahminEt(){
  if(dd2Bitti) return;
  const girdi = document.getElementById('dd2Girdi');
  const tahmin = girdi.value.trim().toLocaleUpperCase('tr-TR');
  if(tahmin.length !== dd2Hedef.kelime.length){
    document.getElementById('dd2Uyari').textContent = `Tahminin ${dd2Hedef.kelime.length} harfli olmalı!`;
    return;
  }
  document.getElementById('dd2Uyari').textContent = '';
  const hedefHarfler = dd2Hedef.kelime.split('');
  const tahminHarfler = tahmin.split('');
  const durumlar = new Array(tahminHarfler.length).fill('yok');
  const kullanilan = new Array(hedefHarfler.length).fill(false);
  tahminHarfler.forEach((h,i)=>{ if(h === hedefHarfler[i]){ durumlar[i]='dogru-yer'; kullanilan[i]=true; } });
  tahminHarfler.forEach((h,i)=>{
    if(durumlar[i]==='dogru-yer') return;
    const idx = hedefHarfler.findIndex((hh,j)=> hh===h && !kullanilan[j]);
    if(idx!==-1){ durumlar[i]='yanlis-yer'; kullanilan[idx]=true; }
  });
  const satir = document.createElement('div');
  satir.className = 'dd-satir';
  tahminHarfler.forEach((h,i)=>{
    const kutu = document.createElement('div');
    kutu.className = 'dd-kutu ' + durumlar[i];
    kutu.textContent = h;
    satir.appendChild(kutu);
  });
  document.getElementById('dd2Izgara').appendChild(satir);
  dd2Deneme++;
  document.getElementById('dd2Deneme').textContent = dd2Deneme;
  girdi.value = '';
  if(tahmin === dd2Hedef.kelime){
    dd2Bitti = true; girdi.disabled = true;
    dd2CozulenSayisi++;
    document.getElementById('dd2Cozulen').textContent = dd2CozulenSayisi;
    document.getElementById('dd2Ipucu').innerHTML = `🔍 İpucu: <b>${dd2Hedef.anlam}</b> (${dd2Hedef.kelime.length} harfli)`;
    document.getElementById('dd2Sonuc').textContent = `🎉 Vaka çözüldü! Kelime: ${dd2Hedef.kelime} (${dd2Deneme} denemede)`;
    dd2VakaIndex++;
    setTimeout(()=>dd2VakaBaslat(), 1500);
  } else if(dd2Deneme >= dd2MaxDeneme){
    dd2Bitti = true; girdi.disabled = true;
    document.getElementById('dd2Ipucu').innerHTML = `🔍 İpucu: <b>${dd2Hedef.anlam}</b> (${dd2Hedef.kelime.length} harfli)`;
    document.getElementById('dd2Sonuc').textContent = `🔍 Vaka çözülemedi! Doğru kelime: ${dd2Hedef.kelime} — ${dd2Hedef.anlam}`;
    dd2VakaIndex++;
    setTimeout(()=>dd2VakaBaslat(), 2200);
  } else if(dd2Deneme >= dd2IpucuAcilmaSiniri){
    document.getElementById('dd2Ipucu').innerHTML = `🔍 İpucu açıldı: <b>${dd2Hedef.anlam}</b> (${dd2Hedef.kelime.length} harfli)`;
  }
}

// =====================================================================
// DİL DEDEKTİFİ
// =====================================================================
const dilDedektifi2Listesi = [
  {dogru:"Namaz, Allah'ın (cc) huzurunda belirli hareket ve sözlerle yapılan bir ibadettir.", yanlislar:["Namaz sadece camide kılınabilir.","Namaz yılda bir kez kılınır.","Namaz sadece yetişkinlere farzdır ve çocuklar kılamaz."]},
  {dogru:"Abdestsiz namaz kılınamaz.", yanlislar:["Abdest sadece Cuma günü gereklidir.","Abdest almadan da namaz kılınabilir.","Abdest yalnızca elleri yıkamaktır."]},
  {dogru:"Müslümanlar namazda Kâbe'ye, yani kıbleye yönelir.", yanlislar:["Namazda herhangi bir yöne dönülebilir.","Kıble her ülkede farklı bir anlam taşımaz, herkes güneşe döner.","Kıble sadece Mekke'de yaşayanlar için geçerlidir."]},
  {dogru:"Günde beş vakit namaz kılmak farzdır.", yanlislar:["Günde üç vakit namaz kılmak farzdır.","Namaz kılmak isteğe bağlıdır.","Namaz sadece Cuma günleri farzdır."]},
  {dogru:"Ezan, namaz vaktinin geldiğini bildirmek için okunur.", yanlislar:["Ezan sadece bayramlarda okunur.","Ezan namazdan sonra okunur.","Ezan yalnızca sabah okunur."]},
  {dogru:"Cuma namazı cemaatle kılınan, hutbeli bir namazdır.", yanlislar:["Cuma namazı evde tek başına kılınır.","Cuma namazının hutbesi yoktur.","Cuma namazı sadece kadınlara farzdır."]}
];
let ddl2Index = 0, ddl2Puan = 0, ddl2Sira = [];

function ddl2Baslat(){
  ddl2Sira = karistir(dilDedektifi2Listesi.slice());
  ddl2Index = 0; ddl2Puan = 0;
  document.getElementById('ddl2Puan').textContent = 0;
  document.getElementById('ddl2Toplam').textContent = ddl2Sira.length;
  document.getElementById('ddl2Sonuc').textContent = '';
  ddl2Tur();
}
function ddl2Tur(){
  if(ddl2Index >= ddl2Sira.length){
    document.getElementById('ddl2Secenekler').innerHTML = '';
    document.getElementById('ddl2Baslik').textContent = '';
    document.getElementById('ddl2Sonuc').textContent = `🕵️ Soruşturma bitti! ${ddl2Puan}/${ddl2Sira.length} doğru bilgiyi tespit ettin!`;
    return;
  }
  document.getElementById('ddl2Tur').textContent = ddl2Index+1;
  const oge = ddl2Sira[ddl2Index];
  document.getElementById('ddl2Baslik').textContent = '🔎 Hangi cümle DOĞRU bilgi veriyor?';
  const secenekler = karistir([{metin:oge.dogru, dogruMu:true}, ...oge.yanlislar.map(y=>({metin:y, dogruMu:false}))]);
  const kutu = document.getElementById('ddl2Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = secenek.metin;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      tiklandiMi = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(secenek.dogruMu){
        btn.classList.add('dogru');
        ddl2Puan++;
        document.getElementById('ddl2Puan').textContent = ddl2Puan;
      } else {
        btn.classList.add('yanlis');
        tumBtn.forEach(b=>{ if(b.textContent === oge.dogru) b.classList.add('dogru'); });
      }
      ddl2Index++;
      setTimeout(()=>ddl2Tur(), 1200);
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// MANTIK ZİNCİRİ
// =====================================================================
const mantikZinciri2 = [
  {kavram:"NAMAZ", tanim:"Allah'ın (cc) huzurunda belirli hareket ve sözlerle yapılan ibadet", mantik:"Namaz vaktinin geldiğini bildiren çağrıya ne denir?"},
  {kavram:"EZAN", tanim:"Namaz vaktinin geldiğini bildiren dini çağrı", mantik:"Namazdan önce yapılan dini temizliğe ne denir?"},
  {kavram:"ABDEST", tanim:"Namazdan önce yapılan dini temizlik", mantik:"Namazda yönelinen yöne ne denir?"},
  {kavram:"KIBLE", tanim:"Namazda yönelinen Kâbe yönü", mantik:"Alnı yere koyarak yapılan namaz hareketine ne denir?"},
  {kavram:"SECDE", tanim:"Alnı yere koyarak Allah'a (cc) en yakın olunan namaz hareketi", mantik:""}
];
let mz2Index = 0;

function mz2Baslat(){
  mz2Index = 0;
  document.getElementById('mz2Toplam').textContent = mantikZinciri2.length;
  document.getElementById('mz2Sonuc').textContent = '';
  document.getElementById('mz2Gorsel').innerHTML = '';
  mz2HalkaEkle(mantikZinciri2[0].kavram, 0);
  mz2Tur();
}
function mz2HalkaEkle(kavram, index){
  const halka = document.createElement('div');
  halka.style.background='white'; halka.style.border='2px solid var(--yesil)'; halka.style.borderRadius='10px';
  halka.style.padding='8px 14px'; halka.style.margin='6px 0'; halka.style.fontWeight='bold';
  halka.style.marginLeft = (index*24) + 'px';
  halka.textContent = `${index+1}. ${kavram}`;
  document.getElementById('mz2Gorsel').appendChild(halka);
}
function mz2Tur(){
  document.getElementById('mz2Halka').textContent = mz2Index+1;
  if(mz2Index+1 >= mantikZinciri2.length){
    document.getElementById('mz2Soru').textContent = '';
    document.getElementById('mz2Secenekler').innerHTML = '';
    document.getElementById('mz2Sonuc').textContent = '🎉 Tebrikler! Mantık zincirini tamamen çözdün!';
    return;
  }
  const mevcut = mantikZinciri2[mz2Index];
  const hedef = mantikZinciri2[mz2Index+1];
  document.getElementById('mz2Soru').innerHTML = `🔗 <b>${mevcut.kavram}</b>: ${mevcut.tanim}<br>❓ ${mevcut.mantik}`;
  const havuzDistractor = karistir(kelimeHavuzu2.filter(x => x.kelime!==hedef.kavram && !mantikZinciri2.some(z=>z.kavram===x.kelime))).slice(0,3);
  const secenekler = karistir([{kelime:hedef.kavram}, ...havuzDistractor]);
  const kutu = document.getElementById('mz2Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = secenek.kelime;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      if(secenek.kelime === hedef.kavram){
        tiklandiMi = true;
        btn.classList.add('dogru');
        mz2Index++;
        setTimeout(()=>{ mz2HalkaEkle(hedef.kavram, mz2Index); mz2Tur(); }, 700);
      } else {
        btn.classList.add('yanlis');
        setTimeout(()=>btn.classList.remove('yanlis'), 400);
      }
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// SEMANTİK LABİRENT
// =====================================================================
const semantikOdalar2 = [
  {kategori:"NAMAZ HAREKETLERİ", kelimeler:["KIYAM","RÜKÛ","SECDE","EZAN"], oddKelime:"EZAN"},
  {kategori:"NAMAZLA İLGİLİ KİŞİLER", kelimeler:["İMAM","MÜEZZİN","CEMAAT","VİTİR"], oddKelime:"VİTİR"},
  {kategori:"CAMİ İLE İLGİLİ KAVRAMLAR", kelimeler:["MİHRAP","MİNBER","MESCİT","HUŞU"], oddKelime:"HUŞU"},
  {kategori:"İBADET ÇEŞİTLERİ", kelimeler:["FARZ","VACİP","SÜNNET","SECCADE"], oddKelime:"SECCADE"}
];
let sz2OdaIndex = 0, sz2Can = 3;

function sz2CanGoster(){ document.getElementById('sz2Can').textContent = '❤️'.repeat(Math.max(sz2Can,0)) + '🖤'.repeat(Math.max(3-sz2Can,0)); }
function sz2Baslat(){
  sz2OdaIndex = 0; sz2Can = 3;
  document.getElementById('sz2ToplamOda').textContent = semantikOdalar2.length;
  sz2CanGoster();
  document.getElementById('sz2Sonuc').textContent = '';
  sz2OdaGoster();
}
function sz2OdaGoster(){
  document.getElementById('sz2Oda').textContent = sz2OdaIndex+1;
  const oda = semantikOdalar2[sz2OdaIndex];
  document.getElementById('sz2Kategori').innerHTML = `🚪 Oda ${sz2OdaIndex+1}: Bu kategoriye AİT OLMAYAN kelimeyi bul, kapıyı aç!<br>📂 Kategori: <b>${oda.kategori}</b>`;
  const kutu = document.getElementById('sz2Secenekler');
  kutu.innerHTML = '';
  const karisikKelimeler = karistir(oda.kelimeler.slice());
  karisikKelimeler.forEach(kelime=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = kelime;
    btn.onclick = ()=>{
      if(kelime === oda.oddKelime){
        btn.classList.add('dogru');
        sz2OdaIndex++;
        setTimeout(()=>{
          if(sz2OdaIndex >= semantikOdalar2.length){
            document.getElementById('sz2Kategori').textContent = '';
            document.getElementById('sz2Secenekler').innerHTML = '';
            document.getElementById('sz2Sonuc').textContent = '🎉 Tebrikler! Semantik labirentten çıktın!';
          } else { sz2OdaGoster(); }
        }, 700);
      } else {
        btn.classList.add('yanlis');
        sz2Can--;
        sz2CanGoster();
        if(sz2Can<=0){
          setTimeout(()=>{
            sz2OdaIndex = 0; sz2Can = 3;
            sz2CanGoster();
            document.getElementById('sz2Sonuc').textContent = '💥 Canların bitti, labirentte kayboldun! Baştan başlıyorsun...';
            setTimeout(()=>{ document.getElementById('sz2Sonuc').textContent=''; sz2OdaGoster(); }, 1500);
          }, 500);
        } else {
          setTimeout(()=>btn.classList.remove('yanlis'), 400);
        }
      }
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// ÇELİŞKİ AVI
// =====================================================================
const celiskiListesi2 = [
  {kelime:"Secde", anlam1:"Alnı yere koyarak yapılan namaz hareketi", anlam2:"Ayakta durarak yapılan namaz hareketi", celiskiVarMi:true},
  {kelime:"Ezan", anlam1:"Namaz vaktini bildiren çağrı", anlam2:"Namaz vaktinin geldiğini bildiren dini çağrı", celiskiVarMi:false},
  {kelime:"Farz", anlam1:"Kesin olarak emredilen ibadet", anlam2:"Yapılması isteğe bağlı olan ibadet", celiskiVarMi:true},
  {kelime:"Cemaat", anlam1:"Namazı birlikte kılan topluluk", anlam2:"Namazı birlikte kılan grup", celiskiVarMi:false},
  {kelime:"Huşu", anlam1:"Kalbin Allah'a (cc) yönelmesi", anlam2:"Namazda dikkatin dağılması", celiskiVarMi:true},
  {kelime:"Niyet", anlam1:"İbadete kalpten karar vermek", anlam2:"İbadete kalpten karar verip amaçlamak", celiskiVarMi:false}
];
let ca2Index = 0, ca2Puan = 0, ca2Sira = [], ca2Kilit = false;

function ca2Baslat(){
  ca2Sira = karistir(celiskiListesi2.slice());
  ca2Index = 0; ca2Puan = 0;
  document.getElementById('ca2Puan').textContent = 0;
  document.getElementById('ca2Toplam').textContent = ca2Sira.length;
  document.getElementById('ca2Sonuc').textContent = '';
  document.getElementById('ca2Butonlar').style.display = 'flex';
  ca2Tur();
}
function ca2Tur(){
  if(ca2Index >= ca2Sira.length){
    document.getElementById('ca2Cumle').textContent = '';
    document.getElementById('ca2Butonlar').style.display = 'none';
    document.getElementById('ca2GeriBildirim').textContent = '';
    document.getElementById('ca2Sonuc').textContent = `🕵️ Avın bitti! ${ca2Puan}/${ca2Sira.length} çelişkiyi doğru tespit ettin!`;
    return;
  }
  document.getElementById('ca2Tur').textContent = ca2Index+1;
  const oge = ca2Sira[ca2Index];
  document.getElementById('ca2Cumle').innerHTML = `"<b>${oge.kelime}</b>" hem "${oge.anlam1}" hem de "${oge.anlam2}" demektir.`;
  document.getElementById('ca2GeriBildirim').textContent = '';
  ca2Kilit = false;
}
function ca2Cevapla(cevapVarMi){
  if(ca2Kilit) return;
  ca2Kilit = true;
  const oge = ca2Sira[ca2Index];
  const dogruMu = (cevapVarMi === oge.celiskiVarMi);
  if(dogruMu){
    ca2Puan++;
    document.getElementById('ca2Puan').textContent = ca2Puan;
    document.getElementById('ca2GeriBildirim').textContent = '✅ Doğru!';
  } else {
    document.getElementById('ca2GeriBildirim').textContent = `❌ Yanlış! Doğrusu: ${oge.celiskiVarMi ? 'Çelişki VAR' : 'Çelişki YOK'}`;
  }
  ca2Index++;
  setTimeout(()=>ca2Tur(), 1300);
}

// =====================================================================
// LABİRENT
// =====================================================================
const lab2Satir = 12, lab2Sutun = 15;
const lab2IfadeHavuzu = [
  {kelime:"NAMAZ", anlam:"Allah'ın (cc) huzurunda belirli hareket ve sözlerle yapılan ibadet"},
  {kelime:"EZAN", anlam:"Namaz vaktinin geldiğini bildiren dini çağrı"},
  {kelime:"KAMET", anlam:"Namaza başlamadan hemen önce okunan çağrı"},
  {kelime:"ABDEST", anlam:"Namazdan önce yapılan dini temizlik"},
  {kelime:"KIBLE", anlam:"Namazda yönelinen Kâbe yönü"},
  {kelime:"SECDE", anlam:"Alnı yere koyarak Allah'a (cc) en yakın olunan namaz hareketi"},
  {kelime:"RÜKÛ", anlam:"Namazda eğilerek yapılan hareket"},
  {kelime:"KIYAM", anlam:"Namazda ayakta durma hâli"},
  {kelime:"TEKBİR", anlam:"'Allahu ekber' diyerek namaza başlama"},
  {kelime:"FATİHA", anlam:"Her rekâtta okunması gereken Kur'an'ın ilk suresi"},
  {kelime:"HUTBE", anlam:"Cuma ve bayram namazlarında imamın yaptığı konuşma"},
  {kelime:"CEMAAT", anlam:"Namazı birlikte kılan topluluk"},
  {kelime:"İMAM", anlam:"Namazı cemaate kıldıran kişi"},
  {kelime:"MÜEZZİN", anlam:"Ezan okuyan kişi"},
  {kelime:"TERAVİH", anlam:"Ramazan ayına özel kılınan gece namazı"},
  {kelime:"HUŞU", anlam:"Namazda kalbin Allah'a (cc) yönelmesi, saygılı dikkat"},
  {kelime:"NİYET", anlam:"Bir ibadeti yapmaya kalpten karar vermek"},
  {kelime:"FARZ", anlam:"Yapılması kesin olarak emredilen ibadet"},
  {kelime:"VACİP", anlam:"Farza yakın derecede önemli olan dini görev"},
  {kelime:"SÜNNET", anlam:"Hz. Muhammed'in (sav) yaptığı, örnek gösterdiği davranış"},
  {kelime:"NAFİLE", anlam:"Farz olmayan, gönüllü yapılan ibadet"},
  {kelime:"VİTİR", anlam:"Yatsı namazından sonra kılınan tek rekâtlı vacip namaz"},
  {kelime:"MESCİT", anlam:"Namaz kılınan küçük ibadet yeri"},
  {kelime:"MİHRAP", anlam:"Camide imamın namaz kıldırdığı, kıbleyi gösteren yer"},
  {kelime:"MİNBER", anlam:"Camide hutbe okumak için kullanılan yer"},
  {kelime:"SECCADE", anlam:"Namaz kılarken üzerine secde edilen küçük halı"},
  {kelime:"TESPİH", anlam:"Namazdan sonra zikir çekmek için kullanılan boncuk dizisi"}
];
let lab2Hucreler = [], lab2HucreElemanlari = [], lab2OyuncuKonum = {r:0,c:0}, lab2Toplananlar = {};
let lab2HamleSayisi = 0, lab2ToplananSayisi = 0, lab2Saniye = 0, lab2Zamanlayici = null, lab2Bitti = false;

function lab2Uret(){
  const hucreler = [];
  for(let r=0;r<lab2Satir;r++){
    hucreler.push([]);
    for(let c=0;c<lab2Sutun;c++){ hucreler[r].push({top:true,right:true,bottom:true,left:true,ziyaretEdildi:false}); }
  }
  const yigin = [{r:0,c:0}];
  hucreler[0][0].ziyaretEdildi = true;
  while(yigin.length>0){
    const mevcut = yigin[yigin.length-1];
    const {r,c} = mevcut;
    const komsular = [];
    if(r>0 && !hucreler[r-1][c].ziyaretEdildi) komsular.push({r:r-1,c,yon:'top'});
    if(c<lab2Sutun-1 && !hucreler[r][c+1].ziyaretEdildi) komsular.push({r,c:c+1,yon:'right'});
    if(r<lab2Satir-1 && !hucreler[r+1][c].ziyaretEdildi) komsular.push({r:r+1,c,yon:'bottom'});
    if(c>0 && !hucreler[r][c-1].ziyaretEdildi) komsular.push({r,c:c-1,yon:'left'});
    if(komsular.length===0){ yigin.pop(); }
    else {
      const secilen = komsular[Math.floor(Math.random()*komsular.length)];
      if(secilen.yon==='top'){ hucreler[r][c].top=false; hucreler[secilen.r][secilen.c].bottom=false; }
      if(secilen.yon==='right'){ hucreler[r][c].right=false; hucreler[secilen.r][secilen.c].left=false; }
      if(secilen.yon==='bottom'){ hucreler[r][c].bottom=false; hucreler[secilen.r][secilen.c].top=false; }
      if(secilen.yon==='left'){ hucreler[r][c].left=false; hucreler[secilen.r][secilen.c].right=false; }
      hucreler[secilen.r][secilen.c].ziyaretEdildi = true;
      yigin.push({r:secilen.r,c:secilen.c});
    }
  }
  return hucreler;
}
function labirent2Baslat(){
  clearInterval(lab2Zamanlayici);
  lab2Hucreler = lab2Uret();
  lab2OyuncuKonum = {r:0,c:0};
  lab2HamleSayisi = 0; lab2ToplananSayisi = 0; lab2Saniye = 0; lab2Bitti = false;
  document.getElementById('lab2Hamle').textContent = 0;
  document.getElementById('lab2Toplanan').textContent = 0;
  document.getElementById('lab2Sure').textContent = 0;
  document.getElementById('lab2Durum').textContent = '';
  document.getElementById('lab2Sonuc').textContent = '';
  const tumHucreler = [];
  for(let r=0;r<lab2Satir;r++) for(let c=0;c<lab2Sutun;c++){
    if(!(r===0&&c===0) && !(r===lab2Satir-1&&c===lab2Sutun-1)) tumHucreler.push({r,c});
  }
  const secilenler = karistir(tumHucreler).slice(0, lab2IfadeHavuzu.length);
  lab2Toplananlar = {};
  secilenler.forEach((konum, i)=>{
    lab2Toplananlar[konum.r+','+konum.c] = {kelime: lab2IfadeHavuzu[i].kelime, anlam: lab2IfadeHavuzu[i].anlam, toplandi:false};
  });
  document.getElementById('lab2ToplamYildiz').textContent = secilenler.length;
  const izgara = document.getElementById('lab2Izgara');
  izgara.innerHTML = '';
  izgara.style.gridTemplateColumns = `repeat(${lab2Sutun}, 30px)`;
  izgara.style.gridTemplateRows = `repeat(${lab2Satir}, 30px)`;
  lab2HucreElemanlari = [];
  for(let r=0;r<lab2Satir;r++){
    lab2HucreElemanlari.push([]);
    for(let c=0;c<lab2Sutun;c++){
      const h = lab2Hucreler[r][c];
      const div = document.createElement('div');
      div.className = 'labirent-hucre';
      div.style.gridColumn = c+1;
      div.style.gridRow = r+1;
      div.style.borderTop = h.top ? '2px solid #333' : '2px solid transparent';
      div.style.borderRight = h.right ? '2px solid #333' : '2px solid transparent';
      div.style.borderBottom = h.bottom ? '2px solid #333' : '2px solid transparent';
      div.style.borderLeft = h.left ? '2px solid #333' : '2px solid transparent';
      const key = r+','+c;
      if(r===0 && c===0) div.textContent = '🚶';
      else if(r===lab2Satir-1 && c===lab2Sutun-1) div.textContent = '🕌';
      else if(lab2Toplananlar[key]) div.textContent = '⭐';
      izgara.appendChild(div);
      lab2HucreElemanlari[r].push(div);
    }
  }
  lab2Zamanlayici = setInterval(()=>{
    lab2Saniye++;
    document.getElementById('lab2Sure').textContent = lab2Saniye;
  }, 1000);
}
function labirent2Hareket(dr, dc){
  if(lab2Bitti) return;
  const {r,c} = lab2OyuncuKonum;
  const hucre = lab2Hucreler[r][c];
  let yeniR=r, yeniC=c;
  if(dr===-1 && !hucre.top) yeniR = r-1;
  else if(dr===1 && !hucre.bottom) yeniR = r+1;
  else if(dc===-1 && !hucre.left) yeniC = c-1;
  else if(dc===1 && !hucre.right) yeniC = c+1;
  else return;
  lab2HucreElemanlari[r][c].textContent = '';
  lab2OyuncuKonum = {r:yeniR, c:yeniC};
  lab2HamleSayisi++;
  document.getElementById('lab2Hamle').textContent = lab2HamleSayisi;
  const key = yeniR+','+yeniC;
  if(lab2Toplananlar[key] && !lab2Toplananlar[key].toplandi){
    lab2Toplananlar[key].toplandi = true;
    lab2ToplananSayisi++;
    document.getElementById('lab2Toplanan').textContent = lab2ToplananSayisi;
    document.getElementById('lab2Durum').textContent = `✨ Topladın: ${lab2Toplananlar[key].kelime} — ${lab2Toplananlar[key].anlam}`;
  }
  if(yeniR===lab2Satir-1 && yeniC===lab2Sutun-1){
    lab2HucreElemanlari[yeniR][yeniC].textContent = '🏁';
    lab2Bitti = true;
    clearInterval(lab2Zamanlayici);
    const toplamYildiz = document.getElementById('lab2ToplamYildiz').textContent;
    document.getElementById('lab2Sonuc').textContent =
      `🎉 Tebrikler! Labirenti ${lab2HamleSayisi} hamlede ve ${lab2Saniye} saniyede tamamladın! (${lab2ToplananSayisi}/${toplamYildiz} yıldız topladın)`;
    return;
  }
  lab2HucreElemanlari[yeniR][yeniC].textContent = '🚶';
}
document.addEventListener('keydown', (e)=>{
  const aktifBolum = document.getElementById('labirent2');
  if(!aktifBolum.classList.contains('aktif')) return;
  const etiket = document.activeElement ? document.activeElement.tagName : '';
  if(etiket==='INPUT' || etiket==='TEXTAREA') return;
  if(e.key==='ArrowUp'){ e.preventDefault(); labirent2Hareket(-1,0); }
  else if(e.key==='ArrowDown'){ e.preventDefault(); labirent2Hareket(1,0); }
  else if(e.key==='ArrowLeft'){ e.preventDefault(); labirent2Hareket(0,-1); }
  else if(e.key==='ArrowRight'){ e.preventDefault(); labirent2Hareket(0,1); }
});

