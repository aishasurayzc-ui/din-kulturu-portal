// --- 2) BOŞLUK DOLDUR ---
let ez22Tur=0, ez22Dogru=0, ez22Sira=[];
function ez22Baslat(){
  ez22Tur=0; ez22Dogru=0;
  ez22Sira = karistir(ezberVeri2.map((x,i)=>i));
  document.getElementById('ez22Dogru').textContent='0';
  document.getElementById('ez22Sonuc').textContent='';
  ez22SoruGoster();
}
function ez22SoruGoster(){
  if(ez22Tur>=ez22Sira.length){
    document.getElementById('ez22Metin').textContent='';
    document.getElementById('ez22Secenekler').innerHTML='';
    document.getElementById('ez22Sonuc').innerHTML = `🎉 Bitti! ${ez22Dogru}/${ez22Sira.length} doğru.`;
    return;
  }
  document.getElementById('ez22Tur').textContent = ez22Tur+1;
  const i = ez22Sira[ez22Tur];
  const oge = ezberVeri2[i];
  document.getElementById('ez22Metin').textContent = oge.parca.replace(oge.gizli, '______');
  const digerleri = ezberVeri2.filter((_,j)=>j!==i).map(x=>x.gizli);
  const yanlislar = karistir(digerleri).slice(0,3);
  const secenekler = karistir([oge.gizli, ...yanlislar]);
  const kutu = document.getElementById('ez22Secenekler');
  kutu.innerHTML='';
  secenekler.forEach(sec=>{
    const btn=document.createElement('div');
    btn.className='merdiven-secenek';
    btn.textContent=sec;
    btn.onclick=()=>{
      document.querySelectorAll('#ez22Secenekler .merdiven-secenek').forEach(b=>b.onclick=null);
      if(sec===oge.gizli){ btn.classList.add('dogru'); ez22Dogru++; document.getElementById('ez22Dogru').textContent=ez22Dogru; }
      else {
        btn.classList.add('yanlis');
        [...kutu.children].find(b=>b.textContent===oge.gizli).classList.add('dogru');
      }
      setTimeout(()=>{ ez22Tur++; ez22SoruGoster(); }, 1100);
    };
    kutu.appendChild(btn);
  });
}

// --- 3) ANLAM EŞLEŞTİR ---
let ez32Secili=null, ez32Eslesen=0;
function ez32Baslat(){
  ez32Secili=null; ez32Eslesen=0;
  document.getElementById('ez32Eslesen').textContent='0';
  document.getElementById('ez32Sonuc').textContent='';
  const solSira = karistir(ezberVeri2.map((x,i)=>i));
  const sagSira = karistir(ezberVeri2.map((x,i)=>i));
  const sol = document.getElementById('ez32Sol'); sol.innerHTML='';
  const sag = document.getElementById('ez32Sag'); sag.innerHTML='';
  solSira.forEach(i=>{
    const b=document.createElement('div');
    b.className='merdiven-secenek ez-oge';
    b.textContent=ezberVeri2[i].parca;
    b.dataset.i=i; b.dataset.taraf='sol';
    b.onclick=()=>ez32Tikla(b);
    sol.appendChild(b);
  });
  sagSira.forEach(i=>{
    const b=document.createElement('div');
    b.className='merdiven-secenek ez-oge';
    b.textContent=ezberVeri2[i].anlam;
    b.dataset.i=i; b.dataset.taraf='sag';
    b.onclick=()=>ez32Tikla(b);
    sag.appendChild(b);
  });
}
function ez32Tikla(b){
  if(b.classList.contains('eslesti')) return;
  if(ez32Secili && ez32Secili.dataset.taraf===b.dataset.taraf){
    ez32Secili.classList.remove('secili');
    ez32Secili = b; b.classList.add('secili');
    return;
  }
  if(!ez32Secili){ ez32Secili=b; b.classList.add('secili'); return; }
  if(ez32Secili.dataset.i===b.dataset.i){
    ez32Secili.classList.remove('secili'); ez32Secili.classList.add('eslesti');
    b.classList.add('eslesti');
    ez32Secili=null;
    ez32Eslesen++;
    document.getElementById('ez32Eslesen').textContent=ez32Eslesen;
    if(ez32Eslesen===ezberVeri2.length){
      document.getElementById('ez32Sonuc').innerHTML = "🎉 Tebrikler! Tüm ayetleri anlamlarıyla eşleştirdin!";
    }
  } else {
    const digeri = ez32Secili;
    digeri.classList.add('yanlis'); b.classList.add('yanlis');
    setTimeout(()=>{ digeri.classList.remove('yanlis','secili'); b.classList.remove('yanlis'); },400);
    ez32Secili=null;
  }
}

// --- 4) HAFIZA KARTLARI ---
let ez42Acik=[], ez42Bulunan=0, ez42Hamle=0, ez42Kilit=false;
function ez42Baslat(){
  ez42Acik=[]; ez42Bulunan=0; ez42Hamle=0; ez42Kilit=false;
  document.getElementById('ez42Bulunan').textContent='0';
  document.getElementById('ez42Hamle').textContent='0';
  document.getElementById('ez42Sonuc').textContent='';
  const kartlar=[];
  ezberVeri2.forEach((x,i)=>{
    kartlar.push({i, tip:'parca', metin:x.parca});
    kartlar.push({i, tip:'anlam', metin:x.anlam});
  });
  const karisik = karistir(kartlar);
  const izgara = document.getElementById('ez42Izgara');
  izgara.innerHTML='';
  karisik.forEach(k=>{
    const kart=document.createElement('div');
    kart.className='hafiza-kart';
    kart.dataset.i=k.i; kart.dataset.tip=k.tip;
    kart.innerHTML = `<div class="hafiza-on">🕌</div><div class="hafiza-arka">${k.metin}</div>`;
    kart.onclick=()=>ez42KartTikla(kart);
    izgara.appendChild(kart);
  });
}
function ez42KartTikla(kart){
  if(ez42Kilit || kart.classList.contains('acik') || kart.classList.contains('bulundu')) return;
  kart.classList.add('acik');
  ez42Acik.push(kart);
  if(ez42Acik.length===2){
    ez42Hamle++; document.getElementById('ez42Hamle').textContent=ez42Hamle;
    ez42Kilit=true;
    const [a,b]=ez42Acik;
    if(a.dataset.i===b.dataset.i && a.dataset.tip!==b.dataset.tip){
      a.classList.add('bulundu'); b.classList.add('bulundu');
      ez42Bulunan++; document.getElementById('ez42Bulunan').textContent=ez42Bulunan;
      ez42Acik=[]; ez42Kilit=false;
      if(ez42Bulunan===ezberVeri2.length){
        document.getElementById('ez42Sonuc').innerHTML = `🎉 Tebrikler! ${ez42Hamle} hamlede tüm çiftleri buldun!`;
      }
    } else {
      setTimeout(()=>{
        a.classList.remove('acik'); b.classList.remove('acik');
        ez42Acik=[]; ez42Kilit=false;
      }, 900);
    }
  }
}

