        liste.innerHTML += `<div><b>${ez565Adim+1}.</b> ${oge.parca}</div>`;
        setTimeout(()=>{ ez565Adim++; ez565SoruGoster(); }, 700);
      } else {
        btn.classList.add('yanlis');
        [...kutu.children].find(b=>b.textContent===oge.parca).classList.add('dogru');
        setTimeout(()=>{ ez565SoruGoster(); }, 1100);
      }
    };
    kutu.appendChild(btn);
  });
}

