<body>

<script>
/* Tema (açık/koyu) — erken uygulama: yanıp sönmeyi (flash) önlemek için body render olmadan önce çalışır.
   Yeni localStorage anahtarı kullanılır; mevcut 'dkabPuanDurumu' vb. anahtarlara dokunulmaz. */
(function(){
  try{
    var kayitliTema = localStorage.getItem('dkabTemaTercihi');
    if(kayitliTema === 'dark' || kayitliTema === 'light'){
      document.documentElement.setAttribute('data-theme', kayitliTema);
    }
  }catch(e){}
})();
function temaDegistir(){
  var kok = document.documentElement;
  var suanKoyuMu = kok.getAttribute('data-theme') === 'dark'
    || (kok.getAttribute('data-theme') !== 'light' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
  var yeniTema = suanKoyuMu ? 'light' : 'dark';
  kok.setAttribute('data-theme', yeniTema);
  try{ localStorage.setItem('dkabTemaTercihi', yeniTema); }catch(e){}
  temaButonEtiketiGuncelle();
}
function temaButonEtiketiGuncelle(){
  var btn = document.getElementById('temaDegistirBtn');
  if(!btn) return;
  var kok = document.documentElement;
  var koyuMu = kok.getAttribute('data-theme') === 'dark'
    || (kok.getAttribute('data-theme') !== 'light' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
  btn.textContent = koyuMu ? '☀️ Açık Tema' : '🌙 Koyu Tema';
}
document.addEventListener('DOMContentLoaded', temaButonEtiketiGuncelle);
</script>


<header>
  <p style="margin:0 0 6px;font-size:1.1em;font-weight:bold;letter-spacing:.5px;opacity:.95;">6. SINIF — 5. ÜNİTE</p>
  <h1>🕌 Kültürümüzdeki Dinî Motifler</h1>
  <p>Din Kültürü ve Ahlak Bilgisi — İnteraktif Oyunlar</p>
  <p style="margin-top:10px;font-size:.95em;opacity:.95;">👩‍🏫 Hazırlayan: DKAB Öğretmeni Ayşe Yazıcı</p>
  <div class="gb-kontrol-satiri" style="margin-top:14px;display:flex;gap:10px;justify-content:center;flex-wrap:wrap;align-items:center;">
    <a href="../en/din-kulturu-6sinif-1unite/index.html" lang="en" style="display:inline-block;padding:6px 16px;border-radius:16px;background:rgba(255,255,255,.22);color:white;text-decoration:none;font-weight:bold;font-size:.85em;border:1px solid rgba(255,255,255,.55);">English</a>
    <button type="button" id="temaDegistirBtn" class="tema-degistir-btn" onclick="temaDegistir()" aria-label="Koyu/açık tema değiştir">🌙 Koyu Tema</button>
  </div>
</header>
