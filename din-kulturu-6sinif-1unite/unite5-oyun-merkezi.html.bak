// --- 2) BOŞLUK DOLDUR ---
let ez265Tur=0, ez265Dogru=0, ez265Sira=[];
function ez265Baslat(){
  ez265Tur=0; ez265Dogru=0;
  ez265Sira = karistir(ezberVeri65.map((x,i)=>i));
  document.getElementById('ez265Dogru').textContent='0';
  document.getElementById('ez265Sonuc').textContent='';
  ez265SoruGoster();
}
function ez265SoruGoster(){
  if(ez265Tur>=ez265Sira.length){
    document.getElementById('ez265Metin').textContent='';
    document.getElementById('ez265Secenekler').innerHTML='';
    document.getElementById('ez265Sonuc').innerHTML = `🎉 Bitti! ${ez265Dogru}/${ez265Sira.length} doğru.`;
    return;
  }
  document.getElementById('ez265Tur').textContent = ez265Tur+1;
  const i = ez265Sira[ez265Tur];
  const oge = ezberVeri65[i];
  document.getElementById('ez265Metin').textContent = oge.parca.replace(oge.gizli, '______');
  const digerleri = ezberVeri65.filter((_,j)=>j!==i).map(x=>x.gizli);
  const yanlislar = karistir(digerleri).slice(0,3);
  const secenekler = karistir([oge.gizli, ...yanlislar]);
  const kutu = document.getElementById('ez265Secenekler');
  kutu.innerHTML='';
  secenekler.forEach(sec=>{
    const btn=document.createElement('div');
    btn.className='merdiven-secenek';
    btn.textContent=sec;
    btn.onclick=()=>{
      document.querySelectorAll('#ez265Secenekler .merdiven-secenek').forEach(b=>b.onclick=null);
      if(sec===oge.gizli){ btn.classList.add('dogru'); ez265Dogru++; document.getElementById('ez265Dogru').textContent=ez265Dogru; }
      else {
        btn.classList.add('yanlis');
        [...kutu.children].find(b=>b.textContent===oge.gizli).classList.add('dogru');
      }
      setTimeout(()=>{ ez265Tur++; ez265SoruGoster(); }, 1100);
    };
    kutu.appendChild(btn);
  });
}

// --- 3) ANLAM EŞLEŞTİR ---
let ez365Secili=null, ez365Eslesen=0;
function ez365Baslat(){
  ez365Secili=null; ez365Eslesen=0;
  document.getElementById('ez365Eslesen').textContent='0';
  document.getElementById('ez365Sonuc').textContent='';
  const solSira = karistir(ezberVeri65.map((x,i)=>i));
  const sagSira = karistir(ezberVeri65.map((x,i)=>i));
  const sol = document.getElementById('ez365Sol'); sol.innerHTML='';
  const sag = document.getElementById('ez365Sag'); sag.innerHTML='';
  solSira.forEach(i=>{
    const b=document.createElement('div');
    b.className='merdiven-secenek ez-oge';
    b.textContent=ezberVeri65[i].parca;
    b.dataset.i=i; b.dataset.taraf='sol';
    b.onclick=()=>ez365Tikla(b);
    sol.appendChild(b);
  });
  sagSira.forEach(i=>{
    const b=document.createElement('div');
    b.className='merdiven-secenek ez-oge';
    b.textContent=ezberVeri65[i].anlam;
    b.dataset.i=i; b.dataset.taraf='sag';
    b.onclick=()=>ez365Tikla(b);
    sag.appendChild(b);
  });
}
function ez365Tikla(b){
  if(b.classList.contains('eslesti')) return;
  if(ez365Secili && ez365Secili.dataset.taraf===b.dataset.taraf){
    ez365Secili.classList.remove('secili');
    ez365Secili = b; b.classList.add('secili');
    return;
  }
  if(!ez365Secili){ ez365Secili=b; b.classList.add('secili'); return; }
  if(ez365Secili.dataset.i===b.dataset.i){
    ez365Secili.classList.remove('secili'); ez365Secili.classList.add('eslesti');
    b.classList.add('eslesti');
    ez365Secili=null;
    ez365Eslesen++;
    document.getElementById('ez365Eslesen').textContent=ez365Eslesen;
    if(ez365Eslesen===ezberVeri65.length){
      document.getElementById('ez365Sonuc').innerHTML = "🎉 Tebrikler! Tüm cümleleri anlamlarıyla eşleştirdin!";
    }
  } else {
    const digeri = ez365Secili;
    digeri.classList.add('yanlis'); b.classList.add('yanlis');
    setTimeout(()=>{ digeri.classList.remove('yanlis','secili'); b.classList.remove('yanlis'); },400);
    ez365Secili=null;
  }
}

// --- 4) HAFIZA KARTLARI ---
let ez465Acik=[], ez465Bulunan=0, ez465Hamle=0, ez465Kilit=false;
function ez465Baslat(){
  ez465Acik=[]; ez465Bulunan=0; ez465Hamle=0; ez465Kilit=false;
  document.getElementById('ez465Bulunan').textContent='0';
  document.getElementById('ez465Hamle').textContent='0';
  document.getElementById('ez465Sonuc').textContent='';
  const kartlar=[];
  ezberVeri65.forEach((x,i)=>{
    kartlar.push({i, tip:'parca', metin:x.parca});
    kartlar.push({i, tip:'anlam', metin:x.anlam});
  });
  const karisik = karistir(kartlar);
  const izgara = document.getElementById('ez465Izgara');
  izgara.innerHTML='';
  karisik.forEach(k=>{
    const kart=document.createElement('div');
    kart.className='hafiza-kart';
    kart.dataset.i=k.i; kart.dataset.tip=k.tip;
    kart.innerHTML = `<div class="hafiza-on">🕌</div><div class="hafiza-arka">${k.metin}</div>`;
    kart.onclick=()=>ez465KartTikla(kart);
    izgara.appendChild(kart);
  });
}
function ez465KartTikla(kart){
  if(ez465Kilit || kart.classList.contains('acik') || kart.classList.contains('bulundu')) return;
  kart.classList.add('acik');
  ez465Acik.push(kart);
  if(ez465Acik.length===2){
    ez465Hamle++; document.getElementById('ez465Hamle').textContent=ez465Hamle;
    ez465Kilit=true;
    const [a,b]=ez465Acik;
    if(a.dataset.i===b.dataset.i && a.dataset.tip!==b.dataset.tip){
      a.classList.add('bulundu'); b.classList.add('bulundu');
      ez465Bulunan++; document.getElementById('ez465Bulunan').textContent=ez465Bulunan;
      ez465Acik=[]; ez465Kilit=false;
      if(ez465Bulunan===ezberVeri65.length){
        document.getElementById('ez465Sonuc').innerHTML = `🎉 Tebrikler! ${ez465Hamle} hamlede tüm çiftleri buldun!`;
      }
    } else {
      setTimeout(()=>{
        a.classList.remove('acik'); b.classList.remove('acik');
        ez465Acik=[]; ez465Kilit=false;
      }, 900);
    }
  }
}

