@media(max-width:640px){ .ez-hafiza-izgara{ grid-template-columns:repeat(4,1fr); } .ez-hafiza-izgara .hafiza-kart{ height:74px; } }


  /* ---- Faz 1: kategori sekmelerine alt başlık eklendi (4./8. sınıf deseniyle tutarlı) ---- */
  .gb-kart-ikon{ font-size:1.5em; flex-shrink:0; line-height:1; transition:transform .2s ease; }
  .omg-yan-oge:hover .gb-kart-ikon{ transform:scale(1.12); }
  .gb-kart-metin{ display:flex; flex-direction:column; gap:3px; min-width:0; }
