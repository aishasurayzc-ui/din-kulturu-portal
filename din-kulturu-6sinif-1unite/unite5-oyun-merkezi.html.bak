<script>
function goster(id, ev){
  document.querySelectorAll('section').forEach(s=>s.classList.remove('aktif'));
  document.getElementById(id).classList.add('aktif');
  document.querySelectorAll('.oyun-grubu button').forEach(b=>b.classList.remove('aktif'));
  if(ev && ev.target) ev.target.classList.add('aktif');
}
function kategoriGoster(id, ev){
  document.querySelectorAll('.oyun-grubu').forEach(g=>g.classList.remove('aktif'));
  document.getElementById(id).classList.add('aktif');
  document.querySelectorAll('.kategori-nav button').forEach(b=>b.classList.remove('kat-aktif'));
  if(ev && ev.target) ev.target.classList.add('kat-aktif');
}
function kategoriGosterVeKaydir(kategoriId){
  document.querySelectorAll('.oyun-grubu').forEach(g=>g.classList.remove('aktif'));
  document.getElementById(kategoriId).classList.add('aktif');
  document.querySelectorAll('.kategori-nav button').forEach(b=>{
    b.classList.toggle('kat-aktif', b.getAttribute('onclick').includes(kategoriId));
  });
  document.getElementById('oyun-gruplari').scrollIntoView({behavior:'smooth'});
}

function karistir(a){ return a.map(v=>[Math.random(),v]).sort((x,y)=>x[0]-y[0]).map(v=>v[1]); }

let puanDurumu;
try{ puanDurumu = JSON.parse(localStorage.getItem('dkabPuanDurumu6sinif')) || {}; }catch(e){ puanDurumu = {}; }
puanDurumu = Object.assign({toplamPuan:0, tamamlanan:0, rozetler:[], sonOyunTarihi:null, seri:0}, puanDurumu);

function puanKaydet(){ try{ localStorage.setItem('dkabPuanDurumu6sinif', JSON.stringify(puanDurumu)); }catch(e){} }

function gunlukSeriGuncelle(){
  const bugun = new Date().toDateString();
  if(puanDurumu.sonOyunTarihi !== bugun){
    const dun = new Date(); dun.setDate(dun.getDate()-1);
    puanDurumu.seri = (puanDurumu.sonOyunTarihi === dun.toDateString()) ? puanDurumu.seri+1 : 1;
    puanDurumu.sonOyunTarihi = bugun;
  }
}

function istatistikleriGuncelleGoster(){
  const tp = document.getElementById('istToplamPuan');
  if(!tp) return;
  document.getElementById('istToplamPuan').textContent = puanDurumu.toplamPuan;
  document.getElementById('istTamamlanan').textContent = puanDurumu.tamamlanan;
  document.getElementById('istSeri').textContent = puanDurumu.seri;
  document.getElementById('istRozet').textContent = puanDurumu.rozetler.length;
}

function oyunTamamlandi(bolumId){
  puanDurumu.toplamPuan += 10;
  puanDurumu.tamamlanan++;
  gunlukSeriGuncelle();
  const esikler = [{sayi:1,ad:"🥉 İlk Adım"},{sayi:5,ad:"🥈 Azimli Öğrenci"},{sayi:10,ad:"🥇 Kelime Ustası"},{sayi:20,ad:"🏆 Efsane"}];
  esikler.forEach(e=>{
    if(puanDurumu.tamamlanan>=e.sayi && !puanDurumu.rozetler.includes(e.ad)) puanDurumu.rozetler.push(e.ad);
  });
  puanKaydet();
  istatistikleriGuncelleGoster();
  opOyunTamamlandiKaydet(bolumId, puanDurumu.toplamPuan, puanDurumu.rozetler);
}

function sonucIzlemeBaslat(){
  document.querySelectorAll('.sonuc-kutusu').forEach(el=>{
    const gozlemci = new MutationObserver(()=>{
      const metin = el.textContent;
      if((metin.includes('🎉') || metin.includes('🏆')) && el.dataset.sonOdul !== metin){
        el.dataset.sonOdul = metin;
        oyunTamamlandi(el.closest('section') ? el.closest('section').id : null);
      }
    });
    gozlemci.observe(el, {childList:true, characterData:true, subtree:true});
  });
}

function siraOlustur(cfg){
  const banka = document.getElementById(cfg.bankaId);
  const cevap = document.getElementById(cfg.cevapId);
  banka.innerHTML=''; cevap.innerHTML='';
  let beklenen = 0;
  const karisikSira = karistir(cfg.tokens.map((t,i)=>({t,i})));
  karisikSira.forEach(obj=>{
    const tas = document.createElement('div');
    tas.className='kelime-tas';
    tas.textContent = obj.t;
    tas.dataset.sira = obj.i;
    tas.onclick = ()=>{
      if(tas.classList.contains('kullanildi')) return;
      if(parseInt(tas.dataset.sira,10) === beklenen){
        tas.classList.add('kullanildi');
        tas.onclick = null;
        const kopya = document.createElement('div');
        kopya.className='kelime-tas';
        kopya.textContent = obj.t;
        cevap.appendChild(kopya);
        beklenen++;
        if(cfg.ilerleme) cfg.ilerleme(beklenen);
        if(beklenen === cfg.tokens.length && cfg.tamamlandi) cfg.tamamlandi();
      } else {
        tas.classList.add('yanlis');
        setTimeout(()=>tas.classList.remove('yanlis'), 300);
      }
    };
    banka.appendChild(tas);
  });
}

// =====================================================================
// KONU TEKRARI TESTİ (50 Soru)
// =====================================================================
const konuTekrariSorulari65 = [
  {zorluk:"kolay", soru:"Bir toplumun maddi ve manevi değerlerinin bütününe ne denir?", secenekler:["Örf","Kültür","Gelenek","Görenek"], dogru:1, aciklama:"Bir toplumun maddi ve manevi değerlerinin bütününe kültür denir."},
  {zorluk:"kolay", soru:"Toplumun uzun sürede oluşturup benimsediği yazılı olmayan kurallara ne denir?", secenekler:["Kanun","Örf ve âdet","Anayasa","Yönetmelik"], dogru:1, aciklama:"Bu kurallara örf ve âdet denir."},
  {zorluk:"kolay", soru:"Sevinçli veya üzüntülü günlerde okunan, Hz. Peygamber'in doğumunu ve hayatını anlatan programa ne denir?", secenekler:["Mevlit","Taziye","Kandil","Aşure"], dogru:0, aciklama:"Bu programa mevlit denir."},
  {zorluk:"kolay", soru:"Yakını vefat eden birine başsağlığı dileğinde bulunmaya ne denir?", secenekler:["Mevlit","Taziye","Kandil","Bayram"], dogru:1, aciklama:"Bu ziyarete taziye denir."},
  {zorluk:"kolay", soru:"Kültürümüzde kaç kandil gecesi vardır?", secenekler:["İki","Üç","Dört","Beş"], dogru:2, aciklama:"Kültürümüzde Mevlit, Regaip, Miraç ve Berat olmak üzere dört kandil gecesi vardır."},
  {zorluk:"kolay", soru:"Ramazan ayında iki minare arasına asılan ışıklı yazılara ne denir?", secenekler:["Mahya","Kandil","Aşure","Sela"], dogru:0, aciklama:"Bu yazılara mahya denir."},
  {zorluk:"kolay", soru:"Muharrem ayının onuncu gününe ne denir?", secenekler:["Aşure günü","Kandil günü","Bayram günü","Mevlit günü"], dogru:0, aciklama:"Bu güne aşure günü denir."},
  {zorluk:"kolay", soru:"Hz. Muhammed'in aile fertleri için kullanılan, \"ev halkı\" anlamına gelen kavram nedir?", secenekler:["Ehlibeyt","Ümmet","Sahabe","Ensar"], dogru:0, aciklama:"Bu kavrama Ehlibeyt denir."},
  {zorluk:"kolay", soru:"Namaz vakitlerinin geldiğini Müslümanlara duyurmak için okunan çağrıya ne denir?", secenekler:["Kamet","Ezan","Sela","Salavat"], dogru:1, aciklama:"Bu çağrıya ezan denir."},
  {zorluk:"kolay", soru:"Farz namazların öncesinde \"Kad kâmeti's salâh\" ifadesinin eklenerek okunmasına ne denir?", secenekler:["Ezan","Kamet","Sela","Salavat"], dogru:1, aciklama:"Bu uygulamaya kamet denir."},
  {zorluk:"kolay", soru:"Allah'ı övme ve O'na dua etme amacıyla yazılıp bestelenen şiirlere ne denir?", secenekler:["İlahi","Naat","Tevhit","Münacat"], dogru:0, aciklama:"Bu şiirlere ilahi denir."},
  {zorluk:"kolay", soru:"Hz. Peygamber'e selam ve dua etmek anlamına gelen sözlere ne denir?", secenekler:["Salavat","İlahi","Sela","Kamet"], dogru:0, aciklama:"Bu sözlere salavat denir."},
  {zorluk:"kolay", soru:"Yüce Allah'ın varlığını ve birliğini anlatan edebî eserlere ne denir?", secenekler:["Tevhit","Münacat","Naat","Mevlit"], dogru:0, aciklama:"Bu eserlere tevhit denir."},
  {zorluk:"kolay", soru:"Allah'a dua etmek amacıyla yazılan şiirlere ne denir?", secenekler:["Tevhit","Münacat","Naat","Mevlit"], dogru:1, aciklama:"Bu şiirlere münacat denir."},
  {zorluk:"kolay", soru:"Hz. Peygamber'i ve özelliklerini öven şiirlere ne denir?", secenekler:["Tevhit","Münacat","Naat","Mevlit"], dogru:2, aciklama:"Bu şiirlere naat denir."},
  {zorluk:"kolay", soru:"En meşhur mevlit eseri olan \"Vesiletü'n-Necat\"ı kim yazmıştır?", secenekler:["Süleyman Çelebi","Yunus Emre","Mevlana","Hacı Bektaş Veli"], dogru:0, aciklama:"Bu eseri Süleyman Çelebi yazmıştır."},
  {zorluk:"kolay", soru:"Ezanı ilk kez kim okumuştur?", secenekler:["Bilal Habeşi","Hz. Ömer","Hz. Ebu Bekir","Hz. Ali"], dogru:0, aciklama:"Ezanı ilk kez Bilal Habeşi okumuştur."},

  {zorluk:"orta", soru:"Muharrem ayının onuncu gününde yapılıp dağıtılan tatlıya ne denir?", secenekler:["Aşure","Lokum","Kadayıf","Baklava"], dogru:0, aciklama:"Bu tatlıya aşure denir."},
  {zorluk:"orta", soru:"Osmanlı Dönemi'nde yaygınlaşan, ihtiyaç sahiplerinin alması için cami avlusuna bırakılan yardıma ne denir?", secenekler:["Sadaka taşı","Zimem defteri","Vakıf","Diş kirası"], dogru:0, aciklama:"Bu geleneğe sadaka taşı denir."},
  {zorluk:"orta", soru:"Zimem kelimesi Arapçada ne anlama gelir?", secenekler:["Borçlar","Yardımlar","Bağışlar","Zekâtlar"], dogru:0, aciklama:"Zimem, Arapçada borçlar anlamına gelir."},
  {zorluk:"orta", soru:"Bir maldan yararlanma hakkını Allah rızası için topluma özgüleyip satmayı yasaklamaya ne denir?", secenekler:["Vakıf","Zimem","Sadaka","Zekât"], dogru:0, aciklama:"Bu uygulamaya vakıf denir."},
  {zorluk:"orta", soru:"Bir vakfın kurucusu tarafından düzenlenen, vakfın işleyişiyle ilgili resmî belgeye ne denir?", secenekler:["Vakfiye","Zimem defteri","Tapu","Ferman"], dogru:0, aciklama:"Bu belgeye vakfiye denir."},
  {zorluk:"orta", soru:"Osmanlı'da saray ve konaklarda iftar sonrası misafirlere verilen para ve hediyelere ne denir?", secenekler:["Diş kirası","Zekât","Sadaka","Fitre"], dogru:0, aciklama:"Bu uygulamaya diş kirası denir."},
  {zorluk:"orta", soru:"Anaların bebeklerini uyuturken dinî ögelerle söylediği ezgili sözlere ne denir?", secenekler:["Ninni","Mani","Türkü","Ağıt"], dogru:0, aciklama:"Bu sözlere ninni denir."},
  {zorluk:"orta", soru:"Kandil geceleri hangi padişah zamanında adlandırılmıştır?", secenekler:["Kanuni Sultan Süleyman","II. Selim","Fatih Sultan Mehmet","Yavuz Sultan Selim"], dogru:1, aciklama:"Kandil geceleri, II. Selim zamanında minarelerde kandiller yakılarak kutlandığı için bu adı almıştır."},
  {zorluk:"orta", soru:"Güzel sesiyle mevlit okuyan kişiye ne denir?", secenekler:["Mevlithan","Hafız","Müezzin","İmam"], dogru:0, aciklama:"Bu kişiye mevlithan denir."},
  {zorluk:"orta", soru:"Tekbiri hangi bestekâr bestelemiştir?", secenekler:["Buhurizade Mustafa Itri Efendi","Süleyman Çelebi","Yunus Emre","Mevlana"], dogru:0, aciklama:"Tekbiri, Buhurizade Mustafa Itri Efendi bestelemiştir."},
  {zorluk:"orta", soru:"Önemli gün ve geceleri hatırlatmak, cenaze namazını haber vermek için minarelerde okunan duaya ne denir?", secenekler:["Sela","Ezan","Kamet","Salavat"], dogru:0, aciklama:"Bu duaya sela denir."},
  {zorluk:"orta", soru:"Musiki nedir?", secenekler:["Kulağa hoş gelen sesler dizisi","Sadece söz sanatı","Sadece dans","Sadece resim"], dogru:0, aciklama:"Musiki, kulağa hoş gelen sesler dizisidir."},
  {zorluk:"orta", soru:"Olay, duygu ve düşüncelerin sözlü ya da yazılı ifadesine ne denir?", secenekler:["Edebiyat","Musiki","Kültür","Gelenek"], dogru:0, aciklama:"Bu ifadeye edebiyat denir."},
  {zorluk:"orta", soru:"Hz. Peygamber'in Veysel Karani'ye gönderdiği kabul edilen hırkasına ne denir?", secenekler:["Hırkayışerif","Sancakışerif","Kisvei Şerif","Tacışerif"], dogru:0, aciklama:"Bu hırkaya Hırkayışerif denir."},
  {zorluk:"orta", soru:"Hırka-i Şerif Camisi hangi ilçededir?", secenekler:["Fatih","Beyoğlu","Üsküdar","Kadıköy"], dogru:0, aciklama:"Hırka-i Şerif Camisi, İstanbul'un Fatih ilçesindedir."},
  {zorluk:"orta", soru:"Çocukları oruca alıştırmak için yapılan geleneğe ne denir?", secenekler:["Tekne orucu","Muharrem orucu","Kaza orucu","Nafile oruç"], dogru:0, aciklama:"Bu geleneğe tekne orucu denir."},
  {zorluk:"orta", soru:"Hz. Peygamber'in adı anıldığında yapılan davranış nedir?", secenekler:["Salavat getirmek","Susmak","Ağlamak","Gülmek"], dogru:0, aciklama:"Hz. Peygamber'in adı anıldığında salavat getirilir."},

  {zorluk:"zor", soru:"Kur'an-ı Kerim'de Ehlibeyt kavramı hangi surede geçer?", secenekler:["Ahzab suresi","Bakara suresi","Fatiha suresi","Yasin suresi"], dogru:0, aciklama:"Ehlibeyt kavramı Ahzab suresinde geçer."},
  {zorluk:"zor", soru:"\"Sadakaları açık olarak verirseniz bu ne güzel!..\" ayeti hangi konuyla ilgilidir?", secenekler:["Yardımlaşma","Namaz","Oruç","Hac"], dogru:0, aciklama:"Bu ayet yardımlaşmayla ilgilidir."},
  {zorluk:"zor", soru:"Hz. Muhammed'in Fedek'teki hurma bahçelerinin gelirini nasıl kullandığı rivayet edilir?", secenekler:["Toplum yararına kullandığı","Sadece kendisi için kullandığı","Sattığı","Yaktığı"], dogru:0, aciklama:"Fedek'teki hurma bahçelerinin gelirinin bir kısmını toplum yararına kullandığı rivayet edilir."},
  {zorluk:"zor", soru:"Selçuklu ve Osmanlı Dönemi'nde kurulan vakıflardan biri hangisidir?", secenekler:["Öğrenciye mürekkep verme vakfı","Sadece askeri vakıf","Sadece cami vakfı","Sadece okul vakfı"], dogru:0, aciklama:"Bu dönemde öğrenciye mürekkep verme vakfı gibi çeşitli vakıflar kurulmuştur."},
  {zorluk:"zor", soru:"Günümüzde toplum yararına faaliyet yürüten kuruluşlardan biri hangisidir?", secenekler:["Kızılay","Sadece belediyeler","Sadece okullar","Sadece hastaneler"], dogru:0, aciklama:"Kızılay, günümüzde toplum yararına faaliyet yürüten kuruluşlardan biridir."},
  {zorluk:"zor", soru:"Regaip Kandili hangi ayın hangi gecesidir?", secenekler:["Recep ayının ilk perşembeyi cumaya bağlayan gecesi","Şaban ayının on beşinci gecesi","Ramazan ayının yirmi yedinci gecesi","Muharrem ayının onuncu gecesi"], dogru:0, aciklama:"Regaip Kandili, recep ayının ilk perşembeyi cumaya bağlayan gecesidir."},
  {zorluk:"zor", soru:"Miraç Kandili hangi gecedir?", secenekler:["Recep ayının yirmi yedinci gecesi","Şaban ayının on beşinci gecesi","Ramazan ayının yirmi yedinci gecesi","Rebiyülevvel ayının on ikinci gecesi"], dogru:0, aciklama:"Miraç Kandili, recep ayının yirmi yedinci gecesidir."},
  {zorluk:"zor", soru:"Berat Kandili hangi gecedir?", secenekler:["Şaban ayının on beşinci gecesi","Recep ayının yirmi yedinci gecesi","Ramazan ayının yirmi yedinci gecesi","Muharrem ayının onuncu gecesi"], dogru:0, aciklama:"Berat Kandili, şaban ayının on beşinci gecesidir."},
  {zorluk:"zor", soru:"Mevlit Kandili hangi gecedir?", secenekler:["Rebiyülevvel ayının on ikinci gecesi","Recep ayının yirmi yedinci gecesi","Şaban ayının on beşinci gecesi","Ramazan ayının yirmi yedinci gecesi"], dogru:0, aciklama:"Mevlit Kandili, rebiyülevvel ayının on ikinci gecesidir."},
  {zorluk:"zor", soru:"Naatın ilk örneklerini kimler yazmıştır?", secenekler:["Yusuf Has Hacip, Hoca Ahmet Yesevi, Hacı Bektaş Veli, Yunus Emre","Sadece Süleyman Çelebi","Sadece Mevlana","Sadece Neşet Ertaş"], dogru:0, aciklama:"Naatın ilk örneklerini Yusuf Has Hacip, Hoca Ahmet Yesevi, Hacı Bektaş Veli, Yunus Emre yazmıştır."},
  {zorluk:"zor", soru:"\"Divan-ı Hikmet\" adlı eseri kim yazmıştır?", secenekler:["Hoca Ahmet Yesevi","Hacı Bektaş Veli","Yunus Emre","Mevlana"], dogru:0, aciklama:"Divan-ı Hikmet, Hoca Ahmet Yesevi tarafından yazılmıştır."},
  {zorluk:"zor", soru:"\"Makalat\" adlı eseri kim yazmıştır?", secenekler:["Hacı Bektaş Veli","Hoca Ahmet Yesevi","Yunus Emre","Mevlana"], dogru:0, aciklama:"Makalat, Hacı Bektaş Veli tarafından yazılmıştır."},
  {zorluk:"zor", soru:"\"Mesnevi\" adlı eseri kim yazmıştır?", secenekler:["Mevlana Celalettin Rumi","Yunus Emre","Hacı Bektaş Veli","Hoca Ahmet Yesevi"], dogru:0, aciklama:"Mesnevi, Mevlana Celalettin Rumi tarafından yazılmıştır."},
  {zorluk:"zor", soru:"Hz. Peygamber'in adı anıldığında Kur'an'a göre müminlerden ne yapmaları istenir?", secenekler:["Salât ve selam etmeleri","Susmaları","Ağlamaları","Secde etmeleri"], dogru:0, aciklama:"Kur'an'a göre müminlerden Hz. Peygamber'e salât ve selam etmeleri istenir."},
  {zorluk:"zor", soru:"Kur'an-ı Kerim ve ezanı güzel okuma yarışmaları hangi kurum bünyesinde düzenlenir?", secenekler:["Millî Eğitim Bakanlığı","Sadece belediyeler","Sadece vakıflar","Sadece dernekler"], dogru:0, aciklama:"Bu yarışmalar Millî Eğitim Bakanlığı bünyesindeki okullarda düzenlenir."},
  {zorluk:"zor", soru:"İslam'ın Türk sanat ve halk müziğini etkilediğinin kanıtı olarak hangi ifadeler örnek gösterilir?", secenekler:["Allah, Hak, Yaradan, cennet, kader gibi dinî ifadeler","Sadece aşk şiirleri","Sadece doğa temaları","Sadece savaş temaları"], dogru:0, aciklama:"Musiki eserlerde çokça yer alan Allah, Hak, Yaradan, cennet, kader gibi dinî ifadeler bu etkiyi kanıtlar niteliktedir."},
];
let kt65rIndex = 0, kt65rPuan = 0, kt65rSiraliSorular = [], kt65rKilit = false;

function kt65rZayifAnahtari(){ return 'dkabZayifSorular_' + (typeof UNITE_KIMLIK !== 'undefined' ? UNITE_KIMLIK : location.pathname); }
function kt65rZayifOku(){
  try{ return JSON.parse(localStorage.getItem(kt65rZayifAnahtari())) || {}; }catch(e){ return {}; }
}
function kt65rZayifKaydet(soruMetni){
  const v = kt65rZayifOku();
  v[soruMetni] = (v[soruMetni]||0) + 1;
  try{ localStorage.setItem(kt65rZayifAnahtari(), JSON.stringify(v)); }catch(e){}
}
function kt65rAgirlikliKaristir(sorular){
  const zayif = kt65rZayifOku();
  return sorular
    .map(s => ({s, r: Math.random() - (zayif[s.soru]||0) * 0.15}))
    .sort((a,b)=>a.r-b.r)
    .map(x=>x.s);
}

function kt65rBaslat(){
  kt65rSiraliSorular = kt65rAgirlikliKaristir(konuTekrariSorulari65.slice());
  kt65rIndex = 0; kt65rPuan = 0;
  document.getElementById('kt65rPuan').textContent = 0;
  document.getElementById('kt65rToplam').textContent = kt65rSiraliSorular.length;
  document.getElementById('kt65rSonuc').textContent = '';
  document.getElementById('kt65rSonrakiBtn').style.display = 'none';
  kt65rSoruGoster();
}

function kt65rSoruGoster(){
  if(kt65rIndex >= kt65rSiraliSorular.length){
    document.getElementById('kt65rSoru').textContent = '';
    document.getElementById('kt65rSecenekler').innerHTML = '';
    document.getElementById('kt65rAciklama').style.display = 'none';
    document.getElementById('kt65rZorluk').textContent = '';
    document.getElementById('kt65rSonrakiBtn').style.display = 'none';
    const yuzde = Math.round((kt65rPuan/kt65rSiraliSorular.length)*100);
    let kt65rSeviye;
    if(yuzde>=90) kt65rSeviye = '🏆 Din Bilgisi Ustası';
    else if(yuzde>=70) kt65rSeviye = '🥇 Çok Başarılı';
    else if(yuzde>=50) kt65rSeviye = '🥈 Biraz Daha Çalış';
    else kt65rSeviye = '📚 Konuyu Tekrar Et';
    document.getElementById('kt65rSonuc').innerHTML = `🎉 Test bitti!<br><span style="font-size:1.25em;font-weight:bold;">${kt65rSeviye}</span><br>${kt65rPuan}/${kt65rSiraliSorular.length} doğru (%${yuzde})`;
    return;
  }
  kt65rKilit = false;
  document.getElementById('kt65rTur').textContent = kt65rIndex+1;
  const oge = kt65rSiraliSorular[kt65rIndex];
  const zorlukEtiket = oge.zorluk==='kolay' ? '🟢 Kolay' : oge.zorluk==='orta' ? '🟡 Orta' : '🔴 Zor';
  document.getElementById('kt65rZorluk').textContent = zorlukEtiket;
  document.getElementById('kt65rSoru').textContent = oge.soru;
  document.getElementById('kt65rAciklama').style.display = 'none';
  document.getElementById('kt65rAciklama').textContent = '';
  document.getElementById('kt65rSonrakiBtn').style.display = 'none';
  document.getElementById('kt65rSonuc').textContent = '';
  const kutu = document.getElementById('kt65rSecenekler');
  kutu.innerHTML = '';
  oge.secenekler.forEach((sec,i)=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = sec;
    btn.onclick = ()=>{
      if(kt65rKilit) return;
      kt65rKilit = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(i===oge.dogru){
        btn.classList.add('dogru');
        kt65rPuan++;
        document.getElementById('kt65rPuan').textContent = kt65rPuan;
      } else {
        btn.classList.add('yanlis');
        tumBtn[oge.dogru].classList.add('dogru');
        kt65rZayifKaydet(oge.soru);
      }
      const aciklamaKutu = document.getElementById('kt65rAciklama');
      aciklamaKutu.style.display = 'block';
      aciklamaKutu.innerHTML = `💡 <b>Açıklama:</b> ${oge.aciklama}`;
      document.getElementById('kt65rSonrakiBtn').style.display = 'block';
    };
    kutu.appendChild(btn);
  });
}

function kt65rSonrakiSoru(){
  kt65rIndex++;
  kt65rSoruGoster();
}

// =====================================================================
// 5. ÜNİTE KELİME HAVUZU (28 kavram) — 6. Sınıf
// =====================================================================
const kelimeHavuzu65 = [
  {kelime:"KÜLTÜR", anlam:"Bir toplumun maddi ve manevi değerlerinin bütünü"},
  {kelime:"ÖRF", anlam:"Toplumun uzun sürede oluşturup benimsediği, yazılı olmayan kurallar (örf ve âdet)"},
  {kelime:"MEVLİT", anlam:"Hz. Peygamber'in doğumunu ve hayatından kesitleri anlatan eser/program"},
  {kelime:"TAZİYE", anlam:"Yakını vefat eden birine başsağlığı dileğinde bulunma, teselli etme"},
  {kelime:"KANDİL", anlam:"Mevlit, Regaip, Miraç, Berat olmak üzere dört önemli gecenin genel adı"},
  {kelime:"MAHYA", anlam:"Ramazan ayında iki minare arasına asılan ışıklı yazılar"},
  {kelime:"SADAKA", anlam:"Osmanlı'da yaygınlaşan, ihtiyaç sahiplerinin alması için cami avlusuna bırakılan yardım (sadaka taşı)"},
  {kelime:"ZİMEM", anlam:"Arapçada \"borçlar\" anlamına gelen, veresiye alışverişte borçların yazıldığı defter geleneği"},
  {kelime:"VAKIF", anlam:"Bir maldan yararlanma hakkını Allah rızası için topluma özgüleyen, satılmasını yasaklayan uygulama"},
  {kelime:"AŞURE", anlam:"Muharrem ayının onuncu gününde yapılıp dağıtılan tatlı, aynı zamanda bu güne verilen ad"},
  {kelime:"MUHARREM", anlam:"Aşure gününü de içine alan, hicri takvimin ilk ayı"},
  {kelime:"EHLİBEYT", anlam:"Hz. Muhammed'in aile fertleri için kullanılan kavram, \"ev halkı\" anlamına gelir"},
  {kelime:"SALAVAT", anlam:"Hz. Peygamber'e selam ve dua etmek anlamına gelen sözler"},
  {kelime:"EZAN", anlam:"Namaz vakitlerinin geldiğini duyurmak için okunan çağrı sözleri"},
  {kelime:"KAMET", anlam:"Farz namazlardan önce ezana \"namaz başlamak üzeredir\" ifadesinin eklenerek okunması"},
  {kelime:"İLAHİ", anlam:"Allah'ı övme ve O'na dua etme amacıyla yazılıp bestelenen dinî şiirler"},
  {kelime:"SELA", anlam:"Önemli gün ve geceleri hatırlatmak, cenaze namazını haber vermek için minarelerde okunan dua"},
  {kelime:"TEVHİT", anlam:"Yüce Allah'ın varlığını ve birliğini anlatan edebî eser türü"},
  {kelime:"MÜNACAT", anlam:"Allah'a dua etmek amacıyla yazılan şiir türü"},
  {kelime:"NAAT", anlam:"Hz. Peygamber'i ve özelliklerini öven şiir türü"},
  {kelime:"MEVLİTHAN", anlam:"Güzel sesiyle mevlit okuyan kişi"},
  {kelime:"TEKBİR", anlam:"\"Allahüekber\" ifadesiyle Allah'ın büyüklüğünü anma, İtri'nin bestelediği eser"},
  {kelime:"EDEBİYAT", anlam:"Olay, duygu ve düşüncelerin sözlü ya da yazılı olarak ifade edilmesi"},
  {kelime:"MUSİKİ", anlam:"Kulağa hoş gelen sesler dizisi, müzik"},
  {kelime:"HIRKAYIŞERİF", anlam:"Hz. Peygamber'in, Veysel Karani'ye gönderdiği kabul edilen hırkası"},
  {kelime:"VAKFİYE", anlam:"Bir vakfın kurucusu tarafından düzenlenen, vakfın işleyişiyle ilgili resmî belge"},
  {kelime:"DİŞKİRASI", anlam:"Osmanlı'da saray ve konaklarda iftar sonrası misafirlere verilen para ve hediyeler"},
  {kelime:"NİNNİ", anlam:"Annelerin bebeklerini uyuturken dinî ögelerle söylediği ezgili sözler"},
];
function ku65AnlamBul(kelime){
  const bulunan = kelimeHavuzu65.find(x=>x.kelime===kelime);
  return bulunan ? bulunan.anlam : '';
}

// =====================================================================
// HIZLI KELİME ÜRETME
// =====================================================================
const ku65GecerliHarfler = ["K","M","T","S","V","E","N"];
let ku65AktifHarf = '', ku65Bulunanlar = [], ku65Sure = 60, ku65Zamanlayici = null, ku65Puan = 0, ku65Bitti = true;

function ku65Baslat(){
  clearInterval(ku65Zamanlayici);
  ku65AktifHarf = ku65GecerliHarfler[Math.floor(Math.random()*ku65GecerliHarfler.length)];
  ku65Bulunanlar = []; ku65Puan = 0; ku65Sure = 60; ku65Bitti = false;
  document.getElementById('ku65Harf').textContent = ku65AktifHarf;
  document.getElementById('ku65Sure').textContent = ku65Sure;
  document.getElementById('ku65Puan').textContent = 0;
  document.getElementById('ku65Liste').innerHTML = '';
  document.getElementById('ku65Sonuc').textContent = '';
  document.getElementById('ku65Uyari').textContent = '';
  document.getElementById('ku65Kacirilan').innerHTML = '';
  const girdi = document.getElementById('ku65Girdi');
  girdi.value = ''; girdi.disabled = false; girdi.focus();
  ku65Zamanlayici = setInterval(()=>{
    ku65Sure--;
    document.getElementById('ku65Sure').textContent = ku65Sure;
    if(ku65Sure<=0) ku65Bitir();
  }, 1000);
}

function ku65Ekle(){
  if(ku65Bitti) return;
  const girdi = document.getElementById('ku65Girdi');
  const kelime = girdi.value.trim().toLocaleUpperCase('tr-TR');
  girdi.value = '';
  if(!kelime) return;
  const uyari = document.getElementById('ku65Uyari');
  if(!kelime.startsWith(ku65AktifHarf)){ uyari.textContent = `❌ "${ku65AktifHarf}" harfiyle başlamalı!`; return; }
  if(!kelimeHavuzu65.some(x=>x.kelime===kelime)){ uyari.textContent = `🤔 Bu kelimeyi bilmiyorum, ünitedeki bir kavram olmalı!`; return; }
  if(ku65Bulunanlar.includes(kelime)){ uyari.textContent = `⚠️ Bu kelimeyi zaten yazdın!`; return; }
  ku65Bulunanlar.push(kelime);
  ku65Puan++;
  document.getElementById('ku65Puan').textContent = ku65Puan;
  const li = document.createElement('li');
  li.textContent = kelime;
  document.getElementById('ku65Liste').appendChild(li);
  uyari.textContent = '';
}

function ku65Bitir(){
  clearInterval(ku65Zamanlayici);
  ku65Bitti = true;
  document.getElementById('ku65Girdi').disabled = true;
  document.querySelectorAll('#ku65Liste li').forEach(li=>{
    const kelime = li.textContent;
    li.textContent = `${kelime} — ${ku65AnlamBul(kelime)}`;
  });
  const kacirilanKutu = document.getElementById('ku65Kacirilan');
  kacirilanKutu.innerHTML = '';
  const kacirilanlar = kelimeHavuzu65.filter(x=>x.kelime.startsWith(ku65AktifHarf) && !ku65Bulunanlar.includes(x.kelime));
  if(kacirilanlar.length){
    const baslik = document.createElement('p');
    baslik.style.textAlign='center'; baslik.style.fontWeight='bold'; baslik.style.color='var(--kirmizi)';
    baslik.textContent = 'Kaçırdıkların:';
    kacirilanKutu.appendChild(baslik);
    const ul = document.createElement('ul'); ul.className='ku-liste';
    kacirilanlar.forEach(item=>{
      const li = document.createElement('li');
      li.style.background='#ffe8d6'; li.style.borderColor='var(--sari)';
      li.textContent = `${item.kelime} — ${item.anlam}`;
      ul.appendChild(li);
    });
    kacirilanKutu.appendChild(ul);
  }
  document.getElementById('ku65Sonuc').textContent = `⏰ Süre bitti! "${ku65AktifHarf}" harfiyle ${ku65Puan} doğru kelime yazdın!`;
}

// =====================================================================
// TUZAK HARF
// =====================================================================
const tuzak65GecerliHarfler = ["A","E","İ","M","T"];
let tuzak65Harf = '', tuzak65Bulunanlar = [], tuzak65Sure = 40, tuzak65Zamanlayici = null, tuzak65Puan = 0, tuzak65Bitti = true;

function tuzak65Baslat(){
  clearInterval(tuzak65Zamanlayici);
  tuzak65Harf = tuzak65GecerliHarfler[Math.floor(Math.random()*tuzak65GecerliHarfler.length)];
  tuzak65Bulunanlar = []; tuzak65Puan = 0; tuzak65Sure = 40; tuzak65Bitti = false;
  document.getElementById('tuzak65Harf').textContent = tuzak65Harf;
  document.getElementById('tuzak65Sure').textContent = tuzak65Sure;
  document.getElementById('tuzak65Puan').textContent = 0;
  document.getElementById('tuzak65Liste').innerHTML = '';
  document.getElementById('tuzak65Sonuc').textContent = '';
  document.getElementById('tuzak65Uyari').textContent = '';
  const girdi = document.getElementById('tuzak65Girdi');
  girdi.value = ''; girdi.disabled = false; girdi.focus();
  tuzak65Zamanlayici = setInterval(()=>{
    tuzak65Sure--;
    document.getElementById('tuzak65Sure').textContent = tuzak65Sure;
    if(tuzak65Sure<=0) tuzak65Bitir();
  }, 1000);
}

function tuzak65Ekle(){
  if(tuzak65Bitti) return;
  const girdi = document.getElementById('tuzak65Girdi');
  const kelime = girdi.value.trim().toLocaleUpperCase('tr-TR');
  girdi.value = '';
  if(!kelime) return;
  const uyari = document.getElementById('tuzak65Uyari');
  if(kelime.includes(tuzak65Harf)){ uyari.textContent = `🚫 Bu kelimede tuzak harf "${tuzak65Harf}" var, geçersiz!`; return; }
  if(!kelimeHavuzu65.some(x=>x.kelime===kelime)){ uyari.textContent = `🤔 Bu kelimeyi bilmiyorum, ünitedeki bir kavram olmalı!`; return; }
  if(tuzak65Bulunanlar.includes(kelime)){ uyari.textContent = `⚠️ Bu kelimeyi zaten yazdın!`; return; }
  tuzak65Bulunanlar.push(kelime);
  tuzak65Puan++;
  document.getElementById('tuzak65Puan').textContent = tuzak65Puan;
  const li = document.createElement('li');
  li.textContent = kelime;
  document.getElementById('tuzak65Liste').appendChild(li);
  uyari.textContent = '';
}

function tuzak65Bitir(){
  clearInterval(tuzak65Zamanlayici);
  tuzak65Bitti = true;
  document.getElementById('tuzak65Girdi').disabled = true;
  document.querySelectorAll('#tuzak65Liste li').forEach(li=>{
    const kelime = li.textContent;
    li.textContent = `${kelime} — ${ku65AnlamBul(kelime)}`;
  });
  document.getElementById('tuzak65Sonuc').textContent = `⏰ Süre bitti! "${tuzak65Harf}" harfini kullanmadan ${tuzak65Puan} kelime yazdın!`;
}

// =====================================================================
// KELİME FABRİKASI
// =====================================================================
let kf65Sira = [], kf65Index = 0, kf65Uretilen = 0, kf65Hata = 0;

function kf65Baslat(){
  kf65Sira = karistir(kelimeHavuzu65.slice());
  kf65Index = 0; kf65Uretilen = 0; kf65Hata = 0;
  document.getElementById('kf65Uretilen').textContent = 0;
  document.getElementById('kf65Toplam').textContent = kf65Sira.length;
  document.getElementById('kf65Hata').textContent = 0;
  document.getElementById('kf65Urunler').innerHTML = '';
  document.getElementById('kf65Sonuc').textContent = '';
  kf65Tur();
}

function kf65Tur(){
  if(kf65Index >= kf65Sira.length){
    document.getElementById('kf65BantAlani').innerHTML = '';
    document.getElementById('kf65Siparis').textContent = '';
    document.getElementById('kf65Girdi').disabled = true;
    document.getElementById('kf65Sonuc').textContent = `🏭 Fabrika kapandı! ${kf65Uretilen}/${kf65Sira.length} kelime ürettin, ${kf65Hata} hata yaptın.`;
    return;
  }
  const oge = kf65Sira[kf65Index];
  document.getElementById('kf65Siparis').textContent = `📋 Sipariş: ${oge.anlam}`;
  const harfler = karistir(oge.kelime.split(''));
  const bant = document.getElementById('kf65BantAlani');
  bant.innerHTML = '';
  harfler.forEach(h=>{
    const kutu = document.createElement('div');
    kutu.className = 'kf-kutu';
    kutu.textContent = h;
    bant.appendChild(kutu);
  });
  const girdi = document.getElementById('kf65Girdi');
  girdi.value = ''; girdi.disabled = false; girdi.focus();
}

function kf65Uret(){
  if(kf65Index >= kf65Sira.length) return;
  const oge = kf65Sira[kf65Index];
  const girdi = document.getElementById('kf65Girdi');
  const tahmin = girdi.value.trim().toLocaleUpperCase('tr-TR');
  if(!tahmin) return;
  if(tahmin === oge.kelime){
    kf65Uretilen++;
    document.getElementById('kf65Uretilen').textContent = kf65Uretilen;
    const cip = document.createElement('div');
    cip.className = 'dua-cip';
    cip.textContent = `✅ ${oge.kelime}`;
    document.getElementById('kf65Urunler').appendChild(cip);
    kf65Index++;
    setTimeout(()=>kf65Tur(), 400);
  } else {
    kf65Hata++;
    document.getElementById('kf65Hata').textContent = kf65Hata;
    girdi.classList.add('yanlis-girdi');
    setTimeout(()=>girdi.classList.remove('yanlis-girdi'), 400);
    girdi.value = '';
  }
}

// =====================================================================
// KELİME MÜHENDİSİ
// =====================================================================
function parcalaraBol(kelime){
  const uzunluk = kelime.length;
  let parcaSayisi = uzunluk<=4 ? 2 : uzunluk<=7 ? 3 : 4;
  parcaSayisi = Math.min(parcaSayisi, uzunluk);
  const parcalar = [];
  let index = 0;
  for(let i=0;i<parcaSayisi;i++){
    const kalan = parcaSayisi - i;
    const buBoyut = i===parcaSayisi-1 ? uzunluk-index : Math.ceil((uzunluk-index)/kalan);
    parcalar.push(kelime.slice(index, index+buBoyut));
    index += buBoyut;
  }
  return parcalar;
}

let km65Sira = [], km65Index = 0, km65DogruSayisi = 0;

function km65Baslat(){
  km65Sira = karistir(kelimeHavuzu65.slice());
  km65Index = 0; km65DogruSayisi = 0;
  document.getElementById('km65Dogru').textContent = 0;
  document.getElementById('km65Toplam').textContent = km65Sira.length;
  document.getElementById('km65Sonuc').textContent = '';
  km65Tur();
}

function km65Tur(){
  if(km65Index >= km65Sira.length){
    document.getElementById('km65Ipucu').textContent = '';
    document.getElementById('km65Banka').innerHTML = '';
    document.getElementById('km65Cevap').innerHTML = '';
    document.getElementById('km65Sonuc').textContent = `🏆 Tebrikler! Kelime mühendisliğini tamamladın! ${km65DogruSayisi}/${km65Sira.length} kelime inşa ettin.`;
    return;
  }
  document.getElementById('km65Tur').textContent = km65Index+1;
  const oge = km65Sira[km65Index];
  document.getElementById('km65Ipucu').innerHTML = `📐 Plan: <b>${oge.anlam}</b>`;
  const parcalar = parcalaraBol(oge.kelime);
  siraOlustur({tokens:parcalar, bankaId:'km65Banka', cevapId:'km65Cevap', tamamlandi:()=>{
    km65DogruSayisi++;
    document.getElementById('km65Dogru').textContent = km65DogruSayisi;
    document.getElementById('km65Sonuc').textContent = `✅ İnşa edildi: ${oge.kelime}`;
    km65Index++;
    setTimeout(()=>{ document.getElementById('km65Sonuc').textContent=''; km65Tur(); }, 1000);
  }});
}

// =====================================================================
// KAVRAM TURNUVASI
// =====================================================================
const turnuvaEslesmeler65 = [
  {tur:"Çeyrek Final 1", a:"EZAN", b:"KAMET", soru:"Hangisi namaz vakitlerinin geldiğini duyurmak için okunan çağrıdır?", dogruCevap:"EZAN"},
  {tur:"Çeyrek Final 2", a:"MEVLİT", b:"TAZİYE", soru:"Hangisi Hz. Peygamber'in doğumunu ve hayatını anlatan programdır?", dogruCevap:"MEVLİT"},
  {tur:"Çeyrek Final 3", a:"SALAVAT", b:"İLAHİ", soru:"Hangisi Hz. Peygamber'e selam ve dua etmek anlamına gelen sözlerdir?", dogruCevap:"SALAVAT"},
  {tur:"Çeyrek Final 4", a:"VAKIF", b:"SADAKA", soru:"Hangisi bir malı satmayı yasaklayarak toplum kullanımına özgülemektir?", dogruCevap:"VAKIF"},
  {tur:"Yarı Final 1", a:"EZAN", b:"MEVLİT", soru:"Hangisi musiki alanında bir kavramdır, gelenek değildir?", dogruCevap:"EZAN"},
  {tur:"Yarı Final 2", a:"SALAVAT", b:"VAKIF", soru:"Hangisi Hz. Peygamber'e dua etmekle ilgilidir, mal bağışı değildir?", dogruCevap:"SALAVAT"},
  {tur:"FİNAL", a:"EZAN", b:"SALAVAT", soru:"Hangisi namaza çağrı sözleridir?", dogruCevap:"EZAN"},
];
let kt65Index = 0, kt65DogruHakemlik = 0;

function kt65Baslat(){
  kt65Index = 0; kt65DogruHakemlik = 0;
  document.getElementById('kt65Puan').textContent = 0;
  document.getElementById('kt65Toplam').textContent = turnuvaEslesmeler65.length;
  document.getElementById('kt65Sonuc').textContent = '';
  kt65Tur();
}

function kt65Tur(){
  if(kt65Index >= turnuvaEslesmeler65.length){
    document.getElementById('kt65Asama').textContent = '';
    document.getElementById('kt65Eslesme').textContent = '';
    document.getElementById('kt65Secenekler').innerHTML = '';
    const sampiyon = turnuvaEslesmeler65[turnuvaEslesmeler65.length-1].dogruCevap;
    document.getElementById('kt65Sonuc').textContent = `🏆 Turnuva Şampiyonu: ${sampiyon}! Hakemlik doğruluğun: ${kt65DogruHakemlik}/${turnuvaEslesmeler65.length}`;
    return;
  }
  const mac = turnuvaEslesmeler65[kt65Index];
  document.getElementById('kt65Tur').textContent = kt65Index+1;
  document.getElementById('kt65Asama').textContent = mac.tur;
  document.getElementById('kt65Eslesme').innerHTML = `🥊 <b>${mac.a}</b> vs <b>${mac.b}</b><br>❓ ${mac.soru}`;
  const kutu = document.getElementById('kt65Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  [mac.a, mac.b].forEach(aday=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = aday;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      tiklandiMi = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(aday === mac.dogruCevap){
        btn.classList.add('dogru');
        kt65DogruHakemlik++;
        document.getElementById('kt65Puan').textContent = kt65DogruHakemlik;
      } else {
        btn.classList.add('yanlis');
        tumBtn.forEach(b=>{ if(b.textContent===mac.dogruCevap) b.classList.add('dogru'); });
      }
      kt65Index++;
      setTimeout(()=>kt65Tur(), 1300);
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// BONUS OYUN — Hafıza Zinciri
// =====================================================================
const bz65Tuslar = [
  {simge:"KÜLTÜR", renk:"#2a6f97"}, {simge:"MEVLİT", renk:"#40916c"}, {simge:"TAZİYE", renk:"#f4a261"},
  {simge:"KANDİL", renk:"#d62828"}, {simge:"MAHYA", renk:"#7b2cbf"}, {simge:"VAKIF", renk:"#0077b6"},
  {simge:"AŞURE", renk:"#e76f51"}, {simge:"EHLİBEYT", renk:"#2d6a4f"}, {simge:"SALAVAT", renk:"#9d4edd"},
  {simge:"EZAN", renk:"#457b9d"}, {simge:"KAMET", renk:"#c9184a"}, {simge:"İLAHİ", renk:"#e09f3e"},
];
let bz65Sira = [], bz65KullaniciIndex = 0, bz65Seviye = 0, bz65Oynatiliyor = false;

function bz65IzgaraOlustur(){
  const izgara = document.getElementById('bz65Izgara');
  izgara.innerHTML = '';
  bz65Tuslar.forEach((t,i)=>{
    const tus = document.createElement('div');
    tus.className = 'bz-tus';
    tus.style.background = t.renk;
    tus.textContent = t.simge;
    tus.onclick = ()=>bz65TusaTikla(i);
    izgara.appendChild(tus);
  });
}
function bz65Baslat(){
  bz65Sira = []; bz65Seviye = 0; bz65KullaniciIndex = 0;
  document.getElementById('bz65Seviye').textContent = 0;
  document.getElementById('bz65Sonuc').textContent = '';
  bz65IzgaraOlustur();
  bz65SonrakiTur();
}
function bz65SonrakiTur(){
  bz65Seviye++;
  document.getElementById('bz65Seviye').textContent = bz65Seviye;
  bz65Sira.push(Math.floor(Math.random()*bz65Tuslar.length));
  bz65KullaniciIndex = 0;
  bz65Oynat();
}
function bz65Oynat(){
  bz65Oynatiliyor = true;
  const dugmeler = document.querySelectorAll('#bz65Izgara .bz-tus');
  dugmeler.forEach(d=>d.classList.add('bz-devre-disi'));
  let i = 0;
  const aralik = setInterval(()=>{
    if(i>0) dugmeler[bz65Sira[i-1]].classList.remove('bz-yanik');
    if(i>=bz65Sira.length){
      clearInterval(aralik);
      bz65Oynatiliyor = false;
      dugmeler.forEach(d=>d.classList.remove('bz-devre-disi'));
      return;
    }
    dugmeler[bz65Sira[i]].classList.add('bz-yanik');
    i++;
  }, 700);
}
function bz65TusaTikla(i){
  if(bz65Oynatiliyor) return;
  const dugmeler = document.querySelectorAll('#bz65Izgara .bz-tus');
  dugmeler[i].classList.add('bz-yanik');
  setTimeout(()=>dugmeler[i].classList.remove('bz-yanik'), 250);
  if(bz65Sira[bz65KullaniciIndex] === i){
    bz65KullaniciIndex++;
    if(bz65KullaniciIndex === bz65Sira.length){
      setTimeout(()=>bz65SonrakiTur(), 900);
    }
  } else {
    document.getElementById('bz65Sonuc').textContent = `💥 Yanlış sıra! En uzun hatırladığın zincir: ${bz65Seviye-1}`;
  }
}
function bz65OrnekOyna(){
  document.getElementById('bz65Sonuc').textContent = '🎬 Örnek gösteriliyor: önce sıra yanacak, sonra otomatik olarak aynı sırayla tıklanacak...';
  document.getElementById('bz65Seviye').textContent = 'Örnek';
  bz65IzgaraOlustur();
  const demoSira = [0, 2, 1];
  const dugmeler = document.querySelectorAll('#bz65Izgara .bz-tus');
  dugmeler.forEach(d=>d.classList.add('bz-devre-disi'));
  let i = 0;
  const gosterAralik = setInterval(()=>{
    if(i>0) dugmeler[demoSira[i-1]].classList.remove('bz-yanik');
    if(i >= demoSira.length){
      clearInterval(gosterAralik);
      let j = 0;
      const tiklaAralik = setInterval(()=>{
        if(j>0) dugmeler[demoSira[j-1]].classList.remove('bz-yanik');
        if(j >= demoSira.length){
          clearInterval(tiklaAralik);
          dugmeler.forEach(d=>d.classList.remove('bz-devre-disi'));
          document.getElementById('bz65Seviye').textContent = 0;
          document.getElementById('bz65Sonuc').textContent = '👆 Gördüğün gibi: önce kavramlar sırayla yandı, sonra aynı sırayla tıklandı. Şimdi sıra sende — "Oyunu Başlat"a bas!';
          return;
        }
        dugmeler[demoSira[j]].classList.add('bz-yanik');
        j++;
      }, 700);
      return;
    }
    dugmeler[demoSira[i]].classList.add('bz-yanik');
    i++;
  }, 700);
}

// =====================================================================
// KELİME AVI BULMACASI
// =====================================================================
const kelimeAvi65Listesi = [
  {kelime:"KÜLTÜR", anlam:"Bir toplumun maddi ve manevi değerlerinin bütünü"},
  {kelime:"MEVLİT", anlam:"Hz. Peygamber'in doğumunu ve hayatından kesitleri anlatan eser/program"},
  {kelime:"TAZİYE", anlam:"Yakını vefat eden birine başsağlığı dileğinde bulunma, teselli etme"},
  {kelime:"KANDİL", anlam:"Mevlit, Regaip, Miraç, Berat olmak üzere dört önemli gecenin genel adı"},
  {kelime:"MAHYA", anlam:"Ramazan ayında iki minare arasına asılan ışıklı yazılar"},
  {kelime:"SADAKA", anlam:"Osmanlı'da yaygınlaşan, ihtiyaç sahiplerinin alması için cami avlusuna bırakılan yardım (sadaka taşı)"},
  {kelime:"ZİMEM", anlam:"Arapçada \"borçlar\" anlamına gelen, veresiye alışverişte borçların yazıldığı defter geleneği"},
  {kelime:"VAKIF", anlam:"Bir maldan yararlanma hakkını Allah rızası için topluma özgüleyen, satılmasını yasaklayan uygulama"},
  {kelime:"AŞURE", anlam:"Muharrem ayının onuncu gününde yapılıp dağıtılan tatlı, aynı zamanda bu güne verilen ad"},
  {kelime:"EHLİBEYT", anlam:"Hz. Muhammed'in aile fertleri için kullanılan kavram, \"ev halkı\" anlamına gelir"},
  {kelime:"SALAVAT", anlam:"Hz. Peygamber'e selam ve dua etmek anlamına gelen sözler"},
  {kelime:"EZAN", anlam:"Namaz vakitlerinin geldiğini duyurmak için okunan çağrı sözleri"},
  {kelime:"KAMET", anlam:"Farz namazlardan önce ezana \"namaz başlamak üzeredir\" ifadesinin eklenerek okunması"},
  {kelime:"İLAHİ", anlam:"Allah'ı övme ve O'na dua etme amacıyla yazılıp bestelenen dinî şiirler"},
];
const ka65SatirSayisi = 14, ka65SutunSayisi = 14;
const ka65AsciiHarfler = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ";

function ka65KelimeYerlestir(izgara, kelime){
  const yonler = karistir([{dr:0,dc:1},{dr:0,dc:-1},{dr:1,dc:0},{dr:-1,dc:0}]);
  for(let deneme=0; deneme<200; deneme++){
    const yon = yonler[deneme % yonler.length];
    const satir = Math.floor(Math.random()*ka65SatirSayisi);
    const sutun = Math.floor(Math.random()*ka65SutunSayisi);
    const bitSatir = satir + yon.dr*(kelime.length-1);
    const bitSutun = sutun + yon.dc*(kelime.length-1);
    if(bitSatir<0 || bitSatir>=ka65SatirSayisi || bitSutun<0 || bitSutun>=ka65SutunSayisi) continue;
    let uygun = true;
    for(let i=0;i<kelime.length;i++){
      const r = satir + yon.dr*i, c = sutun + yon.dc*i;
      if(izgara[r][c] !== null && izgara[r][c] !== kelime[i]){ uygun=false; break; }
    }
    if(!uygun) continue;
    const hucreler=[];
    for(let i=0;i<kelime.length;i++){
      const r = satir + yon.dr*i, c = sutun + yon.dc*i;
      izgara[r][c] = kelime[i];
      hucreler.push({r,c});
    }
    return hucreler;
  }
  return null;
}

function kelimeAvi65Olustur(){
  let izgara, basarili=false;
  for(let genelDeneme=0; genelDeneme<40 && !basarili; genelDeneme++){
    izgara = Array.from({length:ka65SatirSayisi}, ()=>Array(ka65SutunSayisi).fill(null));
    basarili = true;
    const siraliKelimeler = kelimeAvi65Listesi.slice().sort((a,b)=>b.kelime.length-a.kelime.length);
    for(const item of siraliKelimeler){
      const hucreler = ka65KelimeYerlestir(izgara, item.kelime);
      if(!hucreler){ basarili=false; break; }
    }
  }
  for(let r=0;r<ka65SatirSayisi;r++){
    for(let c=0;c<ka65SutunSayisi;c++){
      if(izgara[r][c]===null) izgara[r][c] = ka65AsciiHarfler[Math.floor(Math.random()*ka65AsciiHarfler.length)];
    }
  }

  const kutu = document.getElementById('ka65Izgara');
  kutu.innerHTML = '';
  kutu.style.gridTemplateColumns = `repeat(${ka65SutunSayisi}, 1fr)`;
  const hucreElemanlari = [];
  for(let r=0;r<ka65SatirSayisi;r++){
    hucreElemanlari.push([]);
    for(let c=0;c<ka65SutunSayisi;c++){
      const h = document.createElement('div');
      h.className = 'ka-hucre';
      h.textContent = izgara[r][c];
      h.dataset.r = r; h.dataset.c = c;
      kutu.appendChild(h);
      hucreElemanlari[r].push(h);
    }
  }

  const liste = document.getElementById('ka65Liste');
  liste.innerHTML = '';
  kelimeAvi65Listesi.forEach(item=>{
    const li = document.createElement('li');
    li.id = 'ka65-kelime-' + item.kelime;
    li.textContent = `${item.kelime} — ${item.anlam}`;
    liste.appendChild(li);
  });
  document.getElementById('ka65Bulunan').textContent = 0;
  document.getElementById('ka65Toplam').textContent = kelimeAvi65Listesi.length;
  document.getElementById('ka65Sonuc').textContent = '';

  let ilkHucre = null;
  hucreElemanlari.flat().forEach(h=>{
    h.onclick = ()=>{
      if(h.classList.contains('ka-bulundu')) return;
      if(!ilkHucre){ ilkHucre = h; h.classList.add('ka-secili'); return; }
      if(ilkHucre === h){ ilkHucre.classList.remove('ka-secili'); ilkHucre=null; return; }
      const r1=+ilkHucre.dataset.r, c1=+ilkHucre.dataset.c;
      const r2=+h.dataset.r, c2=+h.dataset.c;
      let yol = [];
      if(r1===r2){
        const adim = c2>c1?1:-1;
        for(let c=c1;;c+=adim){ yol.push({r:r1,c}); if(c===c2) break; }
      } else if(c1===c2){
        const adim = r2>r1?1:-1;
        for(let r=r1;;r+=adim){ yol.push({r,c:c1}); if(r===r2) break; }
      } else {
        ilkHucre.classList.remove('ka-secili');
        h.classList.add('ka-secili');
        ilkHucre = h;
        return;
      }
      const secilenKelime = yol.map(p=>izgara[p.r][p.c]).join('');
      const tersKelime = secilenKelime.split('').reverse().join('');
      const eslesen = kelimeAvi65Listesi.find(item =>
        (item.kelime===secilenKelime || item.kelime===tersKelime) &&
        !document.getElementById('ka65-kelime-'+item.kelime).classList.contains('bulundu-satir')
      );
      if(eslesen){
        yol.forEach(p=>{
          hucreElemanlari[p.r][p.c].classList.remove('ka-secili');
          hucreElemanlari[p.r][p.c].classList.add('ka-bulundu');
        });
        document.getElementById('ka65-kelime-'+eslesen.kelime).classList.add('bulundu-satir');
        const bulunanSayisi = document.querySelectorAll('#ka65Liste .bulundu-satir').length;
        document.getElementById('ka65Bulunan').textContent = bulunanSayisi;
        if(bulunanSayisi === kelimeAvi65Listesi.length){
          document.getElementById('ka65Sonuc').textContent = '🎉 Tebrikler! Tüm kelimeleri buldun!';
        }
      } else {
        ilkHucre.classList.remove('ka-secili');
      }
      ilkHucre = null;
    };
  });
}

// =====================================================================
// ÇENGEL BULMACA
// =====================================================================
const cengel65Zinciri = [
  {kelime:"MEVLİT", anlam:"Hz. Peygamber'in doğumunu ve hayatından kesitleri anlatan eser/program"},
  {kelime:"TAZİYE", anlam:"Yakını vefat eden birine başsağlığı dileğinde bulunma, teselli etme"},
  {kelime:"EZAN", anlam:"Namaz vakitlerinin geldiğini duyurmak için okunan çağrı sözleri"},
  {kelime:"NAAT", anlam:"Hz. Peygamber'i ve özelliklerini öven şiir türü"},
  {kelime:"TEKBİR", anlam:"\"Allahüekber\" ifadesiyle Allah'ın büyüklüğünü anma, İtri'nin bestelediği eser"},
];
let cengel65HucreHarita = {}, cengel65InputMap = {};

function cengel65Olustur(){
  let r=0, c=0, dir='right';
  const yerlesimler = [];
  cengel65Zinciri.forEach(item=>{
    const kelime = item.kelime;
    const hucreler = [];
    for(let j=0;j<kelime.length;j++){
      hucreler.push(dir==='right' ? {r, c:c+j} : {r:r+j, c});
    }
    yerlesimler.push({...item, hucreler, dir});
    const son = hucreler[hucreler.length-1];
    r = son.r; c = son.c;
    dir = dir==='right' ? 'down' : 'right';
  });

  let minR=Infinity,maxR=-Infinity,minC=Infinity,maxC=-Infinity;
  yerlesimler.forEach(p=>p.hucreler.forEach(h=>{
    minR=Math.min(minR,h.r); maxR=Math.max(maxR,h.r);
    minC=Math.min(minC,h.c); maxC=Math.max(maxC,h.c);
  }));
  const satirSayisi = maxR-minR+1, sutunSayisi = maxC-minC+1;

  cengel65HucreHarita = {};
  yerlesimler.forEach(p=>{
    p.hucreler.forEach((h,i)=>{
      const key = (h.r-minR)+','+(h.c-minC);
      cengel65HucreHarita[key] = p.kelime[i];
    });
  });

  const siraliHucreler = [];
  const gorulen = new Set();
  yerlesimler.forEach((p, idx)=>{
    const baslangic = idx===0 ? 0 : 1;
    for(let i=baslangic;i<p.hucreler.length;i++){
      const h = p.hucreler[i];
      const key = (h.r-minR)+','+(h.c-minC);
      if(!gorulen.has(key)){ gorulen.add(key); siraliHucreler.push(key); }
    }
  });

  const izgara = document.getElementById('cengel65Izgara');
  izgara.innerHTML = '';
  izgara.style.gridTemplateColumns = `repeat(${sutunSayisi}, 34px)`;
  izgara.style.gridTemplateRows = `repeat(${satirSayisi}, 34px)`;
  cengel65InputMap = {};
  for(let rr=0; rr<satirSayisi; rr++){
    for(let cc=0; cc<sutunSayisi; cc++){
      const key = rr+','+cc;
      const hucreDiv = document.createElement('div');
      hucreDiv.style.gridColumn = (cc+1);
      hucreDiv.style.gridRow = (rr+1);
      if(cengel65HucreHarita[key] !== undefined){
        hucreDiv.className = 'cengel-hucre';
        const girdi = document.createElement('input');
        girdi.maxLength = 1;
        girdi.className = 'cengel-girdi';
        girdi.dataset.key = key;
        girdi.oninput = (e)=>{
          e.target.value = e.target.value.toLocaleUpperCase('tr-TR').slice(-1);
          e.target.classList.remove('dogru','yanlis');
          const idx = siraliHucreler.indexOf(key);
          if(idx>=0 && idx<siraliHucreler.length-1){
            const sonrakiKey = siraliHucreler[idx+1];
            if(cengel65InputMap[sonrakiKey]) cengel65InputMap[sonrakiKey].focus();
          }
        };
        hucreDiv.appendChild(girdi);
        cengel65InputMap[key] = girdi;
      } else {
        hucreDiv.className = 'cengel-bos';
      }
      izgara.appendChild(hucreDiv);
    }
  }

  const liste = document.getElementById('cengel65Liste');
  liste.innerHTML = '';
  yerlesimler.forEach((p, idx)=>{
    const li = document.createElement('li');
    li.textContent = `${idx+1}. ${p.dir==='right'?'➡️':'⬇️'} (${p.kelime.length} harf) ${p.anlam}`;
    liste.appendChild(li);
  });

  document.getElementById('cengel65Sonuc').textContent = '';
}

function cengel65KontrolEt(){
  let dogruSayisi=0, toplam=0;
  Object.keys(cengel65HucreHarita).forEach(key=>{
    toplam++;
    const girdi = cengel65InputMap[key];
    const beklenen = cengel65HucreHarita[key];
    if(girdi.value && girdi.value.toLocaleUpperCase('tr-TR') === beklenen.toLocaleUpperCase('tr-TR')){
      girdi.classList.add('dogru'); girdi.classList.remove('yanlis');
      dogruSayisi++;
    } else {
      girdi.classList.add('yanlis'); girdi.classList.remove('dogru');
    }
  });
  document.getElementById('cengel65Sonuc').textContent = dogruSayisi===toplam
    ? `🎉 Tebrikler! Çengel bulmacayı tamamen doğru çözdün! (${dogruSayisi}/${toplam})`
    : `Sonuç: ${dogruSayisi}/${toplam} doğru harf. Devam et!`;
}

// =====================================================================
// SÖZCÜK MERDİVENİ
// =====================================================================
const merdiven65Zinciri = [
  {kelime:"SADAKA", anlam:"Osmanlı'da yaygınlaşan, ihtiyaç sahiplerinin alması için cami avlusuna bırakılan yardım (sadaka taşı)"},
  {kelime:"AŞURE", anlam:"Muharrem ayının onuncu gününde yapılıp dağıtılan tatlı"},
  {kelime:"EHLİBEYT", anlam:"Hz. Muhammed'in aile fertleri için kullanılan kavram, \"ev halkı\" anlamına gelir"},
  {kelime:"TEVHİT", anlam:"Yüce Allah'ın varlığını ve birliğini anlatan edebî eser türü"},
];
const merdiven65Havuz = ["KÜLTÜR","ÖRF","KANDİL","MAHYA","ZİMEM","VAKIF","MUHARREM","SALAVAT","KAMET","İLAHİ","SELA","MÜNACAT","MEVLİTHAN","EDEBİYAT","MUSİKİ","HIRKAYIŞERİF","VAKFİYE","DİŞKİRASI","NİNNİ"];
let merdiven65Index = 0;

function merdiven65Baslat(){
  merdiven65Index = 0;
  document.getElementById('merdiven65Toplam').textContent = merdiven65Zinciri.length;
  document.getElementById('merdiven65Sonuc').textContent = '';
  document.getElementById('merdiven65Gorsel').innerHTML = '';
  merdiven65BasamakEkle(merdiven65Zinciri[0].kelime, 0);
  merdiven65Tur();
}
function merdiven65BasamakEkle(kelime, index){
  const basamak = document.createElement('div');
  basamak.style.background='white'; basamak.style.border='2px solid var(--yesil)'; basamak.style.borderRadius='10px';
  basamak.style.padding='8px 14px'; basamak.style.margin='6px 0'; basamak.style.fontWeight='bold';
  basamak.style.marginLeft = (index*24) + 'px';
  basamak.textContent = `${index+1}. ${kelime}`;
  document.getElementById('merdiven65Gorsel').appendChild(basamak);
}
function merdiven65Tur(){
  document.getElementById('merdiven65Basamak').textContent = merdiven65Index+1;
  if(merdiven65Index+1 >= merdiven65Zinciri.length){
    document.getElementById('merdiven65Ipucu').textContent = '';
    document.getElementById('merdiven65Secenekler').innerHTML = '';
    document.getElementById('merdiven65Sonuc').textContent = '🎉 Tebrikler! Sözcük merdivenini tamamen tırmandın!';
    return;
  }
  const oncekiKelime = merdiven65Zinciri[merdiven65Index].kelime;
  const hedef = merdiven65Zinciri[merdiven65Index+1];
  const gerekliHarf = oncekiKelime[oncekiKelime.length-1];
  document.getElementById('merdiven65Ipucu').innerHTML = `🗨️ İpucu: <b>${hedef.anlam}</b><br>Bu kelime "<b>${gerekliHarf}</b>" harfiyle başlamalı!`;
  const yanlisHavuz = karistir(merdiven65Havuz.filter(k=>k!==hedef.kelime)).slice(0,3);
  const secenekler = karistir([hedef.kelime, ...yanlisHavuz]);
  const kutu = document.getElementById('merdiven65Secenekler');
  kutu.innerHTML = '';
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = secenek;
    btn.onclick = ()=>{
      if(secenek === hedef.kelime){
        btn.classList.add('dogru');
        merdiven65Index++;
        setTimeout(()=>{ merdiven65BasamakEkle(hedef.kelime, merdiven65Index); merdiven65Tur(); }, 700);
      } else {
        btn.classList.add('yanlis');
        setTimeout(()=>btn.classList.remove('yanlis'), 400);
      }
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// ŞİFRELİ SÖZCÜK
// =====================================================================
const turkAlfabesi65 = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ".split('');
let sifre65Anahtari = {};

function sifre65Olustur(){
  const sayilar = karistir(turkAlfabesi65.map((_,i)=>i+1));
  sifre65Anahtari = {};
  turkAlfabesi65.forEach((harf,i)=>{ sifre65Anahtari[harf] = sayilar[i]; });

  const anahtarKutu = document.getElementById('sifre65Anahtar');
  anahtarKutu.innerHTML = '';
  turkAlfabesi65.forEach(harf=>{
    const hucre = document.createElement('div');
    hucre.className = 'sifre-anahtar-hucre';
    hucre.innerHTML = `<b>${harf}</b><br>${sifre65Anahtari[harf]}`;
    anahtarKutu.appendChild(hucre);
  });

  const kutu = document.getElementById('sifre65Kelimeler');
  kutu.innerHTML = '';
  document.getElementById('sifre65Sonuc').textContent = '';

  kelimeHavuzu65.slice(0,20).forEach(item=>{
    const satir = document.createElement('div');
    satir.className = 'sifre-satir';
    const anlamP = document.createElement('p');
    anlamP.className = 'sifre-ipucu';
    anlamP.textContent = `💡 ${item.anlam}`;
    satir.appendChild(anlamP);

    const kutucuklar = document.createElement('div');
    kutucuklar.className = 'sifre-kutucuklar';
    const harfler = item.kelime.split('');
    const girdiler = [];
    harfler.forEach((harf)=>{
      const grup = document.createElement('div');
      grup.className = 'sifre-grup';
      const sayiEtiket = document.createElement('div');
      sayiEtiket.className = 'sifre-sayi';
      sayiEtiket.textContent = sifre65Anahtari[harf];
      const girdi = document.createElement('input');
      girdi.maxLength = 1;
      girdi.className = 'sifre-girdi';
      girdi.dataset.beklenen = harf;
      grup.appendChild(sayiEtiket);
      grup.appendChild(girdi);
      kutucuklar.appendChild(grup);
      girdiler.push(girdi);
    });
    girdiler.forEach((girdi, hIdx)=>{
      girdi.oninput = (e)=>{
        e.target.value = e.target.value.toLocaleUpperCase('tr-TR').slice(-1);
        e.target.classList.remove('dogru','yanlis');
        if(girdiler[hIdx+1]) girdiler[hIdx+1].focus();
      };
    });
    satir.appendChild(kutucuklar);
    kutu.appendChild(satir);
  });
}

function sifre65KontrolEt(){
  const girdiler = document.querySelectorAll('#sifre65Kelimeler .sifre-girdi');
  let dogruSayisi=0;
  girdiler.forEach(g=>{
    const beklenen = g.dataset.beklenen;
    if(g.value && g.value.toLocaleUpperCase('tr-TR') === beklenen.toLocaleUpperCase('tr-TR')){
      g.classList.add('dogru'); g.classList.remove('yanlis');
      dogruSayisi++;
    } else {
      g.classList.add('yanlis'); g.classList.remove('dogru');
    }
  });
  document.getElementById('sifre65Sonuc').textContent = dogruSayisi===girdiler.length
    ? `🎉 Tebrikler! Tüm şifreleri doğru çözdün! (${dogruSayisi}/${girdiler.length})`
    : `Sonuç: ${dogruSayisi}/${girdiler.length} doğru harf. Anahtar tablosuna bakarak devam et!`;
}

// =====================================================================
// ŞİFRELİ TANIM
// =====================================================================
const st65LeetHarita = {'a':'4','A':'4','e':'3','E':'3','i':'1','I':'1','İ':'1','ı':'1','o':'0','O':'0'};
function st65TanimSifrele(metin){
  return metin.split('').map(ch => st65LeetHarita[ch] !== undefined ? st65LeetHarita[ch] : ch).join('');
}
let st65Index = 0, st65Puan = 0, st65Sira = [];

function st65Baslat(){
  st65Sira = karistir(kelimeHavuzu65.slice());
  st65Index = 0; st65Puan = 0;
  document.getElementById('st65Puan').textContent = 0;
  document.getElementById('st65Toplam').textContent = st65Sira.length;
  document.getElementById('st65Sonuc').textContent = '';
  st65Tur();
}
function st65Tur(){
  if(st65Index >= st65Sira.length){
    document.getElementById('st65Tanim').textContent = '';
    document.getElementById('st65Secenekler').innerHTML = '';
    document.getElementById('st65Sonuc').textContent = `🏆 Tebrikler! ${st65Puan}/${st65Sira.length} şifreli tanımı doğru çözdün!`;
    return;
  }
  document.getElementById('st65Tur').textContent = st65Index+1;
  const oge = st65Sira[st65Index];
  document.getElementById('st65Tanim').textContent = st65TanimSifrele(oge.anlam);
  const digerler = karistir(kelimeHavuzu65.filter(x=>x.kelime!==oge.kelime)).slice(0,3);
  const secenekler = karistir([oge, ...digerler]);
  const kutu = document.getElementById('st65Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.style.display='block'; btn.style.width='100%'; btn.style.marginBottom='6px';
    btn.textContent = secenek.kelime;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      tiklandiMi = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(secenek.kelime === oge.kelime){
        btn.classList.add('dogru');
        st65Puan++;
        document.getElementById('st65Puan').textContent = st65Puan;
      } else {
        btn.classList.add('yanlis');
        tumBtn.forEach(b=>{ if(b.textContent===oge.kelime) b.classList.add('dogru'); });
      }
      st65Index++;
      setTimeout(()=>st65Tur(), 900);
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// KELİME KODLAMA
// =====================================================================
const kk65Alfabe = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ".split('');
const kk65KodTablosu = {};
kk65Alfabe.forEach((harf,i)=>{ kk65KodTablosu[harf] = (i+1).toString(2).padStart(5,'0'); });
function kk65KelimeyiKodla(kelime){
  return kelime.split('').map(h => kk65KodTablosu[h] || '?????').join(' ');
}
let kk65Index = 0, kk65Puan = 0, kk65Sira = [];

function kk65AnahtarOlustur(){
  const kutu = document.getElementById('kk65Anahtar');
  kutu.innerHTML = '';
  kk65Alfabe.forEach(harf=>{
    const hucre = document.createElement('div');
    hucre.className = 'sifre-anahtar-hucre';
    hucre.innerHTML = `<b>${harf}</b><br>${kk65KodTablosu[harf]}`;
    kutu.appendChild(hucre);
  });
}
function kk65Baslat(){
  kk65AnahtarOlustur();
  kk65Sira = karistir(kelimeHavuzu65.slice());
  kk65Index = 0; kk65Puan = 0;
  document.getElementById('kk65Puan').textContent = 0;
  document.getElementById('kk65Toplam').textContent = kk65Sira.length;
  document.getElementById('kk65Sonuc').textContent = '';
  kk65Tur();
}
function kk65Tur(){
  if(kk65Index >= kk65Sira.length){
    document.getElementById('kk65Kod').textContent = '';
    document.getElementById('kk65Ipucu').textContent = '';
    document.getElementById('kk65Secenekler').innerHTML = '';
    document.getElementById('kk65Sonuc').textContent = `🏆 Tebrikler! ${kk65Puan}/${kk65Sira.length} kodu doğru çözdün!`;
    return;
  }
  document.getElementById('kk65Tur').textContent = kk65Index+1;
  const oge = kk65Sira[kk65Index];
  document.getElementById('kk65Ipucu').innerHTML = `💡 İpucu: <b>${oge.anlam}</b>`;
  document.getElementById('kk65Kod').textContent = kk65KelimeyiKodla(oge.kelime);
  const digerler = karistir(kelimeHavuzu65.filter(x=>x.kelime!==oge.kelime)).slice(0,3);
  const secenekler = karistir([oge, ...digerler]);
  const kutu = document.getElementById('kk65Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.style.display='block'; btn.style.width='100%'; btn.style.marginBottom='6px';
    btn.textContent = secenek.kelime;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      tiklandiMi = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(secenek.kelime === oge.kelime){
        btn.classList.add('dogru');
        kk65Puan++;
        document.getElementById('kk65Puan').textContent = kk65Puan;
      } else {
        btn.classList.add('yanlis');
        tumBtn.forEach(b=>{ if(b.textContent===oge.kelime) b.classList.add('dogru'); });
      }
      kk65Index++;
      setTimeout(()=>kk65Tur(), 1000);
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// NONOGRAM
// =====================================================================
const nonogram65Resimleri = {
  camii: {
    etiket: "🕌 Cami (İbadet Yeri)",
    veri: [
      "0000000000000000","0000000000000000","0000000000001000","0000000000001100",
      "0000001000001100","0000111110001100","0001111111001100","0001111111001100",
      "0011111111101100","0011111111101100","0011111111101100","0011100111101100",
      "0011100111101100","0011100111111110","0000000000011110","0000000000000000",
    ],
  },
  hilal: {
    etiket: "🌙⭐ Hilal ve Yıldız",
    veri: [
      "0000000000000000","0000011111000000","0001111000001000","0011110000011100",
      "0011100000111110","0111100000011100","0111100000001000","0111000000000000",
      "0111100000000000","0111100000000000","0011100000000000","0011110000000000",
      "0001111000000000","0000011111000000","0000000000000000","0000000000000000",
    ],
  },
};
let nonogram65AktifResim = 'camii';
const nono65Boyut = nonogram65Resimleri.camii.veri.length;
let nono65KullaniciIzgara = [];
let nono65HucreElemanlari = [];

function ipucu65Hesapla(diziStr){
  const gruplar = diziStr.split('0').filter(s=>s.length>0).map(s=>s.length);
  return gruplar.length ? gruplar : [0];
}
function nonogram65Sec(resimAdi){ nonogram65AktifResim = resimAdi; nonogram65Olustur(); }
function nonogram65Olustur(){
  const cozum = nonogram65Resimleri[nonogram65AktifResim].veri;
  nono65KullaniciIzgara = Array.from({length:nono65Boyut}, ()=>Array(nono65Boyut).fill(false));
  document.getElementById('nono65Sonuc').textContent = '';
  const satirIpuclari = cozum.map(r=>ipucu65Hesapla(r));
  const sutunDizeleri = [];
  for(let c=0;c<nono65Boyut;c++){
    let s='';
    for(let r=0;r<nono65Boyut;r++) s += cozum[r][c];
    sutunDizeleri.push(s);
  }
  const sutunIpuclari = sutunDizeleri.map(s=>ipucu65Hesapla(s));
  const tablo = document.getElementById('nono65Tablo');
  tablo.innerHTML = '';
  const basSatir = document.createElement('tr');
  const koseTd = document.createElement('td');
  basSatir.appendChild(koseTd);
  for(let c=0;c<nono65Boyut;c++){
    const td = document.createElement('td');
    td.className = 'nono-sutun-ipucu';
    sutunIpuclari[c].forEach((sayi,i)=>{
      if(i>0) td.appendChild(document.createElement('br'));
      td.appendChild(document.createTextNode(sayi));
    });
    if((c+1)%5===0 && c<nono65Boyut-1) td.style.borderRight = '2px solid #333';
    basSatir.appendChild(td);
  }
  tablo.appendChild(basSatir);
  nono65HucreElemanlari = [];
  for(let r=0;r<nono65Boyut;r++){
    const tr = document.createElement('tr');
    const satirTd = document.createElement('td');
    satirTd.className = 'nono-satir-ipucu';
    satirTd.textContent = satirIpuclari[r].join(' ');
    if((r+1)%5===0 && r<nono65Boyut-1) satirTd.style.borderBottom = '2px solid #333';
    tr.appendChild(satirTd);
    nono65HucreElemanlari.push([]);
    for(let c=0;c<nono65Boyut;c++){
      const td = document.createElement('td');
      td.className = 'nono-hucre';
      if((c+1)%5===0 && c<nono65Boyut-1) td.style.borderRight = '2px solid #333';
      if((r+1)%5===0 && r<nono65Boyut-1) td.style.borderBottom = '2px solid #333';
      td.onclick = ((rr,cc)=>()=>{
        nono65KullaniciIzgara[rr][cc] = !nono65KullaniciIzgara[rr][cc];
        td.classList.toggle('dolu', nono65KullaniciIzgara[rr][cc]);
        nonogram65KontrolEt(false);
      })(r,c);
      tr.appendChild(td);
      nono65HucreElemanlari[r].push(td);
    }
    tablo.appendChild(tr);
  }
}
function nonogram65KontrolEt(manuel){
  const cozum = nonogram65Resimleri[nonogram65AktifResim].veri;
  let tamMi = true;
  for(let r=0;r<nono65Boyut;r++){
    for(let c=0;c<nono65Boyut;c++){
      const beklenen = cozum[r][c] === '1';
      if(nono65KullaniciIzgara[r][c] !== beklenen) tamMi = false;
    }
  }
  if(tamMi){
    document.getElementById('nono65Sonuc').textContent = `🎉 Tebrikler! Gizli resmi (${nonogram65Resimleri[nonogram65AktifResim].etiket}) doğru tamamladın!`;
  } else if(manuel){
    document.getElementById('nono65Sonuc').textContent = 'Henüz tam değil, ipuçlarına bakarak devam et!';
  }
}
function nonogram65Temizle(){
  nono65KullaniciIzgara = Array.from({length:nono65Boyut}, ()=>Array(nono65Boyut).fill(false));
  nono65HucreElemanlari.forEach(satir=>satir.forEach(td=>td.classList.remove('dolu')));
  document.getElementById('nono65Sonuc').textContent = '';
}

// =====================================================================
// KELİME SATRANCI
// =====================================================================
const ks65Boyut = 8;
const ks65AtHamleleri = [[1,2],[1,-2],[-1,2],[-1,-2],[2,1],[2,-1],[-2,1],[-2,-1]];
const ks65KelimeListesi = [
  {kelime:"ÖRF", anlam:"Toplumun uzun sürede oluşturup benimsediği, yazılı olmayan kurallar"},
  {kelime:"EZAN", anlam:"Namaz vakitlerinin geldiğini duyurmak için okunan çağrı sözleri"},
  {kelime:"SELA", anlam:"Önemli gün ve geceleri hatırlatmak, cenaze namazını haber vermek için minarelerde okunan dua"},
  {kelime:"NAAT", anlam:"Hz. Peygamber'i ve özelliklerini öven şiir türü"},
  {kelime:"KAMET", anlam:"Farz namazlardan önce ezana namaz başlama ifadesinin eklenerek okunması"},
  {kelime:"VAKIF", anlam:"Bir maldan yararlanma hakkını Allah rızası için topluma özgüleyen uygulama"},
  {kelime:"AŞURE", anlam:"Muharrem ayının onuncu gününde yapılıp dağıtılan tatlı"},
  {kelime:"NİNNİ", anlam:"Annelerin bebeklerini uyuturken dinî ögelerle söylediği ezgili sözler"},
];
const ks65AsciiHarfler = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ";
let ks65IzgaraVeri = [];
let ks65HucreElemanlari = [];
let ks65BulunanKelimeler = new Set();
let ks65Yol = [];

function ks65KelimeYerlestir(izgara, kelime){
  for(let deneme=0; deneme<300; deneme++){
    const gecici = izgara.map(satir=>satir.slice());
    const r0 = Math.floor(Math.random()*ks65Boyut);
    const c0 = Math.floor(Math.random()*ks65Boyut);
    if(gecici[r0][c0] !== null && gecici[r0][c0] !== kelime[0]) continue;
    gecici[r0][c0] = kelime[0];
    const hucreler = [{r:r0,c:c0}];
    const kullanilan = new Set([r0+','+c0]);
    let r=r0, c=c0, basarili=true;
    for(let i=1;i<kelime.length;i++){
      const olasilar = karistir(ks65AtHamleleri.slice()).filter(([dr,dc])=>{
        const nr=r+dr, nc=c+dc;
        if(nr<0 || nr>=ks65Boyut || nc<0 || nc>=ks65Boyut) return false;
        if(kullanilan.has(nr+','+nc)) return false;
        return gecici[nr][nc]===null || gecici[nr][nc]===kelime[i];
      });
      if(olasilar.length===0){ basarili=false; break; }
      const [dr,dc] = olasilar[0];
      r+=dr; c+=dc;
      gecici[r][c] = kelime[i];
      hucreler.push({r,c});
      kullanilan.add(r+','+c);
    }
    if(basarili){
      hucreler.forEach((h,i)=>{ izgara[h.r][h.c] = kelime[i]; });
      return hucreler;
    }
  }
  return null;
}
function ks65Olustur(){
  let izgara, basarili=false;
  for(let genelDeneme=0; genelDeneme<40 && !basarili; genelDeneme++){
    izgara = Array.from({length:ks65Boyut}, ()=>Array(ks65Boyut).fill(null));
    basarili = true;
    const siraliKelimeler = ks65KelimeListesi.slice().sort((a,b)=>b.kelime.length-a.kelime.length);
    for(const item of siraliKelimeler){
      const hucreler = ks65KelimeYerlestir(izgara, item.kelime);
      if(!hucreler){ basarili=false; break; }
    }
  }
  for(let r=0;r<ks65Boyut;r++){
    for(let c=0;c<ks65Boyut;c++){
      if(izgara[r][c]===null) izgara[r][c] = ks65AsciiHarfler[Math.floor(Math.random()*ks65AsciiHarfler.length)];
    }
  }
  ks65IzgaraVeri = izgara;
  ks65BulunanKelimeler = new Set();
  ks65Yol = [];
  const kutu = document.getElementById('ks65Izgara');
  kutu.innerHTML = '';
  ks65HucreElemanlari = [];
  for(let r=0;r<ks65Boyut;r++){
    ks65HucreElemanlari.push([]);
    for(let c=0;c<ks65Boyut;c++){
      const h = document.createElement('div');
      h.className = 'ks-hucre ' + ((r+c)%2===0 ? 'acik' : 'koyu');
      h.textContent = izgara[r][c];
      h.onclick = ()=>ks65Tikla(r,c);
      kutu.appendChild(h);
      ks65HucreElemanlari[r].push(h);
    }
  }
  const liste = document.getElementById('ks65Liste');
  liste.innerHTML = '';
  ks65KelimeListesi.forEach(item=>{
    const li = document.createElement('li');
    li.id = 'ks65-kelime-' + item.kelime;
    li.textContent = `${item.kelime} — ${item.anlam}`;
    liste.appendChild(li);
  });
  document.getElementById('ks65Bulunan').textContent = 0;
  document.getElementById('ks65Toplam').textContent = ks65KelimeListesi.length;
  document.getElementById('ks65Sonuc').textContent = '';
}
function ks65SecimiTemizle(){
  ks65Yol.forEach(p=>ks65HucreElemanlari[p.r][p.c].classList.remove('ks-secili'));
  ks65Yol = [];
}
function ks65Tikla(r,c){
  const hucreEl = ks65HucreElemanlari[r][c];
  if(hucreEl.classList.contains('ks-bulundu')) return;
  let yeniYol;
  if(ks65Yol.length===0){ yeniYol = [{r,c}]; }
  else {
    const son = ks65Yol[ks65Yol.length-1];
    const gecerliHamle = ks65AtHamleleri.some(([hr,hc]) => son.r+hr===r && son.c+hc===c);
    yeniYol = gecerliHamle ? [...ks65Yol, {r,c}] : [{r,c}];
  }
  const dizi = yeniYol.map(p=>ks65IzgaraVeri[p.r][p.c]).join('');
  const tamEslesen = ks65KelimeListesi.find(item => item.kelime===dizi && !ks65BulunanKelimeler.has(item.kelime));
  const onEkMi = ks65KelimeListesi.some(item => !ks65BulunanKelimeler.has(item.kelime) && item.kelime.startsWith(dizi));
  ks65Yol.forEach(p=>ks65HucreElemanlari[p.r][p.c].classList.remove('ks-secili'));
  if(tamEslesen){
    yeniYol.forEach(p=>ks65HucreElemanlari[p.r][p.c].classList.add('ks-bulundu'));
    ks65BulunanKelimeler.add(tamEslesen.kelime);
    document.getElementById('ks65Bulunan').textContent = ks65BulunanKelimeler.size;
    document.getElementById('ks65-kelime-'+tamEslesen.kelime).classList.add('bulundu-satir');
    ks65Yol = [];
    if(ks65BulunanKelimeler.size === ks65KelimeListesi.length){
      document.getElementById('ks65Sonuc').textContent = '🎉 Tebrikler! Tüm kelimeleri at hamlesiyle buldun!';
    }
  } else if(onEkMi){
    yeniYol.forEach(p=>ks65HucreElemanlari[p.r][p.c].classList.add('ks-secili'));
    ks65Yol = yeniYol;
  } else {
    const tekBaslangicUygun = ks65KelimeListesi.some(item => !ks65BulunanKelimeler.has(item.kelime) && item.kelime[0]===ks65IzgaraVeri[r][c]);
    if(tekBaslangicUygun){ ks65Yol = [{r,c}]; hucreEl.classList.add('ks-secili'); }
    else { ks65Yol = []; }
  }
}

// =====================================================================
// KELİME DEDEKTİFİ
// =====================================================================
const dd65KelimeHavuzu = kelimeHavuzu65.filter(x => x.kelime.length>=5 && x.kelime.length<=8);
let dd65Hedef = null, dd65Deneme = 0;
const dd65MaxDeneme = 5, dd65IpucuAcilmaSiniri = 2;
let dd65Bitti = true, dd65SiraliVakalar = [], dd65VakaIndex = 0, dd65CozulenSayisi = 0;

function dd65Baslat(){
  dd65SiraliVakalar = karistir(dd65KelimeHavuzu.slice());
  dd65VakaIndex = 0; dd65CozulenSayisi = 0;
  document.getElementById('dd65Cozulen').textContent = 0;
  document.getElementById('dd65ToplamVaka').textContent = dd65SiraliVakalar.length;
  document.getElementById('dd65MaxDeneme').textContent = dd65MaxDeneme;
  dd65VakaBaslat();
}
function dd65VakaBaslat(){
  if(dd65VakaIndex >= dd65SiraliVakalar.length){
    document.getElementById('dd65Ipucu').textContent = '';
    document.getElementById('dd65Izgara').innerHTML = '';
    document.getElementById('dd65Girdi').disabled = true;
    document.getElementById('dd65Sonuc').textContent = `🏆 Tüm vakalar bitti! ${dd65CozulenSayisi}/${dd65SiraliVakalar.length} vakayı çözdün!`;
    return;
  }
  document.getElementById('dd65Vaka').textContent = dd65VakaIndex+1;
  dd65Hedef = dd65SiraliVakalar[dd65VakaIndex];
  dd65Deneme = 0; dd65Bitti = false;
  document.getElementById('dd65Ipucu').innerHTML = `🔍 Vaka: <b>${dd65Hedef.kelime.length} harfli</b> bir kavram (anlamı ${dd65IpucuAcilmaSiniri} yanlış tahminden sonra açılacak!)`;
  document.getElementById('dd65Deneme').textContent = 0;
  document.getElementById('dd65Izgara').innerHTML = '';
  document.getElementById('dd65Sonuc').textContent = '';
  document.getElementById('dd65Uyari').textContent = '';
  const girdi = document.getElementById('dd65Girdi');
  girdi.value = ''; girdi.disabled = false; girdi.maxLength = dd65Hedef.kelime.length; girdi.focus();
}
function dd65TahminEt(){
  if(dd65Bitti) return;
  const girdi = document.getElementById('dd65Girdi');
  const tahmin = girdi.value.trim().toLocaleUpperCase('tr-TR');
  if(tahmin.length !== dd65Hedef.kelime.length){
    document.getElementById('dd65Uyari').textContent = `Tahminin ${dd65Hedef.kelime.length} harfli olmalı!`;
    return;
  }
  document.getElementById('dd65Uyari').textContent = '';
  const hedefHarfler = dd65Hedef.kelime.split('');
  const tahminHarfler = tahmin.split('');
  const durumlar = new Array(tahminHarfler.length).fill('yok');
  const kullanilan = new Array(hedefHarfler.length).fill(false);
  tahminHarfler.forEach((h,i)=>{ if(h === hedefHarfler[i]){ durumlar[i]='dogru-yer'; kullanilan[i]=true; } });
  tahminHarfler.forEach((h,i)=>{
    if(durumlar[i]==='dogru-yer') return;
    const idx = hedefHarfler.findIndex((hh,j)=> hh===h && !kullanilan[j]);
    if(idx!==-1){ durumlar[i]='yanlis-yer'; kullanilan[idx]=true; }
  });
  const satir = document.createElement('div');
  satir.className = 'dd-satir';
  tahminHarfler.forEach((h,i)=>{
    const kutu = document.createElement('div');
    kutu.className = 'dd-kutu ' + durumlar[i];
    kutu.textContent = h;
    satir.appendChild(kutu);
  });
  document.getElementById('dd65Izgara').appendChild(satir);
  dd65Deneme++;
  document.getElementById('dd65Deneme').textContent = dd65Deneme;
  girdi.value = '';
  if(tahmin === dd65Hedef.kelime){
    dd65Bitti = true; girdi.disabled = true;
    dd65CozulenSayisi++;
    document.getElementById('dd65Cozulen').textContent = dd65CozulenSayisi;
    document.getElementById('dd65Ipucu').innerHTML = `🔍 İpucu: <b>${dd65Hedef.anlam}</b> (${dd65Hedef.kelime.length} harfli)`;
    document.getElementById('dd65Sonuc').textContent = `🎉 Vaka çözüldü! Kelime: ${dd65Hedef.kelime} (${dd65Deneme} denemede)`;
    dd65VakaIndex++;
    setTimeout(()=>dd65VakaBaslat(), 1500);
  } else if(dd65Deneme >= dd65MaxDeneme){
    dd65Bitti = true; girdi.disabled = true;
    document.getElementById('dd65Ipucu').innerHTML = `🔍 İpucu: <b>${dd65Hedef.anlam}</b> (${dd65Hedef.kelime.length} harfli)`;
    document.getElementById('dd65Sonuc').textContent = `🔍 Vaka çözülemedi! Doğru kelime: ${dd65Hedef.kelime} — ${dd65Hedef.anlam}`;
    dd65VakaIndex++;
    setTimeout(()=>dd65VakaBaslat(), 2200);
  } else if(dd65Deneme >= dd65IpucuAcilmaSiniri){
    document.getElementById('dd65Ipucu').innerHTML = `🔍 İpucu açıldı: <b>${dd65Hedef.anlam}</b> (${dd65Hedef.kelime.length} harfli)`;
  }
}

// =====================================================================
// DİL DEDEKTİFİ
// =====================================================================
const dilDedektifi65Listesi = [
  {dogru:"Örf ve âdetler, toplumun uzun sürede oluşturup benimsediği yazılı olmayan kurallardır.", yanlislar:["Örf ve âdetler, devletin çıkardığı yazılı kanunlardır.","Örf ve âdetlerin toplumsal bir işlevi yoktur.","Örf ve âdetler her bireyin kendi belirlediği kurallardır."]},
  {dogru:"Kültürümüzde Mevlit, Regaip, Miraç ve Berat olmak üzere dört kandil gecesi vardır.", yanlislar:["Kültürümüzde sadece iki kandil gecesi vardır.","Kültürümüzde altı kandil gecesi vardır.","Kandil geceleri sadece ramazanda kutlanır."]},
  {dogru:"Kandil geceleri, Osmanlı padişahlarından II. Selim zamanında adlandırılmıştır.", yanlislar:["Kandil geceleri Fatih Sultan Mehmet zamanında adlandırılmıştır.","Kandil gecelerinin adlandırılma tarihi bilinmemektedir.","Kandil geceleri Cumhuriyet döneminde adlandırılmıştır."]},
  {dogru:"Sadaka taşı, ihtiyaç sahiplerinin alabilmesi için yardımların bırakıldığı özel bir yerdir.", yanlislar:["Sadaka taşı sadece süs amaçlı bir yapıdır.","Sadaka taşından sadece zenginler yararlanabilir.","Sadaka taşı geleneği günümüzde tamamen unutulmuştur."]},
  {dogru:"Zimem, Arapçada 'borçlar' anlamına gelir.", yanlislar:["Zimem, Arapçada 'hediyeler' anlamına gelir.","Zimem, Türkçe kökenli bir kelimedir.","Zimem'in bir anlamı yoktur."]},
  {dogru:"Muharrem ayının onuncu gününe 'aşure günü' denir.", yanlislar:["Muharrem ayının birinci gününe 'aşure günü' denir.","Aşure günü ramazan ayında kutlanır.","Aşure günü bir kandil gecesidir."]},
  {dogru:"Ezanı ilk kez Bilal Habeşi okumuştur.", yanlislar:["Ezanı ilk kez Hz. Ömer okumuştur.","Ezanı ilk kez Hz. Ebu Bekir okumuştur.","Ezanı kimin okuduğu bilinmemektedir."]},
  {dogru:"Tekbir, Buhurizade Mustafa Itri Efendi tarafından bestelenmiştir.", yanlislar:["Tekbiri Süleyman Çelebi bestelemiştir.","Tekbirin bir bestekârı yoktur.","Tekbir Yunus Emre tarafından yazılmıştır."]},
  {dogru:"Mevlid-i Şerif'in en meşhuru Süleyman Çelebi'nin yazdığı 'Vesiletü'n-Necat'tır.", yanlislar:["En meşhur mevlit eserini Hacı Bektaş Veli yazmıştır.","Mevlid-i Şerif'in yazarı bilinmemektedir.","'Vesiletü'n-Necat' bir naat eseridir."]},
  {dogru:"Ehlibeyt kavramı Kur'an-ı Kerim'de Ahzab suresinde geçmektedir.", yanlislar:["Ehlibeyt kavramı Kur'an'da hiç geçmez.","Ehlibeyt kavramı Bakara suresinde geçer.","Ehlibeyt sadece hadislerde geçen bir kavramdır."]},
];
let ddl65Index = 0, ddl65Puan = 0, ddl65Sira = [];

function ddl65Baslat(){
  ddl65Sira = karistir(dilDedektifi65Listesi.slice());
  ddl65Index = 0; ddl65Puan = 0;
  document.getElementById('ddl65Puan').textContent = 0;
  document.getElementById('ddl65Toplam').textContent = ddl65Sira.length;
  document.getElementById('ddl65Sonuc').textContent = '';
  ddl65Tur();
}
function ddl65Tur(){
  if(ddl65Index >= ddl65Sira.length){
    document.getElementById('ddl65Secenekler').innerHTML = '';
    document.getElementById('ddl65Baslik').textContent = '';
    document.getElementById('ddl65Sonuc').textContent = `🕵️ Soruşturma bitti! ${ddl65Puan}/${ddl65Sira.length} doğru bilgiyi tespit ettin!`;
    return;
  }
  document.getElementById('ddl65Tur').textContent = ddl65Index+1;
  const oge = ddl65Sira[ddl65Index];
  document.getElementById('ddl65Baslik').textContent = '🔎 Hangi cümle DOĞRU bilgi veriyor?';
  const secenekler = karistir([{metin:oge.dogru, dogruMu:true}, ...oge.yanlislar.map(y=>({metin:y, dogruMu:false}))]);
  const kutu = document.getElementById('ddl65Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = secenek.metin;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      tiklandiMi = true;
      const tumBtn = kutu.querySelectorAll('.merdiven-secenek');
      if(secenek.dogruMu){
        btn.classList.add('dogru');
        ddl65Puan++;
        document.getElementById('ddl65Puan').textContent = ddl65Puan;
      } else {
        btn.classList.add('yanlis');
        tumBtn.forEach(b=>{ if(b.textContent === oge.dogru) b.classList.add('dogru'); });
      }
      ddl65Index++;
      setTimeout(()=>ddl65Tur(), 1200);
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// MANTIK ZİNCİRİ
// =====================================================================
const mantikZinciri65 = [
  {kavram:"KANDİL", tanim:"Mevlit, Regaip, Miraç, Berat olmak üzere dört önemli gecenin genel adı", mantik:"Kandil gecelerinde okunan, Hz. Peygamber'in doğumunu anlatan esere ne denir?"},
  {kavram:"MEVLİT", tanim:"Hz. Peygamber'in doğumunu ve hayatından kesitleri anlatan eser/program", mantik:"Mevlit programlarında okunan, Hz. Peygamber'e selam ve dua eden sözlere ne denir?"},
  {kavram:"SALAVAT", tanim:"Hz. Peygamber'e selam ve dua etmek anlamına gelen sözler", mantik:"Camilerde Itri'nin bestesiyle hep bir ağızdan okunan, Allah'ın büyüklüğünü anan söze ne denir?"},
  {kavram:"TEKBİR", tanim:"Allah'ın büyüklüğünü anma sözü, İtri'nin bestelediği eser", mantik:"Allah'ı övmek ve O'na dua etmek amacıyla yazılıp bestelenen dinî şiirlere ne denir?"},
  {kavram:"İLAHİ", tanim:"Allah'ı övme ve O'na dua etme amacıyla yazılıp bestelenen dinî şiirler", mantik:""},
];
let mz65Index = 0;

function mz65Baslat(){
  mz65Index = 0;
  document.getElementById('mz65Toplam').textContent = mantikZinciri65.length;
  document.getElementById('mz65Sonuc').textContent = '';
  document.getElementById('mz65Gorsel').innerHTML = '';
  mz65HalkaEkle(mantikZinciri65[0].kavram, 0);
  mz65Tur();
}
function mz65HalkaEkle(kavram, index){
  const halka = document.createElement('div');
  halka.style.background='white'; halka.style.border='2px solid var(--yesil)'; halka.style.borderRadius='10px';
  halka.style.padding='8px 14px'; halka.style.margin='6px 0'; halka.style.fontWeight='bold';
  halka.style.marginLeft = (index*24) + 'px';
  halka.textContent = `${index+1}. ${kavram}`;
  document.getElementById('mz65Gorsel').appendChild(halka);
}
function mz65Tur(){
  document.getElementById('mz65Halka').textContent = mz65Index+1;
  if(mz65Index+1 >= mantikZinciri65.length){
    document.getElementById('mz65Soru').textContent = '';
    document.getElementById('mz65Secenekler').innerHTML = '';
    document.getElementById('mz65Sonuc').textContent = '🎉 Tebrikler! Mantık zincirini tamamen çözdün!';
    return;
  }
  const mevcut = mantikZinciri65[mz65Index];
  const hedef = mantikZinciri65[mz65Index+1];
  document.getElementById('mz65Soru').innerHTML = `🔗 <b>${mevcut.kavram}</b>: ${mevcut.tanim}<br>❓ ${mevcut.mantik}`;
  const havuzDistractor = karistir(kelimeHavuzu65.filter(x => x.kelime!==hedef.kavram && !mantikZinciri65.some(z=>z.kavram===x.kelime))).slice(0,3);
  const secenekler = karistir([{kelime:hedef.kavram}, ...havuzDistractor]);
  const kutu = document.getElementById('mz65Secenekler');
  kutu.innerHTML = '';
  let tiklandiMi = false;
  secenekler.forEach(secenek=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = secenek.kelime;
    btn.onclick = ()=>{
      if(tiklandiMi) return;
      if(secenek.kelime === hedef.kavram){
        tiklandiMi = true;
        btn.classList.add('dogru');
        mz65Index++;
        setTimeout(()=>{ mz65HalkaEkle(hedef.kavram, mz65Index); mz65Tur(); }, 700);
      } else {
        btn.classList.add('yanlis');
        setTimeout(()=>btn.classList.remove('yanlis'), 400);
      }
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// SEMANTİK LABİRENT
// =====================================================================
const semantikOdalar65 = [
  {kategori:"YAYGIN GELENEKLERİMİZ (Mevlit, Taziye, Kandil gibi)", kelimeler:["MEVLİT","TAZİYE","KANDİL","EZAN"], oddKelime:"EZAN"},
  {kategori:"YARDIMLAŞMA GELENEKLERİMİZ (Sadaka, Zimem, Vakıf gibi)", kelimeler:["SADAKA","ZİMEM","VAKIF","AŞURE"], oddKelime:"AŞURE"},
  {kategori:"RAMAZAN VE MUHARREM GELENEKLERİ (Mahya, Aşure, Muharrem gibi)", kelimeler:["MAHYA","AŞURE","MUHARREM","EHLİBEYT"], oddKelime:"EHLİBEYT"},
  {kategori:"EDEBİ TÜRLER (Tevhit, Münacat, Naat gibi)", kelimeler:["TEVHİT","MÜNACAT","NAAT","MUSİKİ"], oddKelime:"MUSİKİ"},
  {kategori:"MUSİKİ KAVRAMLARI (Ezan, Kamet, Salavat gibi)", kelimeler:["EZAN","KAMET","SALAVAT","VAKFİYE"], oddKelime:"VAKFİYE"},
  {kategori:"HZ. PEYGAMBER SEVGİSİ KAVRAMLARI (Ehlibeyt, Naat, Salavat gibi)", kelimeler:["EHLİBEYT","NAAT","SALAVAT","DİŞKİRASI"], oddKelime:"DİŞKİRASI"},
];
let sz65OdaIndex = 0, sz65Can = 3;

function sz65CanGoster(){ document.getElementById('sz65Can').textContent = '❤️'.repeat(Math.max(sz65Can,0)) + '🖤'.repeat(Math.max(3-sz65Can,0)); }
function sz65Baslat(){
  sz65OdaIndex = 0; sz65Can = 3;
  document.getElementById('sz65ToplamOda').textContent = semantikOdalar65.length;
  sz65CanGoster();
  document.getElementById('sz65Sonuc').textContent = '';
  sz65OdaGoster();
}
function sz65OdaGoster(){
  document.getElementById('sz65Oda').textContent = sz65OdaIndex+1;
  const oda = semantikOdalar65[sz65OdaIndex];
  document.getElementById('sz65Kategori').innerHTML = `🚪 Oda ${sz65OdaIndex+1}: Bu kategoriye AİT OLMAYAN kelimeyi bul, kapıyı aç!<br>📂 Kategori: <b>${oda.kategori}</b>`;
  const kutu = document.getElementById('sz65Secenekler');
  kutu.innerHTML = '';
  const karisikKelimeler = karistir(oda.kelimeler.slice());
  karisikKelimeler.forEach(kelime=>{
    const btn = document.createElement('div');
    btn.className = 'merdiven-secenek';
    btn.textContent = kelime;
    btn.onclick = ()=>{
      if(kelime === oda.oddKelime){
        btn.classList.add('dogru');
        sz65OdaIndex++;
        setTimeout(()=>{
          if(sz65OdaIndex >= semantikOdalar65.length){
            document.getElementById('sz65Kategori').textContent = '';
            document.getElementById('sz65Secenekler').innerHTML = '';
            document.getElementById('sz65Sonuc').textContent = '🎉 Tebrikler! Semantik labirentten çıktın!';
          } else { sz65OdaGoster(); }
        }, 700);
      } else {
        btn.classList.add('yanlis');
        sz65Can--;
        sz65CanGoster();
        if(sz65Can<=0){
          setTimeout(()=>{
            sz65OdaIndex = 0; sz65Can = 3;
            sz65CanGoster();
            document.getElementById('sz65Sonuc').textContent = '💥 Canların bitti, labirentte kayboldun! Baştan başlıyorsun...';
            setTimeout(()=>{ document.getElementById('sz65Sonuc').textContent=''; sz65OdaGoster(); }, 1500);
          }, 500);
        } else {
          setTimeout(()=>btn.classList.remove('yanlis'), 400);
        }
      }
    };
    kutu.appendChild(btn);
  });
}

// =====================================================================
// ÇELİŞKİ AVI
// =====================================================================
const celiskiListesi65 = [
  {kelime:"Ezan", anlam1:"namaz vakitlerinin geldiğini duyurmak için okunan çağrı", anlam2:"farz namazlardan önce okunan namaza başlama ifadesi", celiskiVarMi:true},
  {kelime:"Mevlit", anlam1:"Hz. Peygamber'in doğumunu ve hayatını anlatan eser", anlam2:"Yüce Allah'ın varlığını ve birliğini anlatan eser türü", celiskiVarMi:true},
  {kelime:"Salavat", anlam1:"Hz. Peygamber'e selam ve dua etmek anlamına gelen sözler", anlam2:"Allah'ı övme ve O'na dua etmek amacıyla yazılan şiirler", celiskiVarMi:true},
  {kelime:"Vakıf", anlam1:"bir malı satmayı yasaklayarak toplum kullanımına özgülemek", anlam2:"veresiye alışverişte borçların yazıldığı defter", celiskiVarMi:true},
  {kelime:"Naat", anlam1:"Hz. Peygamber'i öven şiir türü", anlam2:"Allah'a dua etmek amacıyla yazılan şiir türü", celiskiVarMi:true},
  {kelime:"Aşure", anlam1:"muharrem ayının onuncu günü yapılıp dağıtılan tatlı", anlam2:"iki minare arasına asılan ışıklı yazı", celiskiVarMi:true},
  {kelime:"Kültür", anlam1:"bir toplumun maddi ve manevi değerlerinin bütünü", anlam2:"toplumu başka toplumlardan ayıran özellikler", celiskiVarMi:false},
  {kelime:"Taziye", anlam1:"yakını vefat eden birine başsağlığı dileğinde bulunma", anlam2:"acılara karşı sabırlı olmayı tavsiye etme", celiskiVarMi:false},
  {kelime:"Kandil", anlam1:"Mevlit, Regaip, Miraç, Berat gecelerinin genel adı", anlam2:"minarelerde kandil yakılarak kutlanan gece", celiskiVarMi:false},
  {kelime:"Ehlibeyt", anlam1:"Hz. Muhammed'in aile fertleri için kullanılan kavram", anlam2:"ev halkı anlamına gelen kavram", celiskiVarMi:false},
  {kelime:"Edebiyat", anlam1:"olay, duygu ve düşüncelerin sözlü ya da yazılı olarak ifade edilmesi", anlam2:"duygu ve düşünceleri anlatan sanat dalı", celiskiVarMi:false},
  {kelime:"Musiki", anlam1:"kulağa hoş gelen sesler dizisi", anlam2:"günümüzdeki ismiyle müzik", celiskiVarMi:false},
];
let ca65Index = 0, ca65Puan = 0, ca65Sira = [], ca65Kilit = false;

function ca65Baslat(){
  ca65Sira = karistir(celiskiListesi65.slice());
  ca65Index = 0; ca65Puan = 0;
  document.getElementById('ca65Puan').textContent = 0;
  document.getElementById('ca65Toplam').textContent = ca65Sira.length;
  document.getElementById('ca65Sonuc').textContent = '';
  document.getElementById('ca65Butonlar').style.display = 'flex';
  ca65Tur();
}
function ca65Tur(){
  if(ca65Index >= ca65Sira.length){
    document.getElementById('ca65Cumle').textContent = '';
    document.getElementById('ca65Butonlar').style.display = 'none';
    document.getElementById('ca65GeriBildirim').textContent = '';
    document.getElementById('ca65Sonuc').textContent = `🕵️ Avın bitti! ${ca65Puan}/${ca65Sira.length} çelişkiyi doğru tespit ettin!`;
    return;
  }
  document.getElementById('ca65Tur').textContent = ca65Index+1;
  const oge = ca65Sira[ca65Index];
  document.getElementById('ca65Cumle').innerHTML = `"<b>${oge.kelime}</b>" hem "${oge.anlam1}" hem de "${oge.anlam2}" demektir.`;
  document.getElementById('ca65GeriBildirim').textContent = '';
  ca65Kilit = false;
}
function ca65Cevapla(cevapVarMi){
  if(ca65Kilit) return;
  ca65Kilit = true;
  const oge = ca65Sira[ca65Index];
  const dogruMu = (cevapVarMi === oge.celiskiVarMi);
  if(dogruMu){
    ca65Puan++;
    document.getElementById('ca65Puan').textContent = ca65Puan;
    document.getElementById('ca65GeriBildirim').textContent = '✅ Doğru!';
  } else {
    document.getElementById('ca65GeriBildirim').textContent = `❌ Yanlış! Doğrusu: ${oge.celiskiVarMi ? 'Çelişki VAR' : 'Çelişki YOK'}`;
  }
  ca65Index++;
  setTimeout(()=>ca65Tur(), 1300);
}

// =====================================================================
// LABİRENT
// =====================================================================
const lab65Satir = 12, lab65Sutun = 15;
const lab65IfadeHavuzu = [
  {kelime:"Kültür", anlam:"Bir toplumun maddi ve manevi değerlerinin bütünü"},
  {kelime:"Mevlit", anlam:"Hz. Peygamber'in doğumunu ve hayatından kesitleri anlatan eser"},
  {kelime:"Taziye", anlam:"Yakını vefat eden birine başsağlığı dileğinde bulunma"},
  {kelime:"Kandil", anlam:"Mevlit, Regaip, Miraç, Berat gecelerinin genel adı"},
  {kelime:"Mahya", anlam:"Ramazan ayında iki minare arasına asılan ışıklı yazılar"},
  {kelime:"Sadaka", anlam:"İhtiyaç sahiplerinin alması için cami avlusuna bırakılan yardım"},
  {kelime:"Zimem", anlam:"Veresiye alışverişte borçların yazıldığı defter"},
  {kelime:"Vakıf", anlam:"Bir maldan yararlanma hakkını Allah rızası için topluma özgüleme"},
  {kelime:"Aşure", anlam:"Muharrem ayının onuncu gününde yapılıp dağıtılan tatlı"},
  {kelime:"Ehlibeyt", anlam:"Hz. Muhammed'in aile fertleri için kullanılan kavram"},
  {kelime:"Salavat", anlam:"Hz. Peygamber'e selam ve dua etmek"},
  {kelime:"Ezan", anlam:"Namaz vakitlerinin geldiğini duyurmak için okunan çağrı"},
  {kelime:"Kamet", anlam:"Farz namazlardan önce ezana namaz başlama ifadesinin eklenmesi"},
  {kelime:"İlahi", anlam:"Allah'ı övme ve O'na dua etme amacıyla bestelenen şiirler"},
  {kelime:"Tevhit", anlam:"Yüce Allah'ın varlığını ve birliğini anlatan edebî eser türü"},
  {kelime:"Münacat", anlam:"Allah'a dua etmek amacıyla yazılan şiir türü"},
  {kelime:"Naat", anlam:"Hz. Peygamber'i öven şiir türü"},
  {kelime:"Tekbir", anlam:"Allah'ın büyüklüğünü anma sözü"},
  {kelime:"Edebiyat", anlam:"Olay, duygu ve düşüncelerin ifade edilmesi"},
  {kelime:"Musiki", anlam:"Kulağa hoş gelen sesler dizisi"},
];
let lab65Hucreler = [], lab65HucreElemanlari = [], lab65OyuncuKonum = {r:0,c:0}, lab65Toplananlar = {};
let lab65HamleSayisi = 0, lab65ToplananSayisi = 0, lab65Saniye = 0, lab65Zamanlayici = null, lab65Bitti = false;

function lab65Uret(){
  const hucreler = [];
  for(let r=0;r<lab65Satir;r++){
    hucreler.push([]);
    for(let c=0;c<lab65Sutun;c++){ hucreler[r].push({top:true,right:true,bottom:true,left:true,ziyaretEdildi:false}); }
  }
  const yigin = [{r:0,c:0}];
  hucreler[0][0].ziyaretEdildi = true;
  while(yigin.length>0){
    const mevcut = yigin[yigin.length-1];
    const {r,c} = mevcut;
    const komsular = [];
    if(r>0 && !hucreler[r-1][c].ziyaretEdildi) komsular.push({r:r-1,c,yon:'top'});
    if(c<lab65Sutun-1 && !hucreler[r][c+1].ziyaretEdildi) komsular.push({r,c:c+1,yon:'right'});
    if(r<lab65Satir-1 && !hucreler[r+1][c].ziyaretEdildi) komsular.push({r:r+1,c,yon:'bottom'});
    if(c>0 && !hucreler[r][c-1].ziyaretEdildi) komsular.push({r,c:c-1,yon:'left'});
    if(komsular.length===0){ yigin.pop(); }
    else {
      const secilen = komsular[Math.floor(Math.random()*komsular.length)];
      if(secilen.yon==='top'){ hucreler[r][c].top=false; hucreler[secilen.r][secilen.c].bottom=false; }
      if(secilen.yon==='right'){ hucreler[r][c].right=false; hucreler[secilen.r][secilen.c].left=false; }
      if(secilen.yon==='bottom'){ hucreler[r][c].bottom=false; hucreler[secilen.r][secilen.c].top=false; }
      if(secilen.yon==='left'){ hucreler[r][c].left=false; hucreler[secilen.r][secilen.c].right=false; }
      hucreler[secilen.r][secilen.c].ziyaretEdildi = true;
      yigin.push({r:secilen.r,c:secilen.c});
    }
  }
  return hucreler;
}
function labirent65Baslat(){
  clearInterval(lab65Zamanlayici);
  lab65Hucreler = lab65Uret();
  lab65OyuncuKonum = {r:0,c:0};
  lab65HamleSayisi = 0; lab65ToplananSayisi = 0; lab65Saniye = 0; lab65Bitti = false;
  document.getElementById('lab65Hamle').textContent = 0;
  document.getElementById('lab65Toplanan').textContent = 0;
  document.getElementById('lab65Sure').textContent = 0;
  document.getElementById('lab65Durum').textContent = '';
  document.getElementById('lab65Sonuc').textContent = '';
  const tumHucreler = [];
  for(let r=0;r<lab65Satir;r++) for(let c=0;c<lab65Sutun;c++){
    if(!(r===0&&c===0) && !(r===lab65Satir-1&&c===lab65Sutun-1)) tumHucreler.push({r,c});
  }
  const secilenler = karistir(tumHucreler).slice(0, lab65IfadeHavuzu.length);
  lab65Toplananlar = {};
  secilenler.forEach((konum, i)=>{
    lab65Toplananlar[konum.r+','+konum.c] = {kelime: lab65IfadeHavuzu[i].kelime, anlam: lab65IfadeHavuzu[i].anlam, toplandi:false};
  });
  document.getElementById('lab65ToplamYildiz').textContent = secilenler.length;
  const izgara = document.getElementById('lab65Izgara');
  izgara.innerHTML = '';
  izgara.style.gridTemplateColumns = `repeat(${lab65Sutun}, 30px)`;
  izgara.style.gridTemplateRows = `repeat(${lab65Satir}, 30px)`;
  lab65HucreElemanlari = [];
  for(let r=0;r<lab65Satir;r++){
    lab65HucreElemanlari.push([]);
    for(let c=0;c<lab65Sutun;c++){
      const h = lab65Hucreler[r][c];
      const div = document.createElement('div');
      div.className = 'labirent-hucre';
      div.style.gridColumn = c+1;
      div.style.gridRow = r+1;
      div.style.borderTop = h.top ? '2px solid #333' : '2px solid transparent';
      div.style.borderRight = h.right ? '2px solid #333' : '2px solid transparent';
      div.style.borderBottom = h.bottom ? '2px solid #333' : '2px solid transparent';
      div.style.borderLeft = h.left ? '2px solid #333' : '2px solid transparent';
      const key = r+','+c;
      if(r===0 && c===0) div.textContent = '🚶';
      else if(r===lab65Satir-1 && c===lab65Sutun-1) div.textContent = '🎼';
      else if(lab65Toplananlar[key]) div.textContent = '⭐';
      izgara.appendChild(div);
      lab65HucreElemanlari[r].push(div);
    }
  }
  lab65Zamanlayici = setInterval(()=>{
    lab65Saniye++;
    document.getElementById('lab65Sure').textContent = lab65Saniye;
  }, 1000);
}
function labirent65Hareket(dr, dc){
  if(lab65Bitti) return;
  const {r,c} = lab65OyuncuKonum;
  const hucre = lab65Hucreler[r][c];
  let yeniR=r, yeniC=c;
  if(dr===-1 && !hucre.top) yeniR = r-1;
  else if(dr===1 && !hucre.bottom) yeniR = r+1;
  else if(dc===-1 && !hucre.left) yeniC = c-1;
  else if(dc===1 && !hucre.right) yeniC = c+1;
  else return;
  lab65HucreElemanlari[r][c].textContent = '';
  lab65OyuncuKonum = {r:yeniR, c:yeniC};
  lab65HamleSayisi++;
  document.getElementById('lab65Hamle').textContent = lab65HamleSayisi;
  const key = yeniR+','+yeniC;
  if(lab65Toplananlar[key] && !lab65Toplananlar[key].toplandi){
    lab65Toplananlar[key].toplandi = true;
    lab65ToplananSayisi++;
    document.getElementById('lab65Toplanan').textContent = lab65ToplananSayisi;
    document.getElementById('lab65Durum').textContent = `✨ Topladın: ${lab65Toplananlar[key].kelime} — ${lab65Toplananlar[key].anlam}`;
  }
  if(yeniR===lab65Satir-1 && yeniC===lab65Sutun-1){
    lab65HucreElemanlari[yeniR][yeniC].textContent = '🏁';
    lab65Bitti = true;
    clearInterval(lab65Zamanlayici);
    const toplamYildiz = document.getElementById('lab65ToplamYildiz').textContent;
    document.getElementById('lab65Sonuc').textContent =
      `🎉 Tebrikler! Labirenti ${lab65HamleSayisi} hamlede ve ${lab65Saniye} saniyede tamamladın! (${lab65ToplananSayisi}/${toplamYildiz} yıldız topladın)`;
    return;
  }
  lab65HucreElemanlari[yeniR][yeniC].textContent = '🚶';
}
document.addEventListener('keydown', (e)=>{
  const aktifBolum = document.getElementById('labirent65');
  if(!aktifBolum.classList.contains('aktif')) return;
  const etiket = document.activeElement ? document.activeElement.tagName : '';
  if(etiket==='INPUT' || etiket==='TEXTAREA') return;
  if(e.key==='ArrowUp'){ e.preventDefault(); labirent65Hareket(-1,0); }
  else if(e.key==='ArrowDown'){ e.preventDefault(); labirent65Hareket(1,0); }
  else if(e.key==='ArrowLeft'){ e.preventDefault(); labirent65Hareket(0,-1); }
  else if(e.key==='ArrowRight'){ e.preventDefault(); labirent65Hareket(0,1); }
});

