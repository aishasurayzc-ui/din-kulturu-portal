    <button class="omg-yan-oge" onclick="kategoriGoster('kat-macera65', event)"><span class="gb-kart-ikon" aria-hidden="true">🌀</span><span class="gb-kart-metin"><b>Macera</b><small>Labirent ve keşif oyunu</small></span></button>
    <button class="omg-yan-oge" onclick="kategoriGoster('kat-ezber65', event)"><span class="gb-kart-ikon" aria-hidden="true">🕌</span><span class="gb-kart-metin"><b>Ezber Etkinlikleri</b><small>Sırala, eşleştir ve ezberle</small></span></button>
  </div>
  <div class="omg-kart-alan">
    <div class="omg-kart-izgara">
        <div class="omg-oyun-kart" onclick="goster('kelimeavi65', event); var _t=document.getElementById('kelimeavi65'); if(_t) _t.scrollIntoView({behavior:'smooth', block:'start'});">
          <div class="omg-oyun-kart-ikon">🔎</div>
