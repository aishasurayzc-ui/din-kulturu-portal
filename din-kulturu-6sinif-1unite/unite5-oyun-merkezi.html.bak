<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>6. Sınıf Din Kültürü - 5. Ünite: Kültürümüzdeki Dinî Motifler — Oyun Merkezi</title>
<meta name="description" content="6. Sınıf Din Kültürü - 5. Ünite: Kültürümüzdeki Dinî Motifler — İnteraktif oyunlar, konu özeti, test ve sunum içeren dijital ders materyali.">
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    /* ---- Giriş Bölümü tasarım sistemi (yalnızca .gb-* bileşenlerinde kullanılır;
       oyun/etkinlik içeriğindeki mevcut --navy/--mavi/--yesil vb. değişmedi) ---- */
    --gb-font:'Plus Jakarta Sans','Nunito','Segoe UI',sans-serif;
    --gb-primary:#2563EB; --gb-primary-koyu:#1d4ed8; --gb-secondary:#14B8A6;
    --gb-bg:#F8FAFC; --gb-text:#0F172A; --gb-text-mute:#64748b; --gb-border:#E2E8F0;
    --gb-radius-card:20px; --gb-radius-btn:16px;
    --gb-shadow:0 4px 16px rgba(15,23,42,.06);
    --gb-shadow-hover:0 16px 32px -8px rgba(37,99,235,.22), 0 4px 10px rgba(15,23,42,.06);
  }
  :root[data-theme="dark"]{
    --gb-bg:#0f1620; --gb-text:#e7ecf1; --gb-text-mute:#9aa7b4; --gb-border:#26303c;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){ --gb-bg:#0f1620; --gb-text:#e7ecf1; --gb-text-mute:#9aa7b4; --gb-border:#26303c; }
  }
  :root{
    /* ---- Tasarım Token Sistemi (ek; --mavi/--acik/--yesil vb. korunuyor) ---- */
    --sp-1:4px; --sp-2:8px; --sp-3:12px; --sp-4:16px; --sp-5:24px; --sp-6:32px;
    --radius-sm:10px; --radius-md:14px; --radius-lg:20px;
    --shadow-sm:0 2px 6px rgba(0,0,0,.08);
    --shadow-md:0 4px 14px rgba(0,0,0,.10);
    --shadow-lg:0 10px 28px rgba(0,0,0,.16);

    /* Semantik renk katmanı (mevcut ham renklerin üzerine, onları değiştirmeden) */
    --color-selected: var(--mavi);
    --color-success: var(--yesil);
    --color-warning: var(--sari);
    --color-progress: var(--turkuaz);
    --color-surface:#ffffff;
    --color-surface-alt: var(--acikgri);
    --color-text:#22333b;
    --color-text-muted:#667;
    --color-border:#e2e8f0;
  }

  /* Koyu tema: sistem tercihine göre varsayılan, data-theme ile açıkça ezilebilir */
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#121a21; --acikgri:#1b2530;
      --color-surface:#1b2530; --color-surface-alt:#222e3a;
      --color-text:#e7ecf1; --color-text-muted:#9aa7b4; --color-border:#2c3947;
    }
  }
  :root[data-theme="dark"]{
    --bg:#121a21; --acikgri:#1b2530;
    --color-surface:#1b2530; --color-surface-alt:#222e3a;
    --color-text:#e7ecf1; --color-text-muted:#9aa7b4; --color-border:#2c3947;
  }
  :root[data-theme="light"]{
    --bg:#f7f4ec; --acikgri:#f1f5f9;
    --color-surface:#ffffff; --color-surface-alt:#f1f5f9;
    --color-text:#22333b; --color-text-muted:#667; --color-border:#e2e8f0;
  }
  /* ---- Tema değiştirme düğmesi ---- */
  .tema-degistir-btn{
    background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.5); color:#fff;
    border-radius:999px; padding:6px 14px; font-size:.85em; font-weight:800; cursor:pointer;
    display:inline-flex; align-items:center; gap:6px; transition:background .2s ease;
  }
  .tema-degistir-btn:hover{ background:rgba(255,255,255,.3); }
</style>
<style>
  :root{
    --mavi:#2a6f97; --acik:#a9d6e5; --yesil:#40916c; --kirmizi:#d62828;
    --sari:#f4a261; --bg:#f7f4ec;
    --navy:#1E3A8A; --turkuaz:#06B6D4; --acikgri:#f1f5f9;
  }
  *{box-sizing:border-box;}
  body{
    font-family: "Nunito", "Comic Sans MS", "Segoe UI", Tahoma, sans-serif;
    background: var(--bg);
    margin:0; padding:0; color: var(--color-text);
  }
  header{
    background: linear-gradient(135deg, var(--mavi), var(--yesil));
    color:white; text-align:center; padding:24px 10px;
  }
  header h1{ margin:0; font-size:1.8em;}
  header p{ margin:6px 0 0; opacity:.9;}

  .hero{
    position:relative; overflow:hidden; text-align:center; padding:50px 20px 40px;
    background: linear-gradient(135deg, var(--navy), var(--turkuaz));
    color:white;
  }
  .hero-sekiller{ position:absolute; inset:0; pointer-events:none; }
  .hero-sekiller span{
    position:absolute; font-size:1.8em; opacity:.35; font-weight:800;
    animation: hero-yuz 5s ease-in-out infinite;
  }
  @keyframes hero-yuz{
    0%,100%{ transform:translateY(0) rotate(0deg); }
    50%{ transform:translateY(-18px) rotate(8deg); }
  }
  .hero-baslik{ font-size:2.1em; margin:10px 0 6px; text-shadow:0 2px 14px rgba(0,0,0,.5), 0 1px 4px rgba(0,0,0,.35); }
  .hero-alt{ max-width:520px; margin:0 auto; opacity:.95; font-size:1.05em; }
  .hero-butonlar{ display:flex; gap:14px; justify-content:center; margin-top:22px; flex-wrap:wrap; }
  .hero-btn{
    padding:13px 26px; border:none; border-radius:26px; font-weight:800; font-size:1em;
    cursor:pointer; transition:transform .15s;
  }
  .hero-btn:hover{ transform:scale(1.05); }
  .hero-btn-birincil{ background:white; color:var(--navy); }
  .hero-btn-ikincil{ background:rgba(255,255,255,.18); color:white; border:2px solid white; }

  .istatistik-cubugu{
    display:flex; flex-wrap:wrap; justify-content:center; gap:14px;
    background:white; padding:16px; margin:0; box-shadow:0 2px 6px rgba(0,0,0,.06);
  }
  .istatistik-kutu{
    display:flex; flex-direction:column; align-items:center; min-width:110px;
    background:var(--acikgri); border-radius:16px; padding:12px 18px;
  }
  .ist-ikon{ font-size:1.5em; }
  .istatistik-kutu b{ font-size:1.3em; color:var(--navy); }
  .ist-etiket{ font-size:.75em; color:#666; text-align:center; }

  nav{
    display:flex; flex-wrap:wrap; justify-content:center; gap:10px;
    padding:16px; background:white; box-shadow:0 2px 6px rgba(0,0,0,.08);
    position:sticky; top:0; z-index:10;
  }
  nav button{
    padding:10px 18px; border:none; border-radius:20px; cursor:pointer;
    background:var(--acik); font-weight:bold; font-size:.95em; color:#22333b;
    transition:.15s;
  }
  nav button:hover{ background:var(--mavi); color:white; }
  nav button.aktif{ background:var(--mavi); color:white; }
  nav.kategori-nav{ padding:14px 16px 6px; }
  nav.kategori-nav button{ background:#22333b; color:white; font-size:1em; }
  nav.kategori-nav button:hover{ background:var(--yesil); }
  nav.kategori-nav button.kat-aktif{ background:var(--yesil); }
  nav.kategori-nav a.slayt-link{ padding:10px 18px; border:none; border-radius:20px; cursor:pointer; font-weight:bold; font-size:1em; color:white; background:#8a5a00; text-decoration:none; display:inline-block; transition:.15s; }
  nav.kategori-nav a.slayt-link:hover{ background:var(--yesil); }
  .oyun-grubu{
    display:none; flex-wrap:wrap; justify-content:center; gap:10px;
    padding:10px 16px 16px; background:white; box-shadow:0 2px 6px rgba(0,0,0,.08);
    position:sticky; top:56px; z-index:9;
  }
  .oyun-grubu.aktif{ display:flex; }
  main{ max-width:900px; margin:0 auto; padding:20px; }
  main section{ display:none; animation: fade .3s; }
  section.aktif{ display:block; }
  @keyframes fade{ from{opacity:0;} to{opacity:1;} }
  h2{ color:var(--mavi); border-bottom:3px solid var(--acik); padding-bottom:8px;}
  .kart-kutu{ display:flex; gap:24px; flex-wrap:wrap; justify-content:center; margin-top:20px;}
  .kolon{ flex:1; min-width:240px; }
  .kolon h3, .kolon h4{ text-align:center; color:var(--yesil); margin:6px 0;}
  .kart{
    background:white; border:2px solid var(--acik); border-radius:12px;
    padding:12px 14px; margin:8px 0; cursor:pointer; text-align:center;
    font-size:1.05em; transition:.15s; box-shadow:0 1px 4px rgba(0,0,0,.08);
    position:relative; overflow:hidden;
  }
  .kart:hover{ transform:scale(1.03); }
  .kart.secili{ border-color:var(--mavi); background:#eaf4fb; }
  .kart.dogru{ background:#d8f3dc; border-color:var(--yesil); cursor:default; }
  .kart.yanlis{ background:#ffccd5; border-color:var(--kirmizi); }
  .skor{ text-align:center; font-size:1.2em; margin:16px 0; font-weight:bold; color:var(--mavi);}
  .oyun-bilgi{
    display:flex; gap:22px; justify-content:center; flex-wrap:wrap;
    font-size:1.15em; font-weight:bold; margin:16px 0; color:var(--mavi);
  }
  .kutu-panel{
    background:white; border-radius:14px; padding:18px; margin-top:16px;
    box-shadow:0 2px 8px rgba(0,0,0,.08);
  }
  button.eylem{
    display:block; margin:16px auto; padding:12px 24px; font-size:1em;
    background:var(--yesil); color:white; border:none; border-radius:24px;
    cursor:pointer; font-weight:bold;
  }
  button.eylem:hover{ background:#2d6a4f; }
  input[type=text]{
    width:100%; padding:10px; border-radius:8px; border:2px solid var(--acik);
    font-family:inherit; font-size:1em;
  }
  .aciklama{ background:#fff8e1; border-left:5px solid var(--sari); padding:10px 14px; margin:14px 0; border-radius:6px;}
  .sonuc-kutusu{ text-align:center; font-size:1.3em; font-weight:bold; margin-top:20px; color:var(--mavi); min-height:1.6em;}
  .balon-durum{ text-align:center; font-size:1.2em; font-weight:bold; margin:10px 0; min-height:28px; }
  footer{ text-align:center; padding:20px; color:#5f5f5f; font-size:.85em;}

  .hafiza-izgara{ display:grid; grid-template-columns:repeat(4,1fr); gap:10px; max-width:520px; margin:16px auto;}
  .hafiza-kart{ position:relative; height:78px; cursor:pointer; }
  .hafiza-on, .hafiza-arka{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    border-radius:10px; backface-visibility:hidden; transition:transform .4s;
    font-size:.78em; text-align:center; padding:4px; line-height:1.15; overflow:hidden;
  }
  .hafiza-on{ background:var(--mavi); color:white; font-size:1.7em; }
  .hafiza-arka{ background:white; border:2px solid var(--yesil); font-weight:bold; transform:rotateY(180deg); }
  .hafiza-kart.acik .hafiza-on{ transform:rotateY(180deg); }
  .hafiza-kart.acik .hafiza-arka{ transform:rotateY(0deg); }
  .hafiza-kart.bulundu .hafiza-arka{ background:#d8f3dc; border-color:var(--yesil); }
  .hafiza-kart.bulundu{ cursor:default; opacity:.85; }

  .kf-bant{
    display:flex; gap:8px; justify-content:center; flex-wrap:wrap; margin:16px 0; padding:14px;
    background:repeating-linear-gradient(45deg,#f4a261,#f4a261 10px,#e76f51 10px,#e76f51 20px);
    border-radius:10px;
  }
  .kf-kutu{
    width:38px; height:38px; background:white; border:2px solid #6b4226; border-radius:6px;
    display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:1.2em;
    box-shadow:0 2px 4px rgba(0,0,0,.3);
  }
  .kf-urunler{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin:14px 0; max-height:160px; overflow-y:auto; }
  .dua-cip{
    background:#eaf4fb; border:2px solid var(--mavi); border-radius:20px;
    padding:8px 14px; font-size:.9em; animation: cipAc .3s ease-out;
  }
  @keyframes cipAc{ from{ transform:scale(0);} to{ transform:scale(1);} }
  input.yanlis-girdi{ border-color:var(--kirmizi) !important; animation: sallan .3s; }
  @keyframes sallan{ 0%,100%{transform:translateX(0);} 25%{transform:translateX(-6px);} 75%{transform:translateX(6px);} }

  .kelime-banka{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin:14px 0; }
  .kelime-cevap{
    display:flex; flex-wrap:wrap; gap:8px; justify-content:center; min-height:50px;
    margin:14px 0; padding:10px; background:#eaf4fb; border-radius:10px;
  }
  .kelime-tas{
    background:white; border:2px solid var(--mavi); border-radius:8px; padding:9px 13px;
    cursor:pointer; font-weight:bold; position:relative; overflow:hidden;
  }
  .kelime-tas.kullanildi{ opacity:.35; cursor:default; }
  .kelime-tas.yanlis{ animation: sallan .3s; border-color:var(--kirmizi); }

  .ku-liste{
    list-style:none; padding:0; margin:14px auto; max-width:600px;
    display:flex; flex-wrap:wrap; gap:8px; justify-content:center;
  }
  .ku-liste li{
    background:#d8f3dc; border:2px solid var(--yesil); border-radius:20px;
    padding:6px 14px; font-weight:bold; font-size:.9em; animation: cipAc .3s ease-out;
  }

  .merdiven-secenek{
    padding:10px 14px; border:2px solid var(--acik); border-radius:10px; background:white;
    cursor:pointer; font-weight:bold; text-align:center;
  }
  .merdiven-secenek:hover{ background:#eaf4fb; }
  .merdiven-secenek.dogru{ background:#d8f3dc; border-color:var(--yesil); }
  .merdiven-secenek.yanlis{ background:#ffccd5; border-color:var(--kirmizi); }

  .bz-izgara{ display:grid; grid-template-columns:repeat(4,1fr); gap:12px; max-width:460px; margin:16px auto; }
  .bz-tus{
    height:84px; border-radius:14px; display:flex; align-items:center; justify-content:center;
    font-size:.85em; font-weight:bold; text-align:center; padding:6px; cursor:pointer;
    opacity:.5; transition:opacity .15s; color:white;
  }
  .bz-tus.bz-yanik{ opacity:1; box-shadow:0 0 18px 4px rgba(255,255,255,.85) inset; }
  .bz-tus.bz-devre-disi{ cursor:default; }

  .ka-izgara{ display:grid; gap:2px; margin:16px auto; width:fit-content; background:white; }
  .ka-hucre{
    width:26px; height:26px; display:flex; align-items:center; justify-content:center;
    background:white; border:1px solid var(--acik); border-radius:4px; font-weight:bold; cursor:pointer;
    font-size:.75em; user-select:none;
  }
  .ka-hucre.ka-secili{ background:var(--acik); }
  .ka-hucre.ka-bulundu{ background:#d8f3dc; border-color:var(--yesil); color:var(--yesil); cursor:default; }
  .ka-liste{ list-style:none; padding:0; margin:0; min-width:220px; }
  .ka-liste li{ padding:8px 10px; margin:4px 0; background:#fff8e1; border-radius:8px; font-size:.85em; }
  .ka-liste li.bulundu-satir{ background:#d8f3dc; text-decoration:line-through; color:var(--yesil); }

  .cengel-izgara{ display:grid; gap:2px; margin:16px auto; width:fit-content; }
  .cengel-hucre, .cengel-bos{ width:34px; height:34px; }
  .cengel-girdi{
    width:34px; height:34px; text-align:center; font-weight:bold; font-size:1.1em;
    border:2px solid var(--mavi); border-radius:4px; text-transform:uppercase; padding:0;
    font-family:inherit;
  }
  .cengel-girdi.dogru{ background:#d8f3dc; border-color:var(--yesil); }
  .cengel-girdi.yanlis{ background:#ffccd5; border-color:var(--kirmizi); }
  .cengel-liste{ list-style:none; padding:0; margin:16px auto 0; max-width:520px; }
  .cengel-liste li{ padding:8px 10px; margin:4px 0; background:#fff8e1; border-radius:8px; font-size:.88em; }

  .sifre-anahtar{ display:grid; grid-template-columns:repeat(10,1fr); gap:4px; max-width:560px; margin:16px auto; }
  .sifre-anahtar-hucre{ background:#eaf4fb; border:1px solid var(--acik); border-radius:6px; padding:4px 2px; text-align:center; font-size:.7em; }
  .sifre-satir{ margin:18px 0; }
  .sifre-ipucu{ text-align:center; font-weight:bold; color:var(--mavi); margin-bottom:8px; }
  .sifre-kutucuklar{ display:flex; gap:6px; justify-content:center; flex-wrap:wrap; }
  .sifre-grup{ display:flex; flex-direction:column; align-items:center; gap:2px; }
  .sifre-sayi{ font-size:.75em; font-weight:bold; color:var(--kirmizi); }
  .sifre-girdi{
    width:32px; height:32px; text-align:center; font-weight:bold; font-size:1.05em;
    border:2px solid var(--mavi); border-radius:4px; text-transform:uppercase; font-family:inherit;
  }
  .sifre-girdi.dogru{ background:#d8f3dc; border-color:var(--yesil); }
  .sifre-girdi.yanlis{ background:#ffccd5; border-color:var(--kirmizi); }
  .dua-satir{
    font-size:1.3em; text-align:center; margin:10px 0; padding:10px;
    background:#eaf4fb; border-radius:10px;
  }

  .nono-tablo{ border-collapse:collapse; margin:16px auto; }
  .nono-hucre{ width:22px; height:22px; border:1px solid #ccc; cursor:pointer; background:white; padding:0; }
  .nono-hucre.dolu{ background:var(--mavi); }
  .nono-satir-ipucu{ text-align:right; padding-right:6px; font-weight:bold; font-size:.72em; white-space:nowrap; }
  .nono-sutun-ipucu{ text-align:center; vertical-align:bottom; font-weight:bold; font-size:.68em; line-height:1.15; padding-bottom:4px; }

  .ks-izgara{
    display:grid; grid-template-columns:repeat(8,42px); grid-template-rows:repeat(8,42px);
    margin:16px auto; width:fit-content; border:3px solid #6b4226;
  }
  .ks-hucre{
    display:flex; align-items:center; justify-content:center; font-weight:bold;
    font-size:1.05em; cursor:pointer;
  }
  .ks-hucre.acik{ background:#f0d9b5; }
  .ks-hucre.koyu{ background:#b58863; }
  .ks-hucre.ks-secili{ background:var(--acik) !important; }
  .ks-hucre.ks-bulundu{ background:var(--yesil) !important; color:white; cursor:default; }

  .dd-satir{ display:flex; gap:6px; justify-content:center; margin-bottom:8px; }
  .dd-kutu{
    width:38px; height:38px; display:flex; align-items:center; justify-content:center;
    font-weight:bold; font-size:1.1em; color:white; border-radius:6px;
  }
  .dd-kutu.dogru-yer{ background:var(--yesil); }
  .dd-kutu.yanlis-yer{ background:var(--sari); }
  .dd-kutu.yok{ background:#999; }

  .labirent-izgara{ display:grid; margin:16px auto; width:fit-content; background:white; box-shadow:0 2px 8px rgba(0,0,0,.15); }
  .labirent-hucre{
    width:30px; height:30px; box-sizing:border-box; display:flex; align-items:center;
    justify-content:center; font-size:.95em;
  }
  .labirent-kontroller{ display:flex; flex-direction:column; align-items:center; gap:6px; margin:14px 0; }
  .labirent-kontroller > div{ display:flex; gap:6px; }
  .labirent-tus{
    width:48px; height:48px; font-size:1.3em; border:none; border-radius:10px;
    background:var(--mavi); color:white; cursor:pointer; font-weight:bold;
  }
  .labirent-tus:hover{ background:#1c4e6b; }

/* ===================== SUNUM (SLAYT) GORUNUMU ===================== */
.sunum-sarmal{ max-width:900px; margin:0 auto; }
.sunum-ust{ display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
.sunum-sayac{ font-weight:bold; color:var(--mavi); background:var(--acikgri); padding:6px 14px; border-radius:16px; font-size:.9em; }
.sunum-tamekran-btn{ background:var(--navy); color:#fff; border:none; padding:8px 16px; border-radius:16px; cursor:pointer; font-weight:bold; font-size:.9em; }
.sunum-tamekran-btn:hover{ background:var(--mavi); }
.sunum-alan{
  position:relative; width:100%; aspect-ratio:16/9; background:#0d1f2d;
  border-radius:14px; overflow:hidden; box-shadow:0 6px 24px rgba(0,0,0,.25);
}
.sunum-alan:fullscreen{ border-radius:0; aspect-ratio:auto; display:flex; align-items:center; justify-content:center; }
.sunum-alan:fullscreen .sunum-slayt{ max-width:1400px; max-height:90vh; margin:auto; }
.sunum-slayt{
  position:absolute; inset:0; display:none; flex-direction:column; align-items:center; justify-content:center;
  padding:6% 8%; text-align:center; color:#fff; font-family:"Nunito","Segoe UI",sans-serif;
  animation:sunumFade .35s ease;
}
.sunum-slayt.aktif{ display:flex; }
@keyframes sunumFade{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);} }

.s-baslik, .s-kapanis{ background:linear-gradient(160deg,#1E3A8A,#0d1f2d); }
.sb-daire{
  width:90px; height:90px; border-radius:50%; background:var(--sari); color:#1E3A8A;
  display:flex; align-items:center; justify-content:center; font-size:2.6em; margin-bottom:16px;
  box-shadow:0 0 0 4px #fff3;
}
.sb-ust{ letter-spacing:2px; color:var(--sari); font-weight:bold; font-size:.95em; margin:0 0 8px; }
.sb-baslik{ font-size:1.7em; margin:0 0 14px; }
.sb-ders{ color:#cbd5e1; margin:2px 0; }
.sb-ogretmen{ color:#b8c4d9; font-style:italic; font-size:.9em; margin:2px 0; }

.s-liste{ background:var(--acik); color:#22333b; }
.s-liste h3{ color:var(--mavi); font-size:1.3em; margin-top:0; }
.sl-liste{ text-align:left; list-style:none; padding:0; margin:0; width:100%; max-width:640px; }
.sl-liste li{
  background:#fff; border-left:6px solid var(--mavi); border-radius:8px; padding:10px 16px;
  margin-bottom:10px; font-size:.95em; box-shadow:0 2px 6px rgba(0,0,0,.08);
}
.s-ozet .sl-liste li{ border-left-color:var(--yesil); }

.s-icerik{ background:#fff; color:#22333b; }
.s-icerik h3{ color:var(--vurgu, var(--mavi)); font-size:1.25em; margin-top:0; }
.si-liste{ text-align:left; list-style:none; padding:0; margin:0; width:100%; max-width:640px; }
.si-liste li{
  background:var(--acikgri); border-left:6px solid var(--vurgu, var(--mavi)); border-radius:8px;
  padding:10px 16px; margin-bottom:10px; font-size:.92em; line-height:1.4;
}

.s-kavram{ background:var(--acikgri); color:#22333b; }
.s-kavram h3{ color:var(--mavi); margin-top:0; }
.sk-izgara{ display:flex; flex-wrap:wrap; gap:10px; justify-content:center; max-width:700px; }
.sk-etiket{ color:#fff; font-weight:bold; padding:10px 18px; border-radius:20px; font-size:.9em; box-shadow:0 2px 6px rgba(0,0,0,.15); }

.s-ayet{ background:linear-gradient(160deg,#1E3A8A,#0d1f2d); }
.sa-ust{ color:var(--sari); font-weight:bold; letter-spacing:2px; font-size:.9em; }
.sa-meal{ font-size:1.25em; font-style:italic; max-width:640px; line-height:1.5; margin:14px 0; font-family:Georgia,serif; }
.sa-kaynak{ color:var(--sari); font-weight:bold; }

.s-video{ background:linear-gradient(160deg,#1E3A8A,#0d1f2d); }
.sv-ust{ color:#8FD9B8; font-weight:bold; letter-spacing:2px; font-size:.9em; margin-bottom:10px; }
.sv-cerceve{ width:100%; max-width:640px; aspect-ratio:16/9; border-radius:10px; overflow:hidden; border:2px solid var(--sari); box-shadow:0 4px 18px rgba(0,0,0,.4); display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,.06); }
.sv-cerceve iframe{ width:100%; height:100%; border:none; }
.sv-yer-tutucu{ color:#cbd5e1; font-size:.9em; padding:20px; text-align:center; }
.sv-baslik{ margin-top:10px; font-size:.95em; color:#e5e7eb; }

.sunum-nav{ display:flex; justify-content:space-between; align-items:center; margin-top:10px; gap:10px; }
.sunum-nav button{
  background:var(--mavi); color:#fff; border:none; padding:10px 20px; border-radius:20px;
  cursor:pointer; font-weight:bold; font-size:.95em;
}
.sunum-nav button:hover{ background:var(--yesil); }
.sunum-nav button:disabled{ opacity:.4; cursor:default; }
.sunum-noktalar{ display:flex; gap:6px; flex-wrap:wrap; justify-content:center; max-width:400px; }
.sunum-nokta{ width:9px; height:9px; border-radius:50%; background:#cbd5e1; cursor:pointer; }
.sunum-nokta.aktif{ background:var(--mavi); }
@media(max-width:640px){
  .sb-baslik{ font-size:1.25em; } .sa-meal{ font-size:1em; } .sl-liste li,.si-liste li{ font-size:.85em; }
}


/* ===================== ZENGINLESTIRME KUTULARI ===================== */
.zg-kutu{ border-radius:12px; padding:16px 18px; margin:16px 0; box-shadow:0 3px 10px rgba(0,0,0,.08); }
.zg-baslik{ font-weight:bold; font-size:1.05em; margin:0 0 8px; display:flex; align-items:center; gap:8px; }
.zg-metin{ margin:0; line-height:1.55; font-size:.97em; }
.zg-bilgi{ background:#eaf2ff; border-left:6px solid #2a6f97; }
.zg-bilgi .zg-baslik{ color:#2a6f97; }
.zg-merak{ background:#f3ecfb; border-left:6px solid #7c3aed; }
.zg-merak .zg-baslik{ color:#7c3aed; }
.zg-soru{ background:#fff4e6; border-left:6px solid #f4a261; }
.zg-soru .zg-baslik{ color:#c9740b; }
.zg-hayat{ background:#eafaf1; border-left:6px solid #40916c; }
.zg-hayat .zg-baslik{ color:#40916c; }


.s-zg{ color:#22333b; }
.s-zg-bilgi{ background:#eaf2ff; }
.s-zg-merak{ background:#f3ecfb; }
.s-zg-soru{ background:#fff4e6; }
.s-zg-hayat{ background:#eafaf1; }
.zg-slayt-ust{ font-weight:bold; letter-spacing:1.5px; font-size:.95em; margin-bottom:14px; }
